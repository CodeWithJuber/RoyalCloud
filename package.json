  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/node": "24.10.1",
    "playwright-core": "1.61.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
