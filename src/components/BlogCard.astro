---
import { type Post, formatDate, tagSlug } from "../lib/blog";
import { Image } from "astro:assets";
interface Props { post: Post; featured?: boolean; }
const { post, featured = false } = Astro.props;
const { data, id } = post;
const href = `/blog/${id}`;
---
<article class={`bcard${featured ? " is-featured" : ""}`}>
  <a href={href} class="bcard__media" aria-hidden="true" tabindex="-1">
    {data.image ? (
      <Image src={data.image} alt={data.imageAlt ?? data.title} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
    ) : (
      <span class="bcard__ph">{data.category}</span>
    )}
  </a>
  <div class="bcard__body">
    <div class="bcard__meta">
      <a href={`/blog/tag/${tagSlug(data.category)}`} class="bcard__cat">{data.category}</a>
      <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
    </div>
    <h3 class="bcard__title"><a href={href}>{data.title}</a></h3>
    <p class="bcard__desc">{data.description}</p>
    <a href={href} class="bcard__more">Read article →</a>
  </div>
</article>

<style>
  .bcard { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-xs); transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
  .bcard:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--border-strong); }
  .bcard__media { display: block; aspect-ratio: 16/9; background: var(--brand-soft); overflow: hidden; }
  .bcard__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .bcard__ph { display: grid; place-items: center; height: 100%; color: var(--brand-ink); font-family: var(--font-display); font-weight: 800; letter-spacing: .04em; }
  .bcard__body { padding: 1.4rem 1.5rem 1.6rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .bcard__meta { display: flex; align-items: center; gap: 0.75rem; font-size: 0.82rem; color: var(--muted); }
  .bcard__cat { font-family: var(--font-display); font-weight: 650; color: var(--brand-ink); }
  .bcard__title { font-size: 1.25rem; line-height: 1.3; }
  .bcard__title a { color: var(--ink); }
  .bcard__title a:hover { color: var(--brand-ink); }
  .bcard__desc { color: var(--muted); font-size: 0.95rem; flex: 1; }
  .bcard__more { font-family: var(--font-display); font-weight: 650; color: var(--brand-ink); font-size: 0.9rem; }

  .bcard.is-featured { grid-column: 1 / -1; }
  @media (min-width: 760px) {
    .bcard.is-featured { flex-direction: row; }
    .bcard.is-featured .bcard__media { flex: 0 0 48%; aspect-ratio: auto; }
    .bcard.is-featured .bcard__body { justify-content: center; padding: 2rem 2.25rem; }
    .bcard.is-featured .bcard__title { font-size: 1.7rem; }
  }
</style>
