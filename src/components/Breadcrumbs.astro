---
interface Crumb { label: string; href?: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li aria-current={i === items.length - 1 ? "page" : undefined}>
        {c.href && i !== items.length - 1 ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-size: 0.86rem; }
  .crumbs li { display: flex; align-items: center; gap: 0.5rem; color: var(--muted); }
  .crumbs li:not(:first-child)::before { content: "/"; color: var(--border-strong); }
  .crumbs a { color: var(--muted); font-weight: 550; }
  .crumbs a:hover { color: var(--brand-ink); }
  .crumbs [aria-current="page"] span { color: var(--ink); font-weight: 650; }
</style>
