---
import site from "../data/site.json";
interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = "Ready to launch with Royal Clouds?",
  text = "Join thousands of websites running faster on premium SSD hosting. Free SSL, free migration and a 30-day money-back guarantee.",
  primaryLabel = "Get Started",
  primaryHref = site.portal.cart,
  secondaryLabel = "Talk to Sales",
  secondaryHref = `mailto:${site.contact.salesEmail}`,
} = Astro.props;
---
<section class="cta-band">
  <div class="container">
    <div class="cta-band__inner reveal">
      <h2>{title}</h2>
      <p>{text}</p>
      <div class="cta-band__actions">
        <a href={primaryHref} class="btn btn--white">{primaryLabel}</a>
        <a href={secondaryHref} class="btn btn--ghost-light">{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: var(--rc-section-y); }
  .cta-band__inner {
    background: var(--rc-gradient); color: #fff; border-radius: var(--rc-radius-lg);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 4rem); text-align: center;
    box-shadow: var(--rc-shadow-lg); position: relative; overflow: hidden;
  }
  .cta-band__inner::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 15% 100%, rgba(255,255,255,0.16), transparent 45%); pointer-events: none; }
  .cta-band__inner h2 { color: #fff; position: relative; }
  .cta-band__inner p { color: rgba(255,255,255,0.9); max-width: 620px; margin: 1rem auto 0; position: relative; font-size: 1.1rem; }
  .cta-band__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; justify-content: center; margin-top: 2rem; position: relative; }
</style>
