---
import Icon from "./Icon.astro";
import site from "../data/site.json";
interface Props {
  title?: string; text?: string;
  primaryLabel?: string; primaryHref?: string;
  secondaryLabel?: string; secondaryHref?: string;
}
const {
  title = "Ready to launch faster?",
  text = "Join thousands of sites running on premium SSD hosting — free SSL, free migration and a 30-day money-back guarantee.",
  primaryLabel = "Get Started",
  primaryHref = site.portal.cart,
  secondaryLabel = "Talk to sales",
  secondaryHref = `mailto:${site.contact.salesEmail}`,
} = Astro.props;
---
<section class="cta">
  <div class="container">
    <div class="cta__inner reveal">
      <div class="cta__mesh bg-mesh" aria-hidden="true"></div>
      <h2>{title}</h2>
      <p>{text}</p>
      <div class="cta__actions">
        <a href={primaryHref} class="btn btn--gradient btn--lg">{primaryLabel} <Icon name="arrow" size={18} /></a>
        <a href={secondaryHref} class="btn btn--outline btn--lg">{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--section-y); }
  .cta__inner { position: relative; overflow: hidden; text-align: center; border-radius: var(--r-xl); padding: clamp(2.75rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 4rem); background: var(--bg-inset); border: 1px solid var(--border-strong); box-shadow: var(--shadow-md); }
  .cta__mesh { position: absolute; inset: 0; opacity: 1; }
  .cta__inner h2, .cta__inner p, .cta__actions { position: relative; }
  .cta__inner p { color: var(--muted); max-width: 600px; margin: 1rem auto 0; font-size: 1.12rem; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; justify-content: center; margin-top: 2rem; }
</style>
