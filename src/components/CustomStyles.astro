---
import "@fontsource-variable/open-sans";
import "@fontsource-variable/dosis";
---

<style is:inline>
  :root {
    --aw-font-sans: "Open Sans Variable";
    --aw-font-serif: "Open Sans Variable";
    --aw-font-heading: "Dosis Variable";

    /* Royal Clouds — live-site brand */
    --aw-color-primary: #269fd9;
    --aw-color-secondary: #7b1fa2;
    --aw-color-accent: #fdd700;

    --aw-color-text-heading: #269fd9;
    --aw-color-text-default: #4d4d4d;
    --aw-color-text-muted: #5f6673;
    --aw-color-bg-page: #ffffff;
    --aw-color-bg-page-dark: #22105f;

    ::selection {
      background-color: rgba(38, 159, 217, 0.22);
    }
  }
</style>
