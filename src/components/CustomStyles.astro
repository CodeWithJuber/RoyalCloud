---
import "@fontsource-variable/outfit";
import "@fontsource-variable/geist-mono";
---

<style is:inline>
  :root {
    --aw-font-sans: "Manrope";
    --aw-font-serif: "Manrope";
    --aw-font-heading: "Bricolage Grotesque";

    /* Royal Clouds — Royal Systems Design Language v2 */
    --aw-color-primary: #2f36d4;
    --aw-color-secondary: #9099b2;
    --aw-color-accent: #ff6b3d;
    --rc-purple: #2f36d4;
    --rc-purple-dark: #1e2494;
    --rc-blue: #9099b2;
    --rc-yellow: #ff6b3d;
    --rc-orange: #ff6b3d;
    --rc-orange-dark: #ff8a66;
    --rc-indigo: #050712;
    --rc-gradient: linear-gradient(110deg, #2f36d4 0%, #1e2494 100%);

    --aw-color-text-heading: #0a0e24;
    --aw-color-text-default: #20263b;
    --aw-color-text-muted: #566076;
    --aw-color-bg-page: #f4f6fb;
    --aw-color-bg-page-dark: #050712;

    ::selection {
      background-color: rgba(47, 54, 212, 0.22);
    }
  }
</style>
