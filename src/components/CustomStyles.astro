---
import "@fontsource-variable/inter";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist-mono";
---

<style is:inline>
  :root {
    --aw-font-sans: "Inter Variable";
    --aw-font-serif: "Inter Variable";
    --aw-font-heading: "Bricolage Grotesque Variable";

    /* Royal Clouds — STRATOSPHERE brand (quiet-premium) */
    --aw-color-primary: #4b16d6; /* royal violet */
    --aw-color-secondary: #1e96e8; /* azure */
    --aw-color-accent: #f5a524; /* gold */
    --rc-purple: #4b16d6;
    --rc-purple-dark: #3a0ca3;
    --rc-blue: #1e96e8;
    --rc-yellow: #f5a524;
    --rc-orange: #e0890c;
    --rc-orange-dark: #b9700a;
    --rc-indigo: #0a0e1f; /* space-ink (hero/footer/headings) */
    --rc-gradient: linear-gradient(110deg, #4b16d6 0%, #1e96e8 100%);

    --aw-color-text-heading: #0a0e1f;
    --aw-color-text-default: #3c3e54;
    --aw-color-text-muted: #64667e;
    --aw-color-bg-page: #fbfbfd;
    --aw-color-bg-page-dark: #0a0e1f;

    ::selection {
      background-color: rgba(75, 22, 214, 0.16);
    }
  }
</style>
