---
import "@fontsource-variable/outfit";
import "@fontsource-variable/geist-mono";
---

<style is:inline>
  :root {
    --aw-font-sans: "Outfit Variable";
    --aw-font-serif: "Outfit Variable";
    --aw-font-heading: "Outfit Variable";

    /* Royal Clouds, STRATOSPHERE brand (quiet-premium) */
    --aw-color-primary: #111722;
    --aw-color-secondary: #667080;
    --aw-color-accent: #eebe58;
    --rc-purple: #111722;
    --rc-purple-dark: #080b12;
    --rc-blue: #58677b;
    --rc-yellow: #eebe58;
    --rc-orange: #d8a844;
    --rc-orange-dark: #a67418;
    --rc-indigo: #0b0f18;
    --rc-gradient: linear-gradient(110deg, #111722 0%, #343d4c 100%);

    --aw-color-text-heading: #0b0f18;
    --aw-color-text-default: #454a50;
    --aw-color-text-muted: #686d72;
    --aw-color-bg-page: #f6f4ef;
    --aw-color-bg-page-dark: #0b0f18;

    ::selection {
      background-color: rgba(238, 190, 88, 0.3);
    }
  }
</style>
