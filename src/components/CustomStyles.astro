---
import "@fontsource-variable/dm-sans";
---

<style is:inline>
  :root {
    --aw-font-sans: "DM Sans Variable";
    --aw-font-serif: "Open Sans Variable";
    --aw-font-heading: "DM Sans Variable";

    /* Royal Clouds — violet system v3 brand (unrouted AstroWind boilerplate; kept in sync so nothing here silently falls back to the retired cobalt/gold palette) */
    --aw-color-primary: #673de6;
    --aw-color-secondary: #5025d1;
    --aw-color-accent: #ffc94b;

    --aw-color-text-heading: #673de6;
    --aw-color-text-default: #4d4d4d;
    --aw-color-text-muted: #5f6673;
    --aw-color-bg-page: #ffffff;
    --aw-color-bg-page-dark: #22105f;

    ::selection {
      background-color: rgba(38, 159, 217, 0.22);
    }
  }
</style>
