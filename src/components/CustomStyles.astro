---
import "@fontsource-variable/inter";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/geist-mono";
---

<style is:inline>
  :root {
    --aw-font-sans: "Inter Variable";
    --aw-font-serif: "Inter Variable";
    --aw-font-heading: "Bricolage Grotesque Variable";

    /* Royal Clouds — STRATOSPHERE brand */
    --aw-color-primary: #5111e0; /* electric royal violet */
    --aw-color-secondary: #19b6ff; /* sky azure */
    --aw-color-accent: #ffb627; /* royal gold */
    --rc-purple: #5111e0;
    --rc-purple-dark: #3a0ca3;
    --rc-blue: #19b6ff;
    --rc-yellow: #ffb627;
    --rc-orange: #f59e0b;
    --rc-orange-dark: #c2710a;
    --rc-indigo: #0a0e1f; /* space-ink (hero/footer/headings) */
    --rc-gradient: linear-gradient(110deg, #5111e0 0%, #19b6ff 100%);

    --aw-color-text-heading: #0a0e1f;
    --aw-color-text-default: #3c3e54;
    --aw-color-text-muted: #64667e;
    --aw-color-bg-page: #fbfbfd;
    --aw-color-bg-page-dark: #0a0e1f;

    ::selection {
      background-color: rgba(81, 17, 224, 0.18);
    }
  }
</style>
