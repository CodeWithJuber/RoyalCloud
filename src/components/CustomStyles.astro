---
import "@fontsource-variable/inter";
import "@fontsource-variable/sora";
---

<style is:inline>
  :root {
    --aw-font-sans: "Inter Variable";
    --aw-font-serif: "Inter Variable";
    --aw-font-heading: "Sora Variable";

    /* Royal Clouds — REAL brand (sampled from royalclouds.net) */
    --aw-color-primary: #7652f2; /* royal purple */
    --aw-color-secondary: #00a7f5; /* sky blue */
    --aw-color-accent: #ff7a18; /* orange CTA */
    --rc-purple: #7652f2;
    --rc-purple-dark: #5b34d6;
    --rc-blue: #00a7f5;
    --rc-yellow: #fdd700;
    --rc-orange: #ff7a18;
    --rc-orange-dark: #f06a00;
    --rc-indigo: #22105f; /* dark indigo (hero/footer/headings) */
    --rc-gradient: linear-gradient(
      120deg,
      #5b34d6 0%,
      #7652f2 45%,
      #00a7f5 100%
    );

    --aw-color-text-heading: #22105f;
    --aw-color-text-default: #4a4a68;
    --aw-color-text-muted: #74719a;
    --aw-color-bg-page: #ffffff;
    --aw-color-bg-page-dark: #22105f;

    ::selection {
      background-color: rgba(118, 82, 242, 0.2);
    }
  }
</style>
