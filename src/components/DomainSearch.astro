---
import Icon from "./Icon.astro";
import site from "../data/site.json";
const tlds = [".com", ".net", ".org", ".io", ".in", ".store"];
---
<div class="dsearch" id="domain-search">
  <div class="dsearch__grid bg-grid" aria-hidden="true"></div>
  <div class="dsearch__inner">
    <span class="eyebrow eyebrow--light"><Icon name="globe" size={14} /> Domains</span>
    <h2>Find the perfect domain</h2>
    <p>Search your name and register it in seconds — with free DNS management.</p>
    <form class="dform" id="domainForm" action={site.portal.domainChecker} method="get">
      <span class="dform__icon"><Icon name="search" size={20} /></span>
      <input type="text" id="domainInput" name="query" placeholder="yourbrand.com" autocomplete="off" aria-label="Domain name" />
      <button type="submit" class="btn btn--gradient">Search</button>
    </form>
    <ul class="dtlds">{tlds.map((t) => (<li>{t}</li>))}</ul>
  </div>
</div>

<style>
  .dsearch { position: relative; overflow: hidden; border-radius: var(--r-xl); padding: clamp(2.25rem, 5vw, 3.5rem); border: 1px solid var(--border-strong); background: var(--bg-inset); box-shadow: var(--shadow-md); }
  .dsearch__grid { position: absolute; inset: 0; opacity: .6; }
  .dsearch__inner { position: relative; max-width: 720px; margin-inline: auto; text-align: center; }
  .eyebrow--light { margin-inline: auto; }
  .dsearch h2 { margin-top: 0.4rem; }
  .dsearch p { color: var(--muted); margin-top: 0.6rem; font-size: 1.08rem; }
  .dform { display: flex; align-items: center; gap: 0.5rem; background: var(--surface); border: 1px solid var(--border-strong); border-radius: var(--r-pill); padding: 0.45rem 0.45rem 0.45rem 1rem; margin-top: 1.75rem; box-shadow: var(--shadow-sm); }
  .dform__icon { color: var(--muted); display: inline-flex; }
  .dform input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 1.05rem; color: var(--ink); padding: 0.6rem 0.4rem; }
  .dtlds { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.25rem; margin-top: 1.25rem; font-family: var(--font-display); font-weight: 650; color: var(--muted); }
  @media (max-width: 520px) { .dform { flex-wrap: wrap; border-radius: var(--r-md); } .dform .btn { width: 100%; } }
</style>

<script>
  const form = document.getElementById("domainForm") as HTMLFormElement | null;
  const input = document.getElementById("domainInput") as HTMLInputElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const value = (input?.value || "").trim();
    const base = form.getAttribute("action") || "";
    window.open(value ? `${base}&query=${encodeURIComponent(value)}` : base, "_blank", "noopener");
  });
</script>
