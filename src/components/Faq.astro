---
interface Item { q: string; a: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item, i) => (
    <details class="faq__item" open={i === 0}>
      <summary>
        <span>{item.q}</span>
        <svg class="faq__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      </summary>
      <div class="faq__a"><p>{item.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { max-width: 800px; margin-inline: auto; display: grid; gap: 0.75rem; }
  .faq__item { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden; transition: border-color .2s ease, box-shadow .2s ease; }
  .faq__item[open] { border-color: color-mix(in srgb, var(--brand) 30%, transparent); box-shadow: var(--shadow-xs); }
  .faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.15rem 1.4rem; cursor: pointer; list-style: none; font-family: var(--font-display); font-weight: 650; color: var(--ink); font-size: 1.04rem; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__icon { flex: none; color: var(--brand-ink); transition: transform .25s ease; }
  .faq__item[open] .faq__icon { transform: rotate(45deg); }
  .faq__a { padding: 0 1.4rem 1.25rem; }
  .faq__a p { color: var(--muted); }
</style>
