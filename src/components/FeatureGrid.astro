---
import Icon from "./Icon.astro";
interface Item { icon: string; title: string; text: string; }
interface Props { items: Item[]; columns?: 2 | 3 | 4; }
const { items, columns = 3 } = Astro.props;
---
<div class={`fgrid cols-${columns}`}>
  {items.map((item, i) => (
    <div class={`fitem reveal ${i % 3 === 1 ? "d1" : i % 3 === 2 ? "d2" : ""}`}>
      <span class="icon-tile"><Icon name={item.icon} /></span>
      <h3>{item.title}</h3>
      <p>{item.text}</p>
    </div>
  ))}
</div>

<style>
  .fgrid { display: grid; gap: clamp(1rem, 2.5vw, 1.5rem); }
  .fgrid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .fgrid.cols-3 { grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); }
  .fgrid.cols-4 { grid-template-columns: repeat(auto-fit, minmax(225px, 1fr)); }
  .fitem { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: clamp(1.4rem, 3vw, 1.85rem); box-shadow: var(--shadow-xs); transition: transform .22s cubic-bezier(.2,.7,.3,1), box-shadow .22s ease, border-color .22s ease; }
  [data-theme="dark"] .fitem { backdrop-filter: blur(8px); }
  .fitem:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--border-strong); }
  .fitem h3 { font-size: 1.18rem; margin: 1rem 0 0.5rem; }
  .fitem p { color: var(--muted); font-size: 0.96rem; }
</style>
