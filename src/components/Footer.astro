---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import footer from "../data/footer.json";
import site from "../data/site.json";
const year = new Date().getFullYear();

const socials = [
  { name: "facebook", href: site.social.facebook, label: "Facebook" },
  { name: "twitter", href: site.social.twitter, label: "Twitter / X" },
  { name: "instagram", href: site.social.instagram, label: "Instagram" },
  { name: "linkedin", href: site.social.linkedin, label: "LinkedIn" },
].filter((s) => s.href);
---
<footer class="ft">
  <div class="container container-wide">
    <div class="ft__top">
      <div class="ft__brand">
        <a href="/" aria-label={`${site.name} home`}><Logo /></a>
        <p>{site.shortDescription}</p>
        <form class="ft__news" id="newsletterForm">
          <label for="newsletterEmail" class="sr-only">Email address</label>
          <input id="newsletterEmail" type="email" name="email" placeholder="Email for offers & updates" required />
          <button type="submit" class="btn btn--gradient btn--sm" aria-label="Subscribe"><Icon name="arrow" size={18} /></button>
        </form>
        <p class="ft__news-ok" id="newsletterNote" hidden>Thanks — you're on the list.</p>
        {socials.length > 0 && (
          <div class="ft__social">
            {socials.map((s) => (
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer"><Icon name="globe" size={18} /></a>
            ))}
          </div>
        )}
      </div>

      <div class="ft__cols">
        {footer.columns.map((col) => (
          <div class="ft__col">
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li><a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="ft__bottom">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <ul class="ft__legal">
        {footer.legal.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .ft { background: var(--bg-subtle); border-top: 1px solid var(--border); padding-block: clamp(3rem, 6vw, 4.5rem) 2rem; }
  .ft__top { display: grid; grid-template-columns: 1.2fr 2fr; gap: clamp(2rem, 5vw, 4rem); }
  .ft__brand > p { color: var(--muted); margin-top: 1rem; max-width: 320px; }
  .ft__news { display: flex; gap: 0.5rem; margin-top: 1.5rem; max-width: 340px; }
  .ft__news input { flex: 1; min-width: 0; padding: 0.7rem 1rem; border-radius: var(--r-pill); border: 1px solid var(--border-strong); background: var(--surface); color: var(--ink); font: inherit; font-size: 0.9rem; }
  .ft__news .btn { flex: none; width: 44px; padding: 0; }
  .ft__news-ok { color: var(--success); margin-top: 0.6rem; font-size: 0.88rem; }
  .ft__social { display: flex; gap: 0.55rem; margin-top: 1.5rem; }
  .ft__social a { display: inline-flex; width: 38px; height: 38px; align-items: center; justify-content: center; border-radius: 10px; background: var(--surface); border: 1px solid var(--border); color: var(--ink); transition: border-color .15s ease, color .15s ease; }
  .ft__social a:hover { border-color: var(--brand); color: var(--brand-ink); }

  .ft__cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .ft__col h4 { font-family: var(--font-display); color: var(--ink); font-size: 0.95rem; margin-bottom: 1rem; }
  .ft__col a { color: var(--muted); font-size: 0.92rem; display: inline-block; padding: 0.32rem 0; transition: color .15s ease; }
  .ft__col a:hover { color: var(--brand-ink); }

  .ft__bottom { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: 1.5rem; border-top: 1px solid var(--border); font-size: 0.88rem; color: var(--muted); }
  .ft__legal { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .ft__legal a { color: var(--muted); }
  .ft__legal a:hover { color: var(--brand-ink); }

  @media (max-width: 820px) {
    .ft__top { grid-template-columns: 1fr; }
    .ft__cols { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  const form = document.getElementById("newsletterForm") as HTMLFormElement | null;
  const note = document.getElementById("newsletterNote");
  form?.addEventListener("submit", (e) => { e.preventDefault(); if (note) note.hidden = false; form.reset(); });
</script>
