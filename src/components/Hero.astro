---
import Icon from "./Icon.astro";
import DashboardMockup from "./DashboardMockup.astro";
import site from "../data/site.json";
---
<section class="hero">
  <div class="hero__grid bg-grid" aria-hidden="true"></div>
  <div class="hero__mesh bg-mesh" aria-hidden="true"></div>
  <div class="container container-wide hero__inner">
    <div class="hero__copy">
      <a href="/blog/why-ssd-litespeed-hosting-is-faster" class="hero__pill">
        <span class="hero__pill-tag">New</span>
        Up to 15× faster with SSD + LiteSpeed
        <Icon name="arrow" size={15} />
      </a>
      <h1>Premium hosting, <span class="text-gradient">built for enhanced speed</span></h1>
      <p class="hero__lead">Launch on SSD RAID-10 servers with LiteSpeed, CloudLinux, free cPanel & SSL, daily backups and genuinely friendly 24/7 support — from just {site.startingPrice}/month.</p>
      <div class="hero__cta">
        <a href="/shared-hosting" class="btn btn--gradient btn--lg">Start from {site.startingPrice}/mo</a>
        <a href="#plans" class="btn btn--outline btn--lg"><Icon name="layers" size={18} /> Compare plans</a>
      </div>
      <ul class="hero__trust">
        {site.trustBadges.map((b) => (<li><Icon name="check" size={15} /> {b}</li>))}
      </ul>
    </div>
    <div class="hero__visual reveal">
      <DashboardMockup />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(3rem, 7vw, 6rem); }
  .hero__grid { position: absolute; inset: 0; opacity: .5; pointer-events: none; }
  .hero__mesh { position: absolute; inset: -10% -10% auto; height: 120%; pointer-events: none; }
  .hero__inner { position: relative; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }

  .hero__pill { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.85rem; font-weight: 550; color: var(--text); background: var(--surface); border: 1px solid var(--border-strong); padding: 0.4rem 0.5rem 0.4rem 0.45rem; border-radius: var(--r-pill); box-shadow: var(--shadow-xs); transition: border-color .2s ease, transform .2s ease; }
  .hero__pill:hover { border-color: var(--brand); transform: translateY(-1px); color: var(--ink); }
  .hero__pill-tag { font-family: var(--font-display); font-weight: 700; font-size: 0.7rem; letter-spacing: .04em; text-transform: uppercase; color: #fff; background: var(--brand); padding: 0.2rem 0.55rem; border-radius: var(--r-pill); }
  .hero__pill :global(svg:last-child) { opacity: .5; }

  .hero h1 { margin-top: 1.3rem; }
  .hero__lead { font-size: 1.22rem; line-height: 1.6; color: var(--text); margin-top: 1.3rem; max-width: 540px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .hero__trust { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; margin-top: 2rem; }
  .hero__trust li { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-display); font-weight: 550; font-size: 0.88rem; color: var(--text); }
  .hero__trust :global(svg) { color: var(--success); }
  .hero__visual { display: flex; justify-content: center; }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { margin-top: 1rem; }
    .hero__lead { max-width: none; }
  }
</style>
