---
import { Icon as Iconify } from "astro-icon/components";

/**
 * Project icon wrapper. Maps our semantic names to the Lucide icon set
 * (professional, consistent stroke icons) so existing call sites like
 * <Icon name="bolt" /> keep working. For real brand/tech logos use
 * <BrandLogo />.
 */
interface Props { name: string; size?: number; class?: string; }
const { name, size = 24, class: className = "" } = Astro.props;

const map: Record<string, string> = {
  server: "server", cpu: "cpu", database: "database", cloud: "cloud",
  wordpress: "layout-template", users: "users", bolt: "zap",
  shield: "shield-check", apps: "layout-grid", headset: "headset",
  terminal: "square-terminal", settings: "settings", refresh: "refresh-cw",
  backup: "database-backup", scale: "scaling", billing: "receipt",
  rocket: "rocket", failover: "git-fork", uptime: "activity", gauge: "gauge",
  report: "file-text", audit: "search-check", logs: "scroll-text",
  firewall: "brick-wall", check: "check", x: "x", star: "star", mail: "mail",
  chat: "message-circle", ticket: "ticket", search: "search",
  arrow: "arrow-right", globe: "globe", clock: "clock", lock: "lock",
  sun: "sun", moon: "moon", menu: "menu", layers: "layers", code: "code",
  sparkle: "sparkles", cart: "shopping-cart",
};
const lucide = map[name] ?? name;
---
<Iconify name={`lucide:${lucide}`} width={size} height={size} class={className} aria-hidden="true" />
