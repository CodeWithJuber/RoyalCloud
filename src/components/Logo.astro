---
/**
 * Royal Clouds wordmark — crown + cloud glyph.
 * `variant="white"` renders the wordmark in white for dark backgrounds.
 * The glyph always uses the brand gradient unless `mono` is set.
 */
interface Props {
  variant?: "color" | "white";
  mono?: boolean;
  class?: string;
}
const { variant = "color", mono = false, class: className = "" } = Astro.props;
const textColor = variant === "white" ? "#ffffff" : "var(--rc-ink)";
const accentColor = variant === "white" ? "#b9a6ff" : "var(--rc-primary)";
const gid = "rcLogoGrad";
---
<span class={`rc-logo ${className}`} aria-label="Royal Clouds">
  <svg width="40" height="40" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    {!mono && (
      <defs>
        <linearGradient id={gid} x1="6" y1="8" x2="42" y2="40" gradientUnits="userSpaceOnUse">
          <stop stop-color="#6938ef" />
          <stop offset="0.5" stop-color="#8b5cf6" />
          <stop offset="1" stop-color="#2f7bff" />
        </linearGradient>
      </defs>
    )}
    {/* crown */}
    <path
      d="M12 16l4 5 8-9 8 9 4-5v8H12z"
      fill={mono ? "currentColor" : `url(#${gid})`}
    />
    {/* cloud */}
    <path
      d="M17 38a6 6 0 0 1-.6-11.97A8 8 0 0 1 32 25.2 6.5 6.5 0 0 1 31 38z"
      fill={mono ? "currentColor" : `url(#${gid})`}
      opacity={mono ? "0.85" : "1"}
    />
  </svg>
  <span class="rc-logo__text" style={`color:${textColor}`}>
    Royal<span class="rc-logo__accent" style={`color:${accentColor}`}>Clouds</span>
  </span>
</span>

<style>
  .rc-logo { display: inline-flex; align-items: center; gap: 0.55rem; }
  .rc-logo svg { flex: none; }
  .rc-logo__text {
    font-family: var(--rc-font-sans);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .rc-logo__accent { color: var(--rc-primary); }
  .rc-logo[aria-label] :global(.rc-logo__accent) { }
</style>
