---
/**
 * Royal Clouds wordmark — refined layered-cloud mark with a subtle crown notch.
 * Adapts to the current theme via currentColor on the wordmark; the glyph uses
 * the brand gradient.
 */
interface Props { class?: string; compact?: boolean; }
const { class: className = "", compact = false } = Astro.props;
const gid = "rcMark" + Math.random().toString(36).slice(2, 7);
---
<span class={`logo ${className}`} aria-label="Royal Clouds">
  <svg class="logo__mark" width="34" height="34" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id={gid} x1="4" y1="6" x2="36" y2="34" gradientUnits="userSpaceOnUse">
        <stop stop-color="#6d4aff"/>
        <stop offset="0.55" stop-color="#8b6dff"/>
        <stop offset="1" stop-color="#2f6bff"/>
      </linearGradient>
    </defs>
    <rect x="2" y="2" width="36" height="36" rx="11" fill={`url(#${gid})`}/>
    <rect x="2" y="2" width="36" height="36" rx="11" fill="white" fill-opacity="0.0"/>
    <!-- crown notch + layered cloud, knocked out in white -->
    <path d="M11 15.5l3.2 3.6L20 13l5.8 6.1 3.2-3.6v4.2H11z" fill="white" fill-opacity="0.95"/>
    <path d="M15.5 28.5a4.6 4.6 0 0 1-.5-9.16A6 6 0 0 1 26.4 21a4.9 4.9 0 0 1-.9 7.5z" fill="white"/>
  </svg>
  {!compact && (
    <span class="logo__text">Royal<span class="logo__accent">Clouds</span></span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .logo__mark { flex: none; filter: drop-shadow(0 4px 10px rgba(109,74,255,0.28)); }
  .logo__text { font-family: var(--font-display); font-weight: 800; font-size: 1.32rem; letter-spacing: -0.03em; line-height: 1; color: var(--ink); }
  .logo__accent { color: var(--brand-ink); }
</style>
