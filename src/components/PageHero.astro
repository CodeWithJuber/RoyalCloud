---
import Breadcrumbs from "./Breadcrumbs.astro";

interface Crumb { label: string; href?: string; }
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, subtitle, crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    {crumbs.length > 0 && <div class="page-hero__crumbs"><Breadcrumbs items={crumbs} light /></div>}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 set:html={title} />
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { position: relative; background: var(--rc-gradient-ink); color: #d9d6ec; padding-block: clamp(2.5rem, 6vw, 4.5rem); overflow: hidden; }
  .page-hero::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 85% -10%, rgba(105,56,239,0.45), transparent 45%), radial-gradient(circle at 0% 110%, rgba(47,123,255,0.3), transparent 45%); pointer-events: none; }
  .page-hero .container { position: relative; max-width: 880px; }
  .page-hero__crumbs { margin-bottom: 1.25rem; }
  .page-hero h1 { color: #fff; }
  .page-hero__subtitle { color: #b8b3d6; font-size: 1.15rem; margin-top: 1rem; max-width: 660px; }
</style>
