---
import Breadcrumbs from "./Breadcrumbs.astro";
interface Crumb { label: string; href?: string; }
interface Props { eyebrow?: string; title: string; subtitle?: string; crumbs?: Crumb[]; }
const { eyebrow, title, subtitle, crumbs = [] } = Astro.props;
---
<section class="phero">
  <div class="phero__grid bg-grid" aria-hidden="true"></div>
  <div class="phero__mesh bg-mesh" aria-hidden="true"></div>
  <div class="container phero__inner">
    {crumbs.length > 0 && <div class="phero__crumbs"><Breadcrumbs items={crumbs} /></div>}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 set:html={title} />
    {subtitle && <p class="phero__sub">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; overflow: hidden; padding-block: clamp(2.75rem, 6vw, 4.5rem); border-bottom: 1px solid var(--border); }
  .phero__grid { position: absolute; inset: 0; opacity: .5; }
  .phero__mesh { position: absolute; inset: -20% -10% auto; height: 140%; }
  .phero__inner { position: relative; max-width: 820px; }
  .phero__crumbs { margin-bottom: 1.25rem; }
  .phero__sub { color: var(--muted); font-size: 1.18rem; margin-top: 1rem; max-width: 680px; }
</style>
