---
import Icon from "./Icon.astro";

interface Tier {
  name: string; price: string; priceAnnual?: string; period: string;
  popular?: boolean; summary?: string; cta: string; ctaUrl: string; features: string[];
}
interface Props { tiers: Tier[]; currency?: string; toggle?: boolean; }
const { tiers, currency = "$", toggle = true } = Astro.props;

const hasAnnual = tiers.some((t) => t.priceAnnual);
const showToggle = toggle && hasAnnual;
const annualOf = (t: Tier) => t.priceAnnual ?? t.price;
---
<div class="pricing" data-pricing>
  {showToggle && (
    <div class="billing">
      <button class="billing__opt is-on" data-bill="monthly" type="button">Monthly</button>
      <button class="billing__opt" data-bill="annual" type="button">Annual <span class="billing__save">Save 20%</span></button>
    </div>
  )}
  <div class="pricing__grid" data-count={tiers.length}>
    {tiers.map((t) => (
      <div class={`ptier${t.popular ? " is-popular" : ""} reveal`}>
        {t.popular && <span class="ptier__badge"><Icon name="sparkle" size={13} /> Most Popular</span>}
        <h3 class="ptier__name">{t.name}</h3>
        {t.summary && <p class="ptier__summary">{t.summary}</p>}
        <div class="ptier__price">
          <span class="ptier__cur">{currency}</span>
          <span class="ptier__amt" data-monthly={t.price} data-annual={annualOf(t)}>{t.price}</span>
          <span class="ptier__per">{t.period}</span>
        </div>
        <a href={t.ctaUrl} class={`btn ${t.popular ? "btn--gradient" : "btn--outline"} btn--block`}>{t.cta}</a>
        <ul class="ptier__features">
          {t.features.map((f) => (<li><Icon name="check" size={17} /> <span>{f}</span></li>))}
        </ul>
      </div>
    ))}
  </div>
</div>

<style>
  .billing { display: inline-flex; margin: 0 auto clamp(1.75rem, 3vw, 2.5rem); padding: 5px; background: var(--bg-inset); border: 1px solid var(--border); border-radius: var(--r-pill); align-self: center; }
  .pricing { display: flex; flex-direction: column; align-items: center; }
  .billing__opt { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-weight: 600; font-size: 0.92rem; color: var(--muted); padding: 0.55rem 1.1rem; border-radius: var(--r-pill); transition: color .2s ease, background .2s ease, box-shadow .2s ease; }
  .billing__opt.is-on { color: var(--ink); background: var(--surface); box-shadow: var(--shadow-xs); }
  .billing__save { font-size: 0.72rem; font-weight: 700; color: var(--success); background: var(--success-soft); padding: 0.15rem 0.45rem; border-radius: var(--r-pill); }

  .pricing__grid { width: 100%; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); align-items: stretch; }
  .pricing__grid[data-count="5"] { grid-template-columns: repeat(auto-fit, minmax(214px, 1fr)); }

  .ptier { position: relative; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-xl); padding: 1.8rem 1.5rem; box-shadow: var(--shadow-sm); transition: transform .22s cubic-bezier(.2,.7,.3,1), box-shadow .22s ease, border-color .22s ease; }
  .ptier:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); border-color: var(--border-strong); }
  .ptier.is-popular { border-color: transparent; box-shadow: var(--shadow-lg); background:
    linear-gradient(var(--surface), var(--surface)) padding-box,
    var(--brand-gradient) border-box; border: 1.5px solid transparent; }
  .ptier__badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 0.3rem; background: var(--brand-gradient); color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 0.7rem; letter-spacing: .04em; text-transform: uppercase; padding: 0.35rem 0.85rem; border-radius: var(--r-pill); box-shadow: var(--shadow-brand); white-space: nowrap; }
  .ptier__name { font-size: 1.3rem; }
  .ptier__summary { color: var(--muted); font-size: 0.9rem; margin-top: 0.35rem; min-height: 2.5em; }
  .ptier__price { display: flex; align-items: flex-start; gap: 2px; margin: 1.1rem 0 1.3rem; color: var(--ink); }
  .ptier__cur { font-family: var(--font-display); font-weight: 650; font-size: 1.2rem; margin-top: 0.45rem; }
  .ptier__amt { font-family: var(--font-display); font-weight: 800; font-size: 2.9rem; line-height: 1; letter-spacing: -0.04em; }
  .ptier__per { color: var(--muted); font-weight: 600; align-self: flex-end; margin-bottom: 0.4rem; }
  .ptier__features { margin-top: 1.5rem; display: grid; gap: 0.7rem; }
  .ptier__features li { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.92rem; color: var(--text); }
  .ptier__features :global(svg) { color: var(--success); flex: none; margin-top: 2px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-pricing]").forEach((block) => {
    const opts = block.querySelectorAll<HTMLButtonElement>(".billing__opt");
    const amts = block.querySelectorAll<HTMLElement>(".ptier__amt");
    opts.forEach((opt) => opt.addEventListener("click", () => {
      opts.forEach((o) => o.classList.remove("is-on"));
      opt.classList.add("is-on");
      const annual = opt.dataset.bill === "annual";
      amts.forEach((a) => { a.textContent = annual ? (a.dataset.annual || "") : (a.dataset.monthly || ""); });
    }));
  });
</script>
