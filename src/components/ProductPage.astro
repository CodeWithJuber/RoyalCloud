---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import heroImage from '~/assets/images/hero.png';
import { toPrices, toFeatureItems, type Plan } from '~/utils/plans';
import faqsData from '~/data/faqs.json';

interface Props {
  plan: Plan;
}
const { plan } = Astro.props as Props;
const PORTAL = 'https://my.royalclouds.net';

const metadata = {
  title: `${plan.name} — From ${plan.currency}${plan.tiers[0].price}/mo`,
  description: plan.subtitle,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { variant: 'primary', text: `From ${plan.currency}${plan.tiers[0].price}/mo`, href: '#pricing', icon: 'tabler:rocket' },
      { text: 'Talk to sales', href: 'mailto:sales@royalclouds.net' },
    ]}
    image={{ src: heroImage, alt: `${plan.name} illustration` }}
  >
    <Fragment slot="title">{plan.title}</Fragment>
    <Fragment slot="subtitle">{plan.subtitle}</Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-b from-green-50/70 to-transparent dark:from-transparent"></div>
    </Fragment>
  </Hero>

  <Pricing
    id="pricing"
    title={`${plan.name} plans`}
    subtitle={plan.billingNote}
    tagline="Pricing"
    prices={toPrices(plan)}
  />

  <Features
    tagline={`Why ${plan.name}`}
    title="Built for performance, security & peace of mind"
    columns={2}
    items={toFeatureItems(plan)}
  />

  <FAQs
    title="Frequently asked questions"
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={faqsData.general.map((f) => ({ title: f.q, description: f.a }))}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Get Started', href: `${PORTAL}/cart.php`, target: '_blank', icon: 'tabler:rocket' },
      { text: 'Live chat', href: `${PORTAL}/clientarea.php`, target: '_blank' },
    ]}
  >
    <Fragment slot="title">Ready to get started?</Fragment>
    <Fragment slot="subtitle">Free SSL, free migration and a 30-day money-back guarantee on every plan.</Fragment>
  </CallToAction>
</Layout>
