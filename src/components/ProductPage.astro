---
import PricingCards from "./PricingCards.astro";
import FeatureGrid from "./FeatureGrid.astro";
import Faq from "./Faq.astro";
import CTASection from "./CTASection.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import Icon from "./Icon.astro";
import site from "../data/site.json";
import faqs from "../data/faqs.json";

interface Plan {
  name: string; eyebrow: string; title: string; subtitle: string;
  currency: string; billingNote?: string; tiers: any[];
  highlights: { icon: string; title: string; text: string }[];
}
interface Props { plan: Plan; }
const { plan } = Astro.props;
---
<section class="phero">
  <div class="phero__grid bg-grid" aria-hidden="true"></div>
  <div class="phero__mesh bg-mesh" aria-hidden="true"></div>
  <div class="container phero__inner">
    <div class="phero__crumbs"><Breadcrumbs items={[{ label: plan.name }]} /></div>
    <span class="eyebrow">{plan.eyebrow}</span>
    <h1>{plan.title}</h1>
    <p class="phero__sub">{plan.subtitle}</p>
    <ul class="phero__badges">
      {site.trustBadges.map((b) => (<li><Icon name="check" size={15} /> {b}</li>))}
    </ul>
  </div>
</section>

<section class="section">
  <div class="container container-wide">
    <PricingCards tiers={plan.tiers} currency={plan.currency} />
    {plan.billingNote && <p class="pbilling">{plan.billingNote}</p>}
  </div>
</section>

<section class="section section--tint">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Why {plan.name}</span>
      <h2>Built for performance, security &amp; peace of mind</h2>
    </div>
    <FeatureGrid items={plan.highlights} columns={4} />
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">FAQ</span>
      <h2>Frequently asked questions</h2>
    </div>
    <Faq items={faqs.general} />
  </div>
</section>

<CTASection />

<style>
  .phero { position: relative; overflow: hidden; padding-block: clamp(2.75rem, 6vw, 4.25rem); border-bottom: 1px solid var(--border); }
  .phero__grid { position: absolute; inset: 0; opacity: .5; }
  .phero__mesh { position: absolute; inset: -20% -10% auto; height: 140%; }
  .phero__inner { position: relative; max-width: 880px; }
  .phero__crumbs { margin-bottom: 1.25rem; }
  .phero__sub { color: var(--muted); font-size: 1.18rem; margin-top: 1rem; max-width: 700px; }
  .phero__badges { display: flex; flex-wrap: wrap; gap: 0.7rem 1.5rem; margin-top: 1.75rem; }
  .phero__badges li { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-display); font-weight: 550; font-size: 0.9rem; color: var(--text); }
  .phero__badges :global(svg) { color: var(--success); }
  .pbilling { text-align: center; color: var(--muted); margin-top: 1.5rem; font-size: 0.95rem; }
</style>
