---
import CurrencySwitch from "@/components/ui/CurrencySwitch.astro";
import { siteSettings } from "@/data/settings";

const { announcement, marquee, navigation, whmcsUrl, logoLight } = siteSettings;
---

{announcement && (
  <aside class="announcement" id="rc-announcement" aria-label="Announcement">
    <p>
      <span>{announcement.message}</span>
      {announcement.action && (
        <a href={announcement.action.href}>
          {announcement.action.label}
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </p>
    <button type="button" class="announcement-close" data-announcement-dismiss aria-label="Dismiss announcement">
      <svg viewBox="0 0 14 14" width="11" height="11" aria-hidden="true" focusable="false">
        <path d="M1 1l12 12M13 1L1 13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
  </aside>
)}

{marquee && marquee.length > 0 && (
  <div class="marquee" aria-hidden="true">
    {/* Duplicated once so the -50% translate loops seamlessly. aria-hidden
        because a perpetually looping ticker is hostile to a screen reader. */}
    <div class="marquee__track">
      {[0, 1].map(() => (
        <span class="marquee__group">
          {marquee.map((item) => (
            <>
              <span>{item}</span>
              <span class="marquee__star">✦</span>
            </>
          ))}
        </span>
      ))}
    </div>
  </div>
)}

<div class="header-dock" data-header>
  <header class="island">
    <a class="brand" href="/" aria-label="Royal Clouds home">
      <img src={logoLight} width="176" height="46" alt="Royal Clouds" />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {navigation.map((group) => (
        <details class="nav-group" data-nav-group>
          <summary>
            <span>{group.label}</span>
            <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true" focusable="false">
              <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="nav-panel">
            {group.items.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </details>
      ))}
    </nav>

    <div class="header-actions">
      <CurrencySwitch />
      <a class="login-link" href={`${whmcsUrl}/login`}>Sign in</a>
      <a class="button button-primary header-cta" href={whmcsUrl}>Open console</a>
    </div>

    <details class="mobile-nav" data-mobile-nav>
      <summary aria-label="Menu"><span class="bars" aria-hidden="true"></span></summary>
      <div class="mobile-panel" data-mobile-panel>
        {navigation.map((group) => (
          <section>
            <h2>{group.label}</h2>
            {group.items.map((item) => <a href={item.href}>{item.label}</a>)}
          </section>
        ))}
        <div class="mobile-foot">
          <CurrencySwitch />
          <a class="button button-ghost button-block" href={`${whmcsUrl}/login`}>Sign in</a>
          <a class="button button-primary button-block" href={whmcsUrl}>Open console</a>
        </div>
      </div>
    </details>
  </header>
</div>

<script is:inline>
  // Inline + parse-time: a previously dismissed band is removed before first paint, so CLS stays 0.
  (() => {
    const band = document.getElementById("rc-announcement");
    if (!band) return;
    const KEY = "rc:announcement-dismissed";
    const stamp = (band.textContent || "").trim();
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(KEY) === stamp;
    } catch {
      dismissed = false; // storage blocked: always show
    }
    if (dismissed) {
      band.remove();
      return;
    }
    band.querySelector("[data-announcement-dismiss]")?.addEventListener("click", () => {
      try {
        localStorage.setItem(KEY, stamp);
      } catch {
        // storage blocked: dismiss for this page view only
      }
      band.remove();
    });
  })();
</script>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  if (header) {
    const groups = Array.from(header.querySelectorAll<HTMLDetailsElement>("[data-nav-group]"));
    const mobile = header.querySelector<HTMLDetailsElement>("[data-mobile-nav]");
    const panel = header.querySelector<HTMLElement>("[data-mobile-panel]");
    const all = [...groups, mobile].filter((node): node is HTMLDetailsElement => Boolean(node));

    const closeAll = (except?: HTMLDetailsElement) => {
      for (const node of all) if (node !== except) node.open = false;
    };

    for (const node of all) {
      node.addEventListener("toggle", () => {
        if (!node.open) return;
        closeAll(node);
        if (node === mobile) panel?.querySelector<HTMLElement>("a, button")?.focus();
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const open = all.find((node) => node.open);
      if (!open) return;
      closeAll();
      open.querySelector<HTMLElement>("summary")?.focus();
    });

    document.addEventListener("pointerdown", (event) => {
      if (!header.contains(event.target as Node)) closeAll();
    });

    // The mobile panel is a modal surface, so Tab must cycle inside it.
    header.addEventListener("keydown", (event) => {
      if (event.key !== "Tab" || !mobile?.open || !panel) return;
      const stops = [
        mobile.querySelector<HTMLElement>("summary"),
        ...panel.querySelectorAll<HTMLElement>("a, button")
      ].filter((node): node is HTMLElement => Boolean(node));
      const first = stops[0];
      const last = stops[stops.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Shadow appears only once the page has actually scrolled.
    const SCROLL_THRESHOLD = 8;
    let ticking = false;
    const syncShadow = () => {
      header.classList.toggle("is-scrolled", window.scrollY > SCROLL_THRESHOLD);
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(syncShadow);
      },
      { passive: true },
    );
    syncShadow();
  }
</script>

<style>
  /* 10.1 — 36px night band, label copy, one promo statement, optional dismiss. */
  .announcement {
    position: relative;
    color: var(--rc-muted-dark);
    background: var(--rc-night);
  }
  .announcement p {
    display: flex;
    max-width: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 1rem;
    min-height: 2.25rem;
    margin: 0;
    padding: 0.5rem 3rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
  }
  .announcement a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--rc-gold);
    text-decoration: none;
  }
  .announcement a:hover { color: var(--rc-gold-light); text-decoration: underline; }

  .announcement-close {
    position: absolute;
    top: 50%;
    right: 0.25rem;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: var(--rc-muted);
    background: transparent;
    transform: translateY(-50%);
    cursor: pointer;
  }
  .announcement-close:hover { color: var(--rc-lavender); }

  .marquee {
    overflow: hidden;
    padding-block: 0.625rem;
    background: var(--rc-night);
    color: #fff;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 30s linear infinite;
  }
  .marquee__group {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .marquee__star {
    color: var(--rc-gold);
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* A perpetually-moving band is a vestibular trigger — stop it entirely. */
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }

  /* 10.2 — detached floating island: 64px, pill, midnight at 88% + chrome hairline. */
  .header-dock {
    position: sticky;
    z-index: 100;
    top: 0.75rem;
    padding-inline: clamp(0.75rem, 3vw, 2rem);
    transition: box-shadow var(--dur-2) var(--ease-out);
  }
  .header-dock.is-scrolled {
    box-shadow: 0 4px 18px rgb(35 18 82 / 0.18);
  }
  @media (prefers-reduced-motion: reduce) {
    .header-dock {
      transition: none;
    }
  }

  .island {
    display: flex;
    width: min(82.5rem, 100%);
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
    margin-inline: auto;
    padding: 0.4rem 0.4rem 0.4rem 1.5rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--rc-night) 88%, transparent);
    box-shadow: var(--sh-3);
  }
  @supports (backdrop-filter: blur(1px)) {
    .island { backdrop-filter: blur(14px) saturate(140%); }
  }

  .brand { display: flex; flex-shrink: 0; align-items: center; }
  .brand img { width: auto; height: 2rem; }

  .desktop-nav { display: flex; flex: 1; align-items: center; gap: 0.25rem; }
  .nav-group { position: relative; }
  .nav-group summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0 0.85rem;
    border-radius: var(--r-pill);
    color: var(--rc-lavender);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .nav-group summary::-webkit-details-marker { display: none; }
  .nav-group summary svg { color: var(--rc-muted); }
  .nav-group summary:hover { background: color-mix(in srgb, var(--paper) 7%, transparent); }
  .nav-group[open] summary { background: color-mix(in srgb, var(--paper) 9%, transparent); }
  .nav-group[open] summary svg { transform: rotate(180deg); }

  /* 23px abyss sheet, two-column links. */
  .nav-panel {
    position: absolute;
    z-index: 10;
    top: calc(100% + 0.85rem);
    left: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(9.5rem, 1fr));
    gap: 0.15rem;
    padding: 0.6rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--r-inner);
    background: var(--rc-night-deep);
    box-shadow: var(--sh-3);
  }
  .nav-panel a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--r-input);
    color: var(--rc-muted);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-panel a:hover { color: var(--rc-lavender); background: color-mix(in srgb, var(--paper) 6%, transparent); }

  .header-actions { display: flex; flex-shrink: 0; align-items: center; gap: 0.75rem; }
  .login-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    color: var(--rc-muted);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .login-link:hover { color: var(--rc-lavender); }
  .header-cta { min-height: 2.75rem; padding: 0.3rem 0.35rem 0.3rem 1.15rem; font-size: 0.875rem; }
  .header-cta::after { width: 2rem; height: 2rem; }

  .mobile-nav { display: none; }
  .mobile-nav summary {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--line-dark);
    border-radius: 50%;
    list-style: none;
    cursor: pointer;
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .bars, .bars::before, .bars::after {
    display: block;
    width: 1.125rem;
    height: 2px;
    border-radius: 2px;
    background: var(--rc-lavender);
    content: "";
  }
  .bars { position: relative; }
  .bars::before { position: absolute; top: -6px; }
  .bars::after { position: absolute; top: 6px; }
  .mobile-nav[open] .bars { background: transparent; }
  .mobile-nav[open] .bars::before { top: 0; transform: rotate(45deg); }
  .mobile-nav[open] .bars::after { top: 0; transform: rotate(-45deg); }

  .mobile-panel {
    position: fixed;
    z-index: 40;
    inset: 5.5rem 0.75rem 0.75rem;
    overflow-y: auto;
    padding: 1.5rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--r-shell);
    background: var(--rc-night);
    box-shadow: var(--sh-3);
    overscroll-behavior: contain;
  }
  .mobile-panel section { margin-bottom: 1.5rem; }
  .mobile-panel h2 {
    max-width: none;
    margin: 0 0 0.25rem;
    color: var(--rc-muted-dark);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .mobile-panel section a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    border-bottom: 1px solid var(--line-dark);
    color: var(--rc-lavender);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
  }
  .mobile-foot { display: grid; gap: 0.75rem; justify-items: stretch; }

  @media (max-width: 768px) {
    .desktop-nav, .header-actions { display: none; }
    .mobile-nav { display: block; margin-left: auto; }
    .island { gap: 1rem; padding: 0.4rem 0.5rem 0.4rem 1rem; }
    .announcement p { padding-inline: 2.75rem 3rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-group summary svg { transition: transform 320ms var(--ease); }
    .bars, .bars::before, .bars::after { transition: transform 240ms var(--ease), background-color 240ms var(--ease); }
    .nav-panel { animation: nav-panel-in 220ms var(--ease); }
  }

  @keyframes nav-panel-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }
</style>
