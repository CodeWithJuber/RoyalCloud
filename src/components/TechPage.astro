---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { tablerIcon } from '~/utils/plans';

interface Tech {
  eyebrow: string;
  title: string;
  subtitle: string;
  features: { icon: string; title: string; text: string }[];
}
const { tech } = Astro.props as { tech: Tech };
const PORTAL = 'https://my.royalclouds.net';
const metadata = { title: tech.title, description: tech.subtitle };
---

<Layout metadata={metadata}>
  <HeroText tagline={tech.eyebrow} title={tech.title} subtitle={tech.subtitle} />

  <Features
    columns={3}
    items={tech.features.map((f) => ({ title: f.title, description: f.text, icon: tablerIcon(f.icon) }))}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Get Started', href: `${PORTAL}/cart.php`, target: '_blank', icon: 'tabler:rocket' }]}
  >
    <Fragment slot="title">Experience enhanced speed</Fragment>
    <Fragment slot="subtitle">Premium SSD hosting from $1.99/mo — free SSL, free migration, 24/7 support.</Fragment>
  </CallToAction>
</Layout>
