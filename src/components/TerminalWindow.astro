---
/** Terminal mockup for the VPS/developer narrative. */
interface Line { prompt?: string; text: string; kind: "cmd" | "out" | "ok"; }
const lines: Line[] = [
  { prompt: "$", text: "ssh root@royalclouds", kind: "cmd" },
  { text: "Welcome to Royal Clouds KVM VPS · Ubuntu 24.04 LTS", kind: "out" },
  { prompt: "$", text: "curl -sL get.royalclouds.net | bash", kind: "cmd" },
  { text: "✓ NVMe SSD detected · LiteSpeed installed", kind: "ok" },
  { text: "✓ Free SSL issued · firewall configured", kind: "ok" },
  { prompt: "$", text: "uptime", kind: "cmd" },
  { text: "up 312 days · load 0.04 · 99.99% SLA", kind: "out" },
];
---
<div class="term" role="img" aria-label="Terminal showing a Royal Clouds VPS being provisioned">
  <div class="term__bar">
    <span class="term__dot" style="--c:#ff5f57"></span>
    <span class="term__dot" style="--c:#febc2e"></span>
    <span class="term__dot" style="--c:#28c840"></span>
    <span class="term__title">bash — royalclouds</span>
  </div>
  <div class="term__body">
    {lines.map((l) => (
      <div class={`term__line term__${l.kind}`}>
        {l.prompt && <span class="term__prompt">{l.prompt}</span>}
        <span>{l.text}</span>
      </div>
    ))}
    <div class="term__line"><span class="term__caret">▋</span></div>
  </div>
</div>

<style>
  .term { width: 100%; max-width: 520px; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--border-strong); box-shadow: var(--shadow-lg); background: #0c0e1a; }
  .term__bar { display: flex; align-items: center; gap: 7px; padding: 0.7rem 1rem; background: #15182a; border-bottom: 1px solid rgba(255,255,255,0.07); }
  .term__dot { width: 11px; height: 11px; border-radius: 50%; background: var(--c); }
  .term__title { margin-left: 0.6rem; font-size: 0.78rem; color: #8a8fa9; }
  .term__body { padding: 1.2rem 1.3rem; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.85rem; line-height: 1.9; }
  .term__line { display: flex; gap: 0.1rem; color: #c7cbe0; word-break: break-word; }
  .term__prompt { color: #19c08a; margin-right: 0.6rem; font-weight: 700; }
  .term__ok { color: #2fd180; }
  .term__out { color: #9aa0bd; }
  .term__cmd > span:last-child { color: #f4f5fb; }
  .term__caret { color: #19c08a; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .term__caret { animation: none; } }
</style>
