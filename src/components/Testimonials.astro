---
import Icon from "./Icon.astro";
import data from "../data/testimonials.json";

interface Props { limit?: number; }
const { limit } = Astro.props;
const items = limit ? data.items.slice(0, limit) : data.items;
---
<div class="testimonials">
  {items.map((t) => (
    <figure class="testimonial reveal">
      <div class="stars" aria-label={`${t.rating} out of 5 stars`}>
        {Array.from({ length: t.rating }).map(() => (<Icon name="star" size={18} />))}
      </div>
      <blockquote>{t.quote}</blockquote>
      <figcaption>
        <span class="testimonial__avatar" aria-hidden="true">{t.name.charAt(0)}</span>
        <span>
          <span class="testimonial__name">{t.name}</span>
          <span class="testimonial__site">{t.site}</span>
        </span>
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .testimonials { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .testimonial {
    background: #fff; border: 1px solid var(--rc-line); border-radius: var(--rc-radius-lg);
    padding: 1.75rem; box-shadow: var(--rc-shadow-sm); display: flex; flex-direction: column; gap: 1rem;
  }
  .testimonial .stars :global(svg) { fill: var(--rc-star); stroke: var(--rc-star); }
  .testimonial blockquote { color: var(--rc-body); font-size: 1.02rem; line-height: 1.6; flex: 1; }
  .testimonial figcaption { display: flex; align-items: center; gap: 0.85rem; margin-top: auto; }
  .testimonial__avatar { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 50%; background: var(--rc-gradient); color: #fff; font-family: var(--rc-font-sans); font-weight: 800; font-size: 1.1rem; }
  .testimonial__name { display: block; font-family: var(--rc-font-sans); font-weight: 700; color: var(--rc-ink); }
  .testimonial__site { display: block; font-size: 0.85rem; color: var(--rc-muted); }
</style>
