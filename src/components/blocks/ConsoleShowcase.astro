---
/* DESIGN.md 8.6 — the Royal Console as the product hero. The console is chrome:
   every word inside it comes from the block. No fabricated screenshot, no metric
   the product cannot actually show (DESIGN.md 11). */
import type { ConsoleShowcaseBlock } from "../../types/content";

interface Props { block: ConsoleShowcaseBlock }
const { block } = Astro.props;

const screens = block.screens ?? [];
const action = block.action;
const external = action ? (action.external ?? action.href.startsWith("http")) : false;
const uid = Math.random().toString(36).slice(2, 8);
---

{screens.length > 0 && (
<section class="section section-dark" aria-labelledby={`console-showcase-${uid}`}>
  <div class="shell console-showcase" data-console-showcase>
    <div class="rail">
      <header class="section-header" data-reveal>
        {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
        <h2 id={`console-showcase-${uid}`}>{block.title}</h2>
        <p class="lede">{block.summary}</p>
      </header>

      {screens.length > 1 && (
        <div class="segment console-switch" data-console-switch hidden>
          {screens.map((screen, index) => (
            <button
              type="button"
              aria-pressed={index === 0 ? "true" : "false"}
              aria-controls={`console-frame-${uid}-${index}`}
              data-console-tab={index}
            >{screen.label}</button>
          ))}
        </div>
      )}

      {action && (
        <div class="button-row" data-reveal>
          <a
            class="button button-primary"
            href={action.href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
          >{action.label}</a>
        </div>
      )}
    </div>

    {/* Without JS every frame stays in the flow and stays readable; the script
        only collapses them into a switcher once it can actually drive one. */}
    <div class="frames" data-reveal>
      {screens.map((screen, index) => (
        <div class="frame" id={`console-frame-${uid}-${index}`} data-console-frame={index}>
          <article class="screen-card">
            <h3 class="screen-card__label">{screen.label}</h3>
            {screen.caption && <p class="screen-card__caption">{screen.caption}</p>}
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-console-showcase]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-console-tab]")];
    const frames = [...root.querySelectorAll<HTMLElement>("[data-console-frame]")];
    const control = root.querySelector<HTMLElement>("[data-console-switch]");
    if (!control || tabs.length < 2) continue;

    const select = (index: number) => {
      tabs.forEach((tab, i) => tab.setAttribute("aria-pressed", String(i === index)));
      frames.forEach((frame, i) => { frame.hidden = i !== index; });
    };

    control.hidden = false;
    tabs.forEach((tab, index) => tab.addEventListener("click", () => select(index)));
    select(0);
  }
</script>

<style>
  .console-showcase {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .console-showcase { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }

  .rail {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .rail .section-header { margin: 0; }

  /* Real control: 44px targets, wraps rather than overflowing at 390px. */
  .console-switch {
    flex-wrap: wrap;
    max-width: 100%;
  }
  .console-switch button { min-height: 44px; }
  /* No focus-ring override needed: .section-dark (global.css) sets
     --interactive: var(--rc-lavender), inherited here, and the global
     :focus-visible rule reads --interactive — 13.25:1 on --rc-night. Covers
     the tab switcher and the rail's primary action link alike. */

  .frames { display: grid; gap: 1.5rem; }
  .frames [hidden] { display: none; }

  .screen-card {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-panel);
    background: rgb(255 255 255 / 0.05);
  }
  .screen-card__label {
    margin: 0 0 0.5rem;
    font-size: 1.0625rem;
    color: #fff;
  }
  .screen-card__caption {
    margin: 0;
    max-width: 60ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.72);
  }
</style>
