---
import type { CtaBlock } from "../../types/content";

interface Props { block: CtaBlock }
const { block } = Astro.props;
const external = block.action.external ?? block.action.href.startsWith("http");
---

<section class="section section-dark cta" aria-labelledby="cta-title" data-reveal>
  <div class="shell section-header cta__copy">
    {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
    <h2 id="cta-title">{block.title}</h2>
    <p class="lede">{block.summary}</p>

    <div class="button-row">
      <a
        class="button button-cta"
        href={block.action.href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
      >{block.action.label}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(
      95deg,
      var(--rc-primary-dark),
      var(--rc-primary) 45%,
      var(--rc-primary-light)
    );
    color: #fff;
  }

  .cta__copy {
    margin-bottom: 0;
  }
  .cta__copy h2 {
    color: #fff;
  }
  /* rgb(255 255 255 / 0.88) composites to 4.17:1 at this gradient's lightest
     stop (--rc-primary-light) — under the 4.5:1 floor, same finding as
     Hero's .hero__lede. rc-lavender holds 4.60:1 at that stop. */
  .cta__copy .lede {
    color: var(--rc-lavender);
  }
  /* .section-dark .eyebrow (global.css) paints this gold — 3.19:1 on
     --rc-primary-light, under the 4.5:1 floor now that this section is a
     violet gradient rather than solid night. Same rc-lavender fix as above. */
  .cta__copy .eyebrow {
    color: var(--rc-lavender);
  }
  .cta__copy .button-row {
    margin-top: 1.75rem;
  }
  /* No focus-ring override needed: .section-dark (global.css) now sets
     --interactive: var(--rc-lavender), which this element inherits, and the
     global :focus-visible rule reads --interactive. Clears 3:1 at every
     stop of this gradient (4.60:1 worst case, at primary-light). */
</style>
