---
import StackSchematic from "@/components/visuals/StackSchematic.astro";
import type { FeatureNarrativeBlock } from "../../types/content";

interface Props { block: FeatureNarrativeBlock }
const { block } = Astro.props;

const haystack = `${block.eyebrow} ${block.title}`.toLowerCase();
const variant = haystack.includes("one stack")
  ? "core"
  : haystack.includes("vps") || haystack.includes("compute")
    ? "vps"
    : haystack.includes("wordpress")
      ? "wordpress"
      : haystack.includes("dedicated")
        ? "dedicated"
        : haystack.includes("shared") || haystack.includes("hosting")
          ? "shared"
          : "core";
---

<section class="section section-light features" aria-label={block.title}>
  <div class="shell">
    <header class="section-header" data-reveal>
      {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
      <h2>{block.title}</h2>
      {block.summary && <p class="lede">{block.summary}</p>}
    </header>

    <div class="features__grid">
      <div class="schematic" data-reveal>
        <StackSchematic variant={variant} />
      </div>

      <ul class="feature-list">
        {block.items.map((item) => (
          <li class="card" data-reveal>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .features__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .schematic {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--r-shell);
    background: linear-gradient(160deg, var(--rc-lavender), var(--paper));
  }

  .feature-list { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .feature-list h3 { margin: 0 0 0.375rem; }
  .feature-list p { margin: 0; font-size: 0.9375rem; }

  @media (max-width: 900px) {
    .features__grid { grid-template-columns: 1fr; }
  }
</style>
