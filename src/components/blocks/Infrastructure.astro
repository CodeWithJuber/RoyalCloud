---
import NetworkAtlas from "@/components/visuals/NetworkAtlas.astro";
import type { InfrastructureBlock } from "../../types/content";

interface Props { block: InfrastructureBlock }
const { block } = Astro.props;
---

<section class="section section-dark" aria-labelledby="infrastructure-title">
  <div class="shell">
    <header class="section-header" data-reveal>
      {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
      <h2 id="infrastructure-title">{block.title}</h2>
      {block.summary && <p class="lede">{block.summary}</p>}
    </header>

    <div class="atlas" data-reveal>
      <NetworkAtlas />
    </div>

    {block.locations.length > 0 && (
      <ul class="locations" data-reveal>
        {block.locations.map((location) => (
          <li>
            <h3>{location.city}</h3>
            <p class="region">{location.region}</p>
            <p class="detail">{location.detail}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .atlas {
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--chrome) 20%, transparent);
    border-radius: var(--r-shell);
    background: color-mix(in srgb, var(--paper) 5%, transparent);
  }

  .locations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.25rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .locations li {
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--chrome) 20%, transparent);
    border-radius: var(--r-inner);
    background: color-mix(in srgb, var(--paper) 4%, transparent);
  }
  .locations h3 { margin: 0 0 0.15rem; font-size: 1.0625rem; }
  .region { margin: 0 0 0.5rem; color: var(--chrome); font-size: 0.8125rem; font-weight: 700; }
  .detail { margin: 0; color: var(--smoke); font-size: 0.875rem; }
</style>
