---
import type { LaunchSequenceBlock } from "../../types/content";

interface Props { block: LaunchSequenceBlock }
const { block } = Astro.props;
const external = block.action.external ?? block.action.href.startsWith("http");
---

<section class="section section-tint" aria-labelledby="launch-sequence-title">
  <div class="shell">
    <header class="section-header" data-reveal>
      {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
      <h2 id="launch-sequence-title">{block.title}</h2>
      <p class="lede">{block.summary}</p>
    </header>

    <ol class="sequence" data-reveal>
      {block.steps.map((step, index) => (
        <li class="step" style={`--i:${index}`}>
          <div class="step-rail">
            <span class="step-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span class="step-node" aria-hidden="true"></span>
          </div>
          <div class="step-body">
            {index === 0 && (
              <svg class="step-glyph" viewBox="0 0 120 40" aria-hidden="true" focusable="false">
                <rect x="0.5" y="0.5" width="119" height="39" rx="8" />
                <line class="glyph-soft" x1="14" y1="15" x2="86" y2="15" />
                <line class="glyph-soft" x1="14" y1="25" x2="58" y2="25" />
                <rect class="glyph-caret" x="90" y="10" width="2" height="20" />
              </svg>
            )}
            {index === 1 && (
              <svg class="step-glyph" viewBox="0 0 120 40" aria-hidden="true" focusable="false">
                <line x1="12.5" y1="6" x2="12.5" y2="32.5" />
                <line x1="12.5" y1="12.5" x2="30" y2="12.5" />
                <line x1="12.5" y1="32.5" x2="30" y2="32.5" />
                <rect class="glyph-soft" x="30.5" y="6.5" width="56" height="12" rx="3" />
                <rect class="glyph-soft" x="30.5" y="26.5" width="38" height="12" rx="3" />
              </svg>
            )}
            {index === 2 && (
              <svg class="step-glyph" viewBox="0 0 120 40" aria-hidden="true" focusable="false">
                <rect x="0.5" y="3.5" width="60" height="36" rx="3" />
                <rect class="glyph-soft" x="68.5" y="10.5" width="30" height="29" rx="3" />
                <rect class="glyph-soft" x="104.5" y="17.5" width="15" height="22" rx="3" />
              </svg>
            )}
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="button-row" data-reveal>
      <a
        class="button button-primary"
        href={block.action.href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
      >{block.action.label}</a>
    </div>
  </div>
</section>

<style>
  /* Mobile: vertical sequence. The connecting rule is drawn per-step on the rail
     so it chains continuously without needing a wrapper pseudo-element. */
  .sequence {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
  }

  .step {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 0 1.25rem;
    padding-bottom: 2.25rem;
  }
  .step:last-child { padding-bottom: 0; }

  .step-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .step-rail::after {
    content: "";
    position: absolute;
    inset-block: 0.5rem -2.25rem;
    inset-inline-start: calc(50% - 0.5px);
    width: 1px;
    background: var(--line);
  }
  .step:last-child .step-rail::after { display: none; }

  .step-index {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }
  .step-node {
    width: 7px;
    height: 7px;
    margin: 0.75rem 0 0 calc(50% - 3.5px);
    border-radius: 50%;
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--viz-line);
  }

  .step-glyph {
    display: block;
    width: 100%;
    max-width: 15rem;
    height: auto;
    margin-bottom: 1.125rem;
    fill: none;
    stroke: var(--viz-line);
    stroke-width: 1;
  }
  .step-glyph .glyph-soft { stroke: var(--viz-line-soft); }
  .step-glyph .glyph-caret { fill: var(--viz-line); stroke: none; }

  .step-body h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--heading);
  }
  .step-body p {
    margin: 0;
    max-width: 34ch;
    color: var(--body);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Desktop: horizontal narrative. The rail rules join across the gutter into a
     single spine, so the steps read as one run, not three cards. */
  @media (min-width: 56rem) {
    .sequence {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 2.5rem;
    }
    .step {
      grid-template-columns: 1fr;
      gap: 0;
      padding-bottom: 0;
    }
    .step-rail {
      flex-direction: row;
      align-items: flex-end;
      gap: 0.875rem;
      padding-bottom: 1.25rem;
    }
    .step-rail::after {
      inset: auto 0 0 0;
      width: auto;
      height: 1px;
      margin-inline-end: -2.5rem;
    }
    .step:last-child .step-rail::after {
      display: block;
      margin-inline-end: 0;
    }
    .step-node {
      margin: 0 0 -3px;
      background: var(--surface-card);
    }
    .step-body { padding-top: 1.5rem; }
  }

  /* Reveal stagger — transform only, gated on [data-js] so no-JS renders in place. */
  :global([data-js="true"]) [data-reveal] .step {
    transform: translateY(0.75rem);
    transition: transform 720ms var(--ease);
    transition-delay: calc(var(--i, 0) * 90ms);
  }
  [data-reveal][data-visible="true"] .step { transform: none; }

  @media (prefers-reduced-motion: reduce) {
    :global([data-js="true"]) [data-reveal] .step {
      transform: none;
      transition: none;
    }
  }
</style>
