---
import type { LedgerTableBlock } from "../../types/content";

interface Props { block: LedgerTableBlock }
const { block } = Astro.props;

/* A cell is boolean-ish only when the data says so literally. Anything else
   (a price, a spec, a dash) prints verbatim — we never coerce prose into a
   tick. DESIGN.md 10.6: glyph + visually-hidden text. */
const BOOLEAN_CELLS: Record<string, { glyph: string; label: string }> = {
  yes: { glyph: "✓", label: "Yes" },
  true: { glyph: "✓", label: "Yes" },
  no: { glyph: "✕", label: "No" },
  false: { glyph: "✕", label: "No" },
};

const readBoolean = (cell: string) =>
  BOOLEAN_CELLS[cell.trim().toLowerCase()] ?? null;

const isOwn = (index: number): "true" | undefined =>
  index === block.ownColumnIndex ? "true" : undefined;
---

<section class="section section-light" aria-labelledby="ledger-table-title">
  <div class="shell">
    <header class="section-header" data-reveal>
      {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
      <h2 id="ledger-table-title">{block.title}</h2>
      {block.summary && <p class="lede">{block.summary}</p>}
    </header>

    <div
      class="table-scroll"
      data-reveal
      tabindex="0"
      role="region"
      aria-labelledby="ledger-table-title"
    >
      <table class="ledger-table">
        <thead>
          <tr>
            <th scope="col" class="spine">
              <span class="sr-only">Specification</span>
            </th>
            {block.columns.map((column, index) => (
              <th scope="col" data-own={isOwn(index)}>{column}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {block.rows.map((row) => (
            <tr>
              <th scope="row" class="spine">{row.label}</th>
              {row.cells.map((cell, index) => {
                const flag = readBoolean(cell);
                return (
                  <td class="tabular" data-own={isOwn(index)}>
                    {flag ? (
                      <span class="flag" data-state={flag.label.toLowerCase()}>
                        <span aria-hidden="true">{flag.glyph}</span>
                        <span class="sr-only">{flag.label}</span>
                      </span>
                    ) : (
                      cell
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="fine source" data-reveal>Source: {block.source}</p>
  </div>
</section>

<style>
  /* The table scrolls sideways, never the page body. tabindex keeps the
     overflow container keyboard-reachable (WCAG 2.2 scrollable region). */
  .table-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  .table-scroll:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  .ledger-table {
    min-width: 44rem;
  }
  /* Chrome hairline over the header row: a ledger, not a card. */
  .ledger-table thead th {
    border-top: 1px solid var(--line);
    white-space: nowrap;
  }
  .ledger-table tbody tr:last-child th,
  .ledger-table tbody tr:last-child td {
    border-bottom: 0;
  }

  /* Sticky first column — the row label stays readable while specs scroll. */
  .spine {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 11rem;
    background: var(--surface-card);
    box-shadow: 1px 0 0 var(--line);
  }

  .flag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    font-size: 1rem;
    line-height: 1;
  }
  .flag[data-state="yes"] {
    color: var(--heading);
  }
  .flag[data-state="no"] {
    color: var(--muted);
  }

  .source {
    margin-top: 1.25rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 60rem) {
    .ledger-table {
      min-width: 0;
    }
  }
</style>
