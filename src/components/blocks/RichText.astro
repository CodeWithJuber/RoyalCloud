---
import type { RichTextBlock } from "../../types/content";
import { sanitizeCmsHtml } from "./_sanitize";

interface Props { block: RichTextBlock }
const { block } = Astro.props;
const html = sanitizeCmsHtml(block.html);
---

<section class="section section-light" aria-labelledby={block.title ? "rich-text-title" : undefined}>
  <div class="shell rich-text__inner">
    {block.title && <h2 id="rich-text-title">{block.title}</h2>}
    <div class="prose" set:html={html} />
  </div>
</section>

<style>
  .rich-text__inner { max-width: 48rem; }
  h2 { margin: 0 0 1.5rem; }

  .prose { font-size: 1rem; line-height: 1.75; }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin: 2rem 0 0.75rem;
    color: var(--heading);
    font-weight: 800;
    line-height: 1.25;
  }
  .prose :global(h3) { font-size: 1.25rem; }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.125rem; }
  .prose :global(li) { margin-bottom: 0.375rem; }
  .prose :global(a) { color: var(--rc-primary); font-weight: 700; text-underline-offset: 0.2em; }
  .prose :global(strong) { color: var(--heading); }
  .prose :global(img) { height: auto; border-radius: var(--r-inner); }

  /* Wide tables scroll inside their own container so the page never does. */
  .prose :global(table) { display: block; overflow-x: auto; width: 100%; border-collapse: collapse; }
  .prose :global(th),
  .prose :global(td) { padding: 0.75rem; border: 1px solid var(--line); text-align: left; }
  .prose :global(th) { color: var(--heading); background: var(--rc-lavender); font-weight: 700; }
</style>
