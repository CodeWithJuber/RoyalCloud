---
/* Shield Stack (DESIGN.md 8.5, composition anchor 3) — full cobalt field: the
   concentric plates on one side, a numbered legend ledger on the other. The
   legend is numbered because the order is real — it is the traversal order from
   the public edge inward to the workload, matching the plates outside-in. */
import ShieldStack from "@/components/visuals/ShieldStack.astro";
import type { ShieldStackBlock } from "../../types/content";

interface Props {
  block: ShieldStackBlock;
}

const { block } = Astro.props;
const layers = block.layers ?? [];
const layerNames = layers.map((layer) => layer.name);
---

{
  layers.length > 0 && (
    <section class="section section-royal" aria-labelledby="shield-stack-title">
      <div class="shell shield-grid">
        <div class="shield-figure" data-reveal>
          <ShieldStack layers={layerNames} />
        </div>

        <div class="shield-copy">
          <header class="section-header shield-header" data-reveal>
            {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
            <h2 id="shield-stack-title">{block.title}</h2>
            <p class="lede">{block.summary}</p>
          </header>

          <ol class="layer-ledger" data-reveal>
            {layers.map((layer, index) => (
              <li class="layer">
                <span class="layer-index mono tabular" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="layer-body">
                  <span class="layer-name">{layer.name}</span>
                  <span class="layer-detail">{layer.detail}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}

<style>
  .shield-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* Asymmetric on purpose: the diagram is the denser, smaller object; the
     ledger carries the measure. Never a 50/50 split, never a 3-card grid (3). */
  @media (min-width: 60rem) {
    .shield-grid {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    }
  }

  .shield-figure {
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
  }

  .shield-header {
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .layer-ledger {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .layer {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .layer:last-child {
    border-bottom: 1px solid var(--line);
  }

  .layer-index {
    color: var(--muted);
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  .layer-body {
    display: grid;
    gap: 0.25rem;
  }

  .layer-name {
    color: var(--heading);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .layer-detail {
    max-width: 56ch;
    color: var(--body);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
