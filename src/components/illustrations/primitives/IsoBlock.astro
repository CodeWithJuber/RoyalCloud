---
/**
 * IsoBlock - the base isometric cube. EVERY iso structure (server towers,
 * datacenter halls, the hero cloud-city) stacks from this one primitive, which
 * locks the 30deg / 2:1 projection and the single upper-left light source:
 * top face lightest, left face mid, right face darkest. Using one block for
 * all iso art is what makes the set read as one world (and defeats the
 * inconsistent-lighting AI tell).
 *
 * Origin (x,y) = the TOP vertex of the top rhombus. Footprint half-width `w`,
 * block height `h`. Animatable wrapper class: `.rc-il__block`.
 */
import { shade } from '../_shade';

interface Props {
  x?: number;
  y?: number;
  w?: number;
  h?: number;
  tone?: string;
  class?: string;
}
const { x = 0, y = 0, w = 40, h = 28, tone = '#6a2cf0', class: className = '' } = Astro.props;

const topFill = tone;
const leftFill = shade(tone, 0.16);
const rightFill = shade(tone, 0.3);
const hw = w; // half-width
const hd = w / 2; // half-depth (2:1 iso)

// top rhombus: top -> right -> bottom -> left
const top = `M0 0 L${hw} ${hd} L0 ${w} L${-hw} ${hd} Z`;
// right face: right -> bottom -> bottom_down -> right_down
const right = `M${hw} ${hd} L0 ${w} L0 ${w + h} L${hw} ${hd + h} Z`;
// left face: left -> bottom -> bottom_down -> left_down
const left = `M${-hw} ${hd} L0 ${w} L0 ${w + h} L${-hw} ${hd + h} Z`;
---

<g transform={`translate(${x} ${y})`} class:list={['rc-il__block', className]}>
  <path d={left} fill={leftFill}></path>
  <path d={right} fill={rightFill}></path>
  <path d={top} fill={topFill}></path>
</g>
