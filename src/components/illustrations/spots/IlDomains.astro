---
/**
 * IlDomains - domain names: a globe threaded by a spectrum meridian with a URL
 * pill (search and claim your name worldwide). Meridians use currentColor so
 * the per-page theme accent flows in.
 */
import Star from '../primitives/Star.astro';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class:list={['rc-spot', className]} viewBox="0 0 240 240" fill="none" aria-hidden="true" style="color: var(--theme-accent, #5a1ee6)">
  <!-- globe -->
  <circle cx="104" cy="104" r="60" fill="var(--pastel-sky)" stroke="rgba(10,14,31,0.1)" stroke-width="2"></circle>
  <g stroke="currentColor" fill="none" stroke-width="2" opacity="0.55">
    <line x1="44" y1="104" x2="164" y2="104"></line>
    <ellipse cx="104" cy="104" rx="26" ry="60"></ellipse>
    <ellipse cx="104" cy="104" rx="58" ry="26"></ellipse>
  </g>
  <!-- spectrum meridian -->
  <ellipse cx="104" cy="104" rx="50" ry="60" fill="none" stroke="url(#rcgSpec)" stroke-width="4" stroke-linecap="round" stroke-dasharray="120 240" transform="rotate(18 104 104)"></ellipse>
  <!-- url pill -->
  <g>
    <rect x="58" y="182" width="148" height="30" rx="15" fill="#ffffff" stroke="rgba(10,14,31,0.14)" stroke-width="2"></rect>
    <circle cx="76" cy="197" r="6" fill="none" stroke="#5a1ee6" stroke-width="2.5"></circle>
    <rect x="90" y="194" width="62" height="6" rx="3" fill="rgba(10,14,31,0.2)"></rect>
    <rect x="160" y="190" width="36" height="14" rx="7" fill="url(#rcgCta)"></rect>
  </g>
  <Star x={186} y={56} size={8} tone="gold" />
</svg>

<style>
  .rc-spot {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
