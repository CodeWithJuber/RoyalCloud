---
/**
 * IlReseller - reseller hosting: one cloud branching into several white-label
 * site tiles (grow your own hosting business). Cloud + dashed branches + tiles.
 */
import Cloud from '../primitives/Cloud.astro';
import Star from '../primitives/Star.astro';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const tiles = [36, 100, 164];
---

<svg class:list={['rc-spot', className]} viewBox="0 0 240 240" fill="none" aria-hidden="true">
  <!-- branches -->
  <g stroke="rgba(90,30,230,0.36)" stroke-width="2.5" stroke-dasharray="5 6" stroke-linecap="round">
    <line x1="140" y1="92" x2="61" y2="150"></line>
    <line x1="140" y1="92" x2="125" y2="150"></line>
    <line x1="140" y1="92" x2="189" y2="150"></line>
  </g>
  <Cloud x={70} y={40} scale={1} tone="lavender" />
  <!-- white-label site tiles -->
  {tiles.map((tx) => (
    <g>
      <rect x={tx} y={150} width="50" height="46" rx="10" fill="#ffffff" stroke="rgba(10,14,31,0.14)" stroke-width="2"></rect>
      <rect x={tx + 12} y={162} width="26" height="4.5" rx="2.25" fill="url(#rcgEnergy)"></rect>
      <rect x={tx + 12} y={172} width="20" height="4" rx="2" fill="rgba(10,14,31,0.18)"></rect>
      <rect x={tx + 12} y={181} width="24" height="4" rx="2" fill="rgba(10,14,31,0.12)"></rect>
    </g>
  ))}
  <Star x={196} y={64} size={8} tone="gold" />
</svg>

<style>
  .rc-spot {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
