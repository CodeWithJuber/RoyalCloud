---
/**
 * IlWordpress - managed WordPress: a stylized W on a speed disc, with a
 * spectrum sweep and a spark. The W is brand-drawn (not the WP logo) so it
 * stays inside the illustration language.
 */
import SpectrumArc from '../primitives/SpectrumArc.astro';
import Star from '../primitives/Star.astro';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class:list={['rc-spot', className]} viewBox="0 0 240 240" fill="none" aria-hidden="true">
  <!-- speed disc -->
  <circle cx="116" cy="120" r="66" fill="var(--pastel-sky)" stroke="rgba(24,27,34,0.1)" stroke-width="2"></circle>
  <circle cx="116" cy="120" r="66" fill="none" stroke="url(#rcgEnergy)" stroke-width="4" stroke-linecap="round" stroke-dasharray="150 320" transform="rotate(-40 116 120)"></circle>
  <!-- W mark -->
  <path
    d="M84 92 L100 152 L116 110 L132 152 L148 92"
    fill="none"
    stroke="#5a1ee6"
    stroke-width="9"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <SpectrumArc x={40} y={40} w={170} thickness={4} grad="spectrum" />
  <Star x={196} y={70} size={8} tone="gold" />
</svg>

<style>
  .rc-spot {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
