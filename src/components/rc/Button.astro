---
import { Icon } from "astro-icon/components";

/**
 * Royal Clouds — Button (design system §10.3)
 *  primary   → signal pill, 52px, night text, nested arrow island
 *  secondary → text + 2px chrome underline track, fills to interactive on hover
 *  console   → 44px midnight pill, chrome hairline, JetBrains Mono label
 * Signal orange is the ONLY conversion color — never use primary for a
 * non-conversion action. No red/destructive button on marketing routes.
 */
interface Props {
  variant?: "primary" | "secondary" | "console";
  size?: "md" | "sm";
  href?: string;
  arrow?: boolean;
  icon?: string; // tabler icon name, e.g. "tabler:terminal-2"
  block?: boolean;
  external?: boolean;
  class?: string;
}
const {
  variant = "primary",
  size = "md",
  href,
  arrow,
  icon,
  block = false,
  external = false,
  class: extra = "",
  ...rest
} = Astro.props;

// Primary shows the nested arrow island by default; opt out with arrow={false}.
const showArrow = variant === "primary" ? arrow !== false : Boolean(arrow);
const cls = [
  "rc-btn",
  `rc-btn--${variant}`,
  size === "sm" ? "rc-btn--sm" : "",
  block ? "rc-btn--block" : "",
  variant === "primary" && !showArrow ? "rc-btn--noarrow" : "",
  extra,
]
  .filter(Boolean)
  .join(" ");
const Tag = href ? "a" : "button";
const relAttr = external ? "noopener noreferrer" : undefined;
const targetAttr = external ? "_blank" : undefined;
---

<Tag
  class={cls}
  href={href}
  type={href ? undefined : "button"}
  rel={relAttr}
  target={targetAttr}
  {...rest}
>
  {icon && variant !== "primary" && <Icon name={icon} size={variant === "console" ? 16 : 18} />}
  <span><slot /></span>
  {showArrow && variant === "primary" && (
    <span class="rc-btn__island" aria-hidden="true"><Icon name="tabler:arrow-right" size={18} /></span>
  )}
  {showArrow && variant !== "primary" && <Icon name="tabler:arrow-right" size={16} />}
</Tag>
