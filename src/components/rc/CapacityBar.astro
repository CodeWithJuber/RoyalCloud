---
/** Royal Clouds — CapacityBar. Fills via scaleX on reveal (transform-only).
 * `value` 0–100; `display` is the mono readout on the right. */
interface Props {
  label: string;
  value: number;
  display: string;
}
const { label, value, display } = Astro.props;
const v = Math.max(0, Math.min(100, value)) / 100;
---

<div class="rc-cap reveal">
  <div class="rc-cap__head">
    <span class="rc-cap__label">{label}</span>
    <span class="rc-cap__val">{display}</span>
  </div>
  <div class="rc-cap__track">
    <div class="rc-cap__fill" style={`--_v:${v}`}></div>
  </div>
</div>
