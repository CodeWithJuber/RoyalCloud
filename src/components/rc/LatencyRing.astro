---
/** Royal Clouds — LatencyRing. A dial that settles to `value` on reveal
 * (stroke-dashoffset transition). Numeric readout centered, label beneath. */
interface Props {
  value: number;
  unit?: string;
  label: string;
  max?: number;
  size?: number;
}
const { value, unit = "ms", label, max = 200, size = 128 } = Astro.props;
const stroke = 9;
const r = (size - stroke) / 2;
const c = 2 * Math.PI * r;
const frac = Math.max(0, Math.min(1, value / max));
const off = c * (1 - frac);
const cx = size / 2;
---

<div class="rc-ring reveal" style={`--_c:${c.toFixed(2)};--_off:${off.toFixed(2)}`}>
  <svg class="rc-ring__svg" width={size} height={size} viewBox={`0 0 ${size} ${size}`} aria-hidden="true">
    <circle class="rc-ring__track" cx={cx} cy={cx} r={r} stroke-width={stroke} />
    <circle class="rc-ring__arc" cx={cx} cy={cx} r={r} stroke-width={stroke} />
    <text class="rc-ring__num" x={cx} y={cx - 2} text-anchor="middle" dominant-baseline="middle" style="font-size:26px">{value}</text>
    <text class="rc-ring__unit" x={cx} y={cx + 20} text-anchor="middle" style="font-size:12px">{unit}</text>
  </svg>
  <span class="rc-ring__label">{label}</span>
</div>
