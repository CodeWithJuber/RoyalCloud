---
/** Royal Clouds — TelemetryRibbon. A row of live-feeling fleet readouts.
 * Numbers must be real or the component is absent (design system content law). */
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<div class="rc-ribbon">
  {stats.map((s) => (
    <div class="rc-ribbon__cell">
      <span class="rc-ribbon__val rc-tabular">{s.value}</span>
      <span class="rc-ribbon__label">{s.label}</span>
    </div>
  ))}
</div>
