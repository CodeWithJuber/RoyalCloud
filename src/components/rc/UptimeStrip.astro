---
/** Royal Clouds — UptimeStrip. A daily-uptime tick row with a sourced figure.
 * `ticks` optionally marks degraded days: index → "warn" | "down". */
interface Props {
  uptime: string;
  period: string;
  href?: string;
  days?: number;
  incidents?: Record<number, "warn" | "down">;
}
const { uptime, period, href, days = 60, incidents = {} } = Astro.props;
const list = Array.from({ length: days }, (_, i) => incidents[i] ?? "ok");
---

<div class="rc-uptime">
  <div class="rc-uptime__head">
    <span class="rc-uptime__val rc-tabular">{uptime}</span>
    <span class="rc-uptime__period">{period}</span>
  </div>
  <div class="rc-uptime__ticks" aria-hidden="true">
    {list.map((s) => <span class="rc-uptime__tick" data-state={s === "ok" ? undefined : s}></span>)}
  </div>
  <div class="rc-uptime__foot">
    Trailing {days}-day uptime{href && <> · <a href={href}>status page</a></>}
  </div>
</div>
