---
import separatorSvg from "~/assets/images/live/separator-rc.svg";

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  note?: string;
  items: {
    label: string;
    value: number;
    display: string;
    highlight?: boolean;
  }[];
}
const { eyebrow, title, subtitle, note, items } = Astro.props;
const max = Math.max(...items.map((i) => i.value));
---

<section class="rc-benchmark">
  <div class="wrap">
    {(eyebrow || title) && (
      <div class="section-title">
        {eyebrow && <span class="bench-eyebrow">{eyebrow}</span>}
        {title && <h2 set:html={title} />}
        <img src={separatorSvg.src} alt="" class="separator-rc" width="250" height="30" />
        {subtitle && <p set:html={subtitle} />}
      </div>
    )}
    <div class="bench-panel">
      {items.map((row) => (
        <div class={`bench-row ${row.highlight ? "bench-hl" : ""}`}>
          <span class="bench-label">{row.label}</span>
          <span class="bench-track">
            <i style={`--w: ${Math.max((row.value / max) * 100, 6)}%`} />
          </span>
          <b class="bench-val">{row.display}</b>
        </div>
      ))}
      {note && <p class="bench-note">{note}</p>}
    </div>
  </div>
</section>

<style>
  .rc-benchmark {
    padding: 100px 0;
  }

  .bench-eyebrow {
    display: block;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-hot);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .bench-panel {
    max-width: 800px;
    margin: 0 auto;
    background: #fff;
    border-radius: 15px;
    box-shadow: 0 5px 30px rgba(0,0,0,0.08);
    padding: 40px;
  }

  .bench-row {
    display: grid;
    grid-template-columns: 140px 1fr 80px;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
  }
  .bench-row + .bench-row {
    border-top: 1px solid #eee;
  }

  .bench-label {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--body-color);
  }
  .bench-hl .bench-label {
    color: var(--heading-blue);
  }

  .bench-track {
    position: relative;
    display: block;
    height: 20px;
    border-radius: 10px;
    background: #f0f0f0;
    overflow: hidden;
  }
  .bench-track i {
    position: absolute;
    inset: 0;
    width: var(--w);
    border-radius: 10px;
    background: #ccc;
    transition: transform 1s ease;
  }
  .bench-hl .bench-track i {
    background: linear-gradient(90deg, var(--heading-blue), var(--royal-purple));
  }

  .bench-val {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--body-color);
    text-align: right;
  }
  .bench-hl .bench-val {
    color: var(--heading-blue);
    font-size: 20px;
  }

  .bench-note {
    margin: 20px 0 0;
    font-size: 13px;
    color: #999;
    text-align: center;
  }

  @media (max-width: 640px) {
    .bench-panel { padding: 25px; }
    .bench-row {
      grid-template-columns: 1fr 70px;
      grid-template-areas: "label label" "track val";
      gap: 8px 12px;
    }
    .bench-label { grid-area: label; }
    .bench-track { grid-area: track; }
    .bench-val { grid-area: val; }
  }
</style>
