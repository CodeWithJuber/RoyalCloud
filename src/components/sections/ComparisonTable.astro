---
import { getEntry } from "astro:content";

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  plan?: string;
  note?: string;
}
const { eyebrow, title, subtitle, plan: planId, note } = Astro.props;

const entry = planId ? await getEntry("plans", planId) : undefined;
if (planId && !entry)
  throw new Error(`ComparisonTable: unknown plan "${planId}"`);
const tiers = entry?.data.tiers ?? [];

// Build rows from tier feature lists: position N in each list is one row.
// Row label = first tier's feature with its quantity stripped ("10 GB SSD
// Storage" → "SSD Storage").
const rowCount = Math.max(0, ...tiers.map((t) => t.features.length));
const label = (text: string) =>
  text.replace(/^(unlimited|free|\d+[\w.]*)\s+(gb\s+|tb\s+)?/i, "") || text;
const rows = Array.from({ length: rowCount }, (_, i) => ({
  label: label(tiers[0]?.features[i] ?? `Feature ${i + 1}`),
  cells: tiers.map((t) => t.features[i] ?? "—"),
}));
---

<section class="cv-auto">
  <div class="wrap">
    {
      (eyebrow || title) && (
        <div class="sec-head center reveal">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          {title && <h2 set:html={title} />}
          {subtitle && <p set:html={subtitle} />}
        </div>
      )
    }
    <div class="compare-wrap reveal">
      <table class="compare">
        <thead>
          <tr>
            <th>Plan</th>
            {
              tiers.map((t) => (
                <th class={t.popular ? "popular" : ""}>{t.name}</th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          <tr>
            <th>Price</th>
            {
              tiers.map((t) => (
                <td class={t.popular ? "popular" : ""}>
                  <span class="price">${t.price}/mo</span>
                </td>
              ))
            }
          </tr>
          {
            rows.map((row) => (
              <tr>
                <th>{row.label}</th>
                {row.cells.map((c, j) => (
                  <td class={tiers[j]?.popular ? "popular" : ""}>{c}</td>
                ))}
              </tr>
            ))
          }
          <tr>
            <th></th>
            {
              tiers.map((t) => (
                <td class={t.popular ? "popular" : ""}>
                  <a
                    class={`btn ${t.popular ? "btn-primary" : "btn-ghost-dark"}`}
                    href={t.ctaUrl}
                    target="_blank"
                    rel="noopener"
                  >
                    {t.cta ?? "Get Started"}
                  </a>
                </td>
              ))
            }
          </tr>
        </tbody>
      </table>
    </div>
    {note && <p class="pricing-note">{note}</p>}
  </div>
</section>
