---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { marked } from "marked";
import { tablerIcon } from "~/utils/plans";
import { resolveSectionImage } from "~/utils/sectionImages";
import SectionArt from "./SectionArt.astro";

// Bundled photo keywords now render hand-built brand illustrations
// instead of the old stock photos. "terminal" accepts a distro flavor
// suffix (terminal:ubuntu) handled inside SectionArt.
const ART_KINDS = [
  "datacenter",
  "support",
  "working",
  "hero",
  "terminal",
  "rocket",
  "panel",
  "shield",
] as const;
const artKind = (ref?: string): string | undefined =>
  ART_KINDS.includes(ref?.split(":")[0] as (typeof ART_KINDS)[number])
    ? ref
    : undefined;

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  image?: string;
  reverse?: boolean;
  /** "chips" = horizontal mini-stat chips; "list" (default) = vertical icon rows.
      Lets two adjacent splits read as different layout families. */
  layout?: "chips" | "list";
  body?: string;
  items?: { icon?: string; title?: string; text?: string }[];
}
const {
  eyebrow,
  title,
  subtitle,
  image,
  reverse = false,
  layout = "list",
  body,
  items,
} = Astro.props;
const art = artKind(image);
const img = art ? undefined : resolveSectionImage(image);
const html = body ? await marked.parse(body) : undefined;
---

<section class="cv-auto">
  <div class={`wrap split ${reverse ? "rev" : ""}`}>
    {
      art && (
        <div
          class={`split-media illus reveal ${reverse ? "rv-right" : "rv-left"}`}
        >
          <SectionArt kind={art} />
        </div>
      )
    }
    {
      img && (
        <div class={`split-media reveal ${reverse ? "rv-right" : "rv-left"}`}>
          {typeof img === "string" ? (
            <img src={img} alt={title ?? ""} loading="lazy" decoding="async" />
          ) : (
            <Image
              src={img}
              alt={title ?? ""}
              widths={[480, 760]}
              sizes="(max-width: 860px) 100vw, 560px"
              loading="lazy"
            />
          )}
        </div>
      )
    }
    <div
      class={`split-body reveal reveal-d1 ${reverse ? "rv-left" : "rv-right"}`}
    >
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {title && <h2 set:html={title} />}
      {subtitle && <p set:html={subtitle} />}
      {html && <div class="split-prose" set:html={html} />}
      {
        items && items.length > 0 && layout === "chips" && (
          <div class="point-chips">
            {items.map((p) => (
              <div class="chip">
                <span class="chip-ic f-icon-grad">
                  <Icon name={tablerIcon(p.icon ?? "bolt")} />
                </span>
                <span class="chip-tx">
                  <strong>{p.title}</strong>
                  <small>{p.text}</small>
                </span>
              </div>
            ))}
          </div>
        )
      }
      {
        items && items.length > 0 && layout !== "chips" && (
          <div class="point-list">
            {items.map((p) => (
              <div class="point">
                <div class="p-ic f-icon-grad">
                  <Icon name={tablerIcon(p.icon ?? "bolt")} />
                </div>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .split-prose {
    font-size: 16px;
    color: var(--text-default);
  }
  .split-prose :global(p) {
    margin-bottom: 14px;
  }
  .split-prose :global(ul) {
    margin: 0 0 14px 20px;
  }
  .split-prose :global(li) {
    margin-bottom: 7px;
  }
  .split-prose :global(strong) {
    color: var(--text-heading);
  }
  .split-prose :global(a) {
    color: var(--rc-purple);
    font-weight: 500;
  }

  /* chips layout: horizontal mini-stat row (distinct from the vertical list) */
  .point-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .chip {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1 1 200px;
    background: var(--bg-tint);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 16px;
    transition:
      transform 0.18s var(--ease-out),
      box-shadow 0.18s ease;
  }
  .chip:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
  }
  .chip-ic {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    display: grid;
    place-items: center;
  }
  .chip-ic :global(svg) {
    width: 21px;
    height: 21px;
  }
  .chip-tx {
    min-width: 0;
  }
  .chip-tx strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text-heading);
    line-height: 1.25;
  }
  .chip-tx small {
    display: block;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--text-muted);
    margin-top: 2px;
  }
  @media (max-width: 560px) {
    .chip {
      flex: 1 1 100%;
    }
  }
</style>
