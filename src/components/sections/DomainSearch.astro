---
import site from "~/data/site.json";
import { toINR } from "~/utils/currency";

const tlds = [
  { tld: ".com", usd: "9.99" },
  { tld: ".net", usd: "11.49" },
  { tld: ".org", usd: "10.99" },
  { tld: ".in", usd: "7.99" },
];

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}
const {
  eyebrow,
  title = "Find your perfect domain name",
  subtitle,
} = Astro.props;

// WHMCS domain checker: GET cart.php with the search term in `query`.
const action = new URL(site.portal.domainChecker);
const hidden = [...action.searchParams.entries()];
const formAction = `${action.origin}${action.pathname}`;
---

<section class="domain-sec cv-auto">
  <div class="wrap">
    <div class="domain-panel reveal">
      <div class="sec-head center">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {title && <h2 set:html={title} />}
        {subtitle && <p set:html={subtitle} />}
      </div>
      <form
        class="domain-search"
        method="get"
        action={formAction}
        target="_blank"
        novalidate
      >
        {
          hidden.map(([name, value]) => (
            <input type="hidden" name={name} value={value} />
          ))
        }
        <span class="at">@</span>
        <input
          type="text"
          name="query"
          placeholder="Type the domain you want…"
          aria-label="Domain name"
          aria-describedby="domain-status"
          autocomplete="off"
          required
        />
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
      <div
        class="domain-suggest"
        id="domainSuggest"
        role="listbox"
        aria-label="Domain suggestions"
      >
      </div>
      <p id="domain-status" class="domain-status" role="status" aria-live="polite"></p>
      <div class="domain-tlds">
        {
          tlds.map((t) => (
            <span>
              <b>{t.tld}</b>{" "}
              <em
                class="px"
                data-usd={`$${t.usd}`}
                data-inr={`₹${toINR(t.usd)}`}
              >
                ₹{toINR(t.usd)}
              </em>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .domain-status {
    margin: 12px auto 0;
    min-height: 1.2em;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    color: rgba(255, 255, 255, 0.92);
  }
  .domain-status.is-error {
    color: var(--rc-yellow);
  }
</style>

<script>
  // Forgiving domain input (Postel's Law): strip protocol/www/spaces so a
  // pasted URL still works; give instant feedback (Doherty) before handing
  // off to the WHMCS checker.
  function initDomainSearch() {
    document.querySelectorAll<HTMLFormElement>('form.domain-search').forEach((form) => {
      if (form.dataset.rcReady) return;
      form.dataset.rcReady = 'true';
      const input = form.querySelector<HTMLInputElement>('input[name=query]');
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      const status = form.parentElement?.querySelector<HTMLElement>('#domain-status') ?? null;
      const suggest = form.parentElement?.querySelector<HTMLElement>('#domainSuggest') ?? null;
      if (!input) return;

      // Live suggestions (autocomplete affordance): as the visitor types a
      // name, surface the popular TLDs as one-tap chips.
      const TLDS = ['.com', '.in', '.net', '.org'];
      const renderSuggest = () => {
        if (!suggest) return;
        const base = input.value
          .trim()
          .toLowerCase()
          .replace(/^https?:\/\//, '')
          .replace(/^www\./, '')
          .replace(/[^a-z0-9-].*$/, '');
        if (base.length < 2) {
          suggest.classList.remove('is-on');
          suggest.innerHTML = '';
          return;
        }
        suggest.innerHTML = '';
        TLDS.forEach((tld) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('role', 'option');
          b.textContent = base + tld;
          b.addEventListener('click', () => {
            input.value = base + tld;
            suggest.classList.remove('is-on');
            form.requestSubmit();
          });
          suggest.appendChild(b);
        });
        suggest.classList.add('is-on');
      };
      input.addEventListener('input', renderSuggest);

      const setStatus = (msg: string, error = false) => {
        if (!status) return;
        status.textContent = msg;
        status.classList.toggle('is-error', error);
      };

      form.addEventListener('submit', (e) => {
        const cleaned = input.value
          .trim()
          .toLowerCase()
          .replace(/^https?:\/\//, '')
          .replace(/^www\./, '')
          .replace(/\/.*$/, '')
          .replace(/\s+/g, '');
        input.value = cleaned;

        if (!cleaned) {
          e.preventDefault();
          input.focus();
          setStatus('Please enter a domain name to search.', true);
          return;
        }
        if (!/^[a-z0-9-]+(\.[a-z0-9-]+)*$/.test(cleaned)) {
          e.preventDefault();
          input.focus();
          setStatus('That doesn’t look like a valid domain. Try something like myname.com', true);
          return;
        }

        setStatus(`Checking availability for “${cleaned}”… opening results.`);
        if (btn) {
          btn.classList.add('is-loading');
          btn.disabled = true;
          // Results open in a new tab, restore the button so the page stays usable.
          window.setTimeout(() => {
            btn.classList.remove('is-loading');
            btn.disabled = false;
          }, 2500);
        }
      });
    });
  }
  initDomainSearch();
  document.addEventListener('astro:after-swap', initDomainSearch);
</script>
