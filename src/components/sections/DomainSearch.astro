---
import site from "~/data/site.json";
import { toINR } from "~/utils/currency";

const tlds = [
  { tld: ".com", usd: "9.99" },
  { tld: ".net", usd: "11.49" },
  { tld: ".org", usd: "10.99" },
  { tld: ".in", usd: "7.99" },
];

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}
const {
  eyebrow = "Domains",
  title = "Find your perfect domain name",
  subtitle,
} = Astro.props;

// WHMCS domain checker: GET cart.php with the search term in `query`.
const action = new URL(site.portal.domainChecker);
const hidden = [...action.searchParams.entries()];
const formAction = `${action.origin}${action.pathname}`;
---

<section class="domain-sec cv-auto">
  <div class="wrap">
    <div class="domain-panel reveal">
      <div class="sec-head center">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {title && <h2 set:html={title} />}
        {subtitle && <p set:html={subtitle} />}
      </div>
      <form
        class="domain-search"
        method="get"
        action={formAction}
        target="_blank"
      >
        {
          hidden.map(([name, value]) => (
            <input type="hidden" name={name} value={value} />
          ))
        }
        <span class="at">@</span>
        <input
          type="text"
          name="query"
          placeholder="Type the domain you want…"
          aria-label="Domain name"
          required
        />
        <button class="btn btn-coral" type="submit">Search</button>
      </form>
      <div class="domain-tlds">
        {
          tlds.map((t) => (
            <span>
              <b>{t.tld}</b>{" "}
              <em
                class="px"
                data-usd={`$${t.usd}`}
                data-inr={`₹${toINR(t.usd)}`}
              >
                ₹{toINR(t.usd)}
              </em>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
