---
import { Icon } from "astro-icon/components";
import { tablerIcon } from "~/utils/plans";
import { pricify } from "~/utils/currency";

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  columns?: number;
  /** "tiles" renders SiteGround-style pastel service cards. */
  variant?: "cards" | "tiles";
  items: {
    icon?: string;
    title?: string;
    text?: string;
    href?: string;
  }[];
}
const {
  eyebrow,
  title,
  subtitle,
  columns = 3,
  variant = "cards",
  items,
} = Astro.props;
---

<section class="features cv-auto">
  <div class="wrap">
    {
      (eyebrow || title) && (
        <div class="sec-head center reveal">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          {title && <h2 set:html={title} />}
          {subtitle && <p set:html={subtitle} />}
        </div>
      )
    }
    <div
      class={`feature-grid${variant === "tiles" ? " tiles" : ""}`}
      style={`grid-template-columns: repeat(${Math.min(columns, 4)}, 1fr);`}
    >
      {
        items.map((item, i) => (
          <div class={`card feature-card reveal reveal-d${(i % 3) + 1}`}>
            <div class="f-icon f-icon-grad">
              <Icon name={tablerIcon(item.icon ?? "bolt")} />
            </div>
            <h3>
              {item.href ? <a href={item.href}>{item.title}</a> : item.title}
            </h3>
            <p set:html={pricify(item.text ?? "")} />
            {item.href && (
              <a class="f-more" href={item.href} aria-label={`Explore ${item.title}`}>
                Explore {item.title}
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feature-card h3 a:hover {
    color: var(--rc-violet);
  }
  @media (max-width: 1080px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 560px) {
    .feature-grid:not(.tiles) {
      grid-template-columns: 1fr !important;
    }
  }
</style>
