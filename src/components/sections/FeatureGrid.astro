---
import { Icon } from "astro-icon/components";
import { tablerIcon } from "~/utils/plans";
import { pricify } from "~/utils/currency";
import separatorSvg from "~/assets/images/live/separator-rc.svg";

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  columns?: number;
  variant?: "cards" | "tiles";
  items: {
    icon?: string;
    title?: string;
    text?: string;
    href?: string;
  }[];
}
const {
  eyebrow,
  title,
  subtitle,
  columns = 3,
  variant = "cards",
  items,
} = Astro.props;

const colCount = Math.min(columns, 4);
---

<section class="rc-features">
  <div class="wrap">
    {(eyebrow || title) && (
      <div class="section-title">
        {eyebrow && <span class="rc-eyebrow">{eyebrow}</span>}
        {title && <h2 set:html={title} />}
        <img src={separatorSvg.src} alt="" class="separator-rc" width="250" height="30" />
        {subtitle && <p set:html={subtitle} />}
      </div>
    )}
    <div
      class="rc-feature-grid"
      style={`grid-template-columns: repeat(${colCount}, 1fr);`}
    >
      {items.map((item) => (
        <div class="rc-feature-card">
          {item.icon && (
            <div class="rc-feature-icon">
              <Icon name={tablerIcon(item.icon)} />
            </div>
          )}
          <h3>
            {item.href ? (
              <a href={item.href}>{item.title}</a>
            ) : (
              item.title
            )}
          </h3>
          {item.text && <p set:html={pricify(item.text)} />}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rc-features {
    padding: var(--space-section) 0;
  }

  .rc-eyebrow {
    display: block;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--rc-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .rc-feature-grid {
    display: grid;
    gap: 30px;
  }

  .rc-feature-card {
    text-align: center;
    padding: 30px 20px;
  }

  .rc-feature-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(38,159,216,0.1), rgba(123,31,162,0.1));
    color: var(--rc-primary);
  }
  .rc-feature-icon svg {
    width: 32px;
    height: 32px;
  }

  .rc-feature-card h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--rc-primary);
    margin: 0 0 12px;
  }
  .rc-feature-card h3 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .rc-feature-card h3 a:hover {
    color: var(--rc-primary);
  }

  .rc-feature-card p {
    font-size: 14px;
    color: var(--rc-body);
    line-height: 1.8;
    margin: 0;
  }

  @media (max-width: 991px) {
    .rc-feature-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 560px) {
    .rc-feature-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
