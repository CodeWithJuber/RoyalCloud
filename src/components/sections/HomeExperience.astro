---
import { Image } from "astro:assets";
import datacenter from "~/assets/images/photos/datacenter.jpg";

const products = [
  {
    className: "offer-card offer-card--wide offer-card--ink",
    eyebrow: "Start here",
    title: "Shared hosting that does not feel shared.",
    text: "SSD RAID-10, LiteSpeed, free SSL and daily backups for portfolios, stores and growing business sites.",
    price: "From $1.59/mo",
    href: "/shared-hosting",
    visual: "speed",
  },
  {
    className: "offer-card offer-card--gold",
    eyebrow: "WordPress",
    title: "Managed where it matters.",
    text: "Updates, caching and migration handled for you.",
    price: "View plans",
    href: "/managed-wordpress-hosting",
    visual: "wordpress",
  },
  {
    className: "offer-card offer-card--slate",
    eyebrow: "KVM VPS",
    title: "Root access. Real resources.",
    text: "Dedicated CPU and RAM with instant Linux deployment.",
    price: "Configure VPS",
    href: "/kvm-vps-hosting",
    visual: "terminal",
  },
  {
    className: "offer-card offer-card--paper",
    eyebrow: "Dedicated",
    title: "The whole machine is yours.",
    text: "Bare-metal control for heavy workloads and custom stacks.",
    price: "See servers",
    href: "/dedicated-servers",
    visual: "rack",
  },
  {
    className: "offer-card offer-card--paper",
    eyebrow: "Reseller",
    title: "Your brand on our infrastructure.",
    text: "White-label cPanel hosting with room to grow your client base.",
    price: "Build your business",
    href: "/reseller-hosting",
    visual: "reseller",
  },
];
---

<section class="home-products" id="hosting" aria-labelledby="hosting-title">
  <div class="wrap">
    <div class="home-intro reveal">
      <h2 id="hosting-title">One platform. Every way to grow online.</h2>
      <p>
        Start small, move up when traffic arrives, and keep the same support team
        through every stage.
      </p>
    </div>

    <div class="offer-grid">
      {
        products.map((product) => (
          <a class={product.className} href={product.href}>
            <span class="offer-copy">
              <span class="offer-eyebrow">{product.eyebrow}</span>
              <strong>{product.title}</strong>
              <span class="offer-text">{product.text}</span>
              <span class="offer-link">{product.price}</span>
            </span>
            <span class={`offer-visual offer-visual--${product.visual}`} aria-hidden="true">
              {product.visual === "speed" && (
                <span class="speed-console">
                  <span class="console-top"><i></i><i></i><i></i></span>
                  <span class="console-row"><b>royalclouds.net</b><em>0.4s</em></span>
                  <span class="console-line"><i></i></span>
                  <span class="console-row muted"><b>daily backup</b><em>ready</em></span>
                </span>
              )}
              {product.visual === "wordpress" && <span class="wp-mark">W</span>}
              {product.visual === "terminal" && (
                <span class="terminal-lines"><i></i><i></i><i></i><b>deploy complete</b></span>
              )}
              {product.visual === "rack" && (
                <span class="rack-stack"><i></i><i></i><i></i></span>
              )}
              {product.visual === "reseller" && (
                <span class="reseller-stack"><i></i><i></i><i></i></span>
              )}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="home-manifesto section--dark" aria-labelledby="manifesto-title">
  <div class="wrap manifesto-wrap">
    <h2 id="manifesto-title" data-word-reveal>
      <span data-word>Your</span>
      <span data-word>site</span>
      <span data-word>should</span>
      <span class="inline-server" data-word>
        <Image src={datacenter} alt="Cabled server racks" width={320} height={180} loading="lazy" />
      </span>
      <span data-word>feel</span>
      <span data-word>instant,</span>
      <span data-word>stay</span>
      <span data-word>online,</span>
      <span data-word>and</span>
      <span data-word>leave</span>
      <span data-word>you</span>
      <span data-word>free</span>
      <span data-word>to</span>
      <span data-word>build.</span>
    </h2>
    <p>
      Hosting should disappear into the background. We tune the servers, watch
      the network and answer when you need a human.
    </p>
  </div>
</section>

<section class="home-proof" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="home-intro proof-intro reveal">
      <h2 id="proof-title">Less dashboard theatre. More useful infrastructure.</h2>
      <p>
        The details that matter are visible, measurable and handled before they
        become your problem.
      </p>
    </div>

    <div class="proof-accordions" data-accordions>
      <article class="proof-panel is-active">
        <button type="button" aria-expanded="true">
          <span class="proof-title">Speed that survives traffic</span>
          <span class="proof-summary">LiteSpeed, SSD RAID-10 and edge caching</span>
        </button>
        <div class="proof-content">
          <p>
            Cached pages leave the server faster, while isolated resources keep
            one busy neighbour from slowing everyone else down.
          </p>
          <div class="proof-meter" aria-label="Example page load comparison">
            <span><b>Royal Clouds</b><i class="meter-fast"></i><em>0.4s</em></span>
            <span><b>Typical host</b><i class="meter-typical"></i><em>1.9s</em></span>
          </div>
        </div>
      </article>

      <article class="proof-panel">
        <button type="button" aria-expanded="false">
          <span class="proof-title">Backups you can actually use</span>
          <span class="proof-summary">Daily snapshots and one-click recovery</span>
        </button>
        <div class="proof-content">
          <p>
            Every restore point is timestamped and ready. Roll back a broken
            update without opening a ticket or waiting for an engineer.
          </p>
          <div class="backup-stack" aria-hidden="true">
            <span><b>Today, 04:00</b><em>ready</em></span>
            <span><b>Yesterday, 04:00</b><em>ready</em></span>
            <span><b>Jun 19, 04:00</b><em>ready</em></span>
          </div>
        </div>
      </article>

      <article class="proof-panel">
        <button type="button" aria-expanded="false">
          <span class="proof-title">Support that stays in the room</span>
          <span class="proof-summary">Real hosting specialists, around the clock</span>
        </button>
        <div class="proof-content">
          <p>
            No maze of bots and handoffs. The person who answers can inspect the
            server, explain the issue and help you fix it.
          </p>
          <div class="support-thread" aria-hidden="true">
            <span class="support-avatar">RC</span>
            <span><b>We found the slow query.</b><em>Checking the index now.</em></span>
            <i>resolved in 8 min</i>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  function initHomeAccordions() {
    document.querySelectorAll<HTMLElement>("[data-accordions]").forEach((root) => {
      const panels = Array.from(root.querySelectorAll<HTMLElement>(".proof-panel"));
      const activate = (activePanel: HTMLElement) => {
        panels.forEach((panel) => {
          const isActive = panel === activePanel;
          panel.classList.toggle("is-active", isActive);
          panel.querySelector("button")?.setAttribute("aria-expanded", String(isActive));
        });
      };

      panels.forEach((panel) => {
        panel.querySelector("button")?.addEventListener("click", () => activate(panel));
        panel.addEventListener("pointerenter", () => {
          if (window.matchMedia("(hover: hover) and (min-width: 861px)").matches) {
            activate(panel);
          }
        });
      });
    });
  }

  initHomeAccordions();
  document.addEventListener("astro:after-swap", initHomeAccordions);
</script>

<style>
  .home-products,
  .home-proof {
    padding-block: clamp(7rem, 12vw, 11rem);
  }
  .home-products {
    background: #f6f4ef;
  }
  .home-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.58fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .home-intro h2 {
    max-width: 52rem;
    margin: 0;
    font-size: clamp(2.7rem, 5.7vw, 5.7rem);
    font-weight: 620;
    letter-spacing: -0.058em;
    line-height: 0.96;
  }
  .home-intro p {
    max-width: 33rem;
    margin: 0 0 0.45rem;
    color: #5f625f;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
  }
  .offer-card {
    position: relative;
    display: grid;
    grid-column: span 4;
    min-height: 24rem;
    overflow: hidden;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid rgba(10, 13, 20, 0.1);
    border-radius: 1.15rem;
    background: #fff;
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      border-color 0.3s ease;
  }
  .offer-card--wide {
    grid-column: span 8;
    grid-template-columns: minmax(0, 0.9fr) minmax(19rem, 1.1fr);
    min-height: 28rem;
  }
  .offer-card:hover,
  .offer-card:focus-visible {
    transform: translateY(-0.5rem);
    border-color: rgba(10, 13, 20, 0.2);
    box-shadow: 0 2rem 5rem -3rem rgba(10, 13, 20, 0.38);
  }
  .offer-card:active {
    transform: translateY(-0.2rem) scale(0.99);
  }
  .offer-card--ink {
    border-color: transparent;
    color: #fff;
    background:
      radial-gradient(circle at 90% 0%, rgba(238, 190, 88, 0.18), transparent 34%),
      #0b0f18;
  }
  .offer-card--gold {
    background: #eec15d;
  }
  .offer-card--slate {
    color: #fff;
    background: #343d4c;
  }
  .offer-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .offer-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.58;
  }
  .offer-copy strong {
    max-width: 29rem;
    margin-top: 1.1rem;
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 3vw, 2.85rem);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  .offer-card:not(.offer-card--wide) .offer-copy strong {
    font-size: clamp(1.55rem, 2.2vw, 2.1rem);
  }
  .offer-text {
    max-width: 30rem;
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.58;
    opacity: 0.68;
  }
  .offer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 2.5rem;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 650;
  }
  .offer-link::after {
    content: "\2192";
    transition: transform 0.3s var(--ease-out);
  }
  .offer-card:hover .offer-link::after {
    transform: translateX(0.35rem);
  }
  .offer-visual {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: 10rem;
    transition: transform 0.7s var(--ease-out);
  }
  .offer-card:hover .offer-visual {
    transform: scale(1.05);
  }
  .speed-console {
    width: min(100%, 28rem);
    padding: 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 2.5rem 5rem -2rem rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(18px);
    transform: rotate(3deg);
  }
  .console-top {
    display: flex;
    gap: 0.35rem;
    padding-bottom: 1.8rem;
  }
  .console-top i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
  }
  .console-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }
  .console-row em {
    color: var(--rc-yellow);
    font-style: normal;
  }
  .console-row.muted {
    margin-top: 1.2rem;
    color: rgba(255, 255, 255, 0.44);
  }
  .console-line {
    display: block;
    height: 0.38rem;
    margin-top: 0.75rem;
    overflow: hidden;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.1);
  }
  .console-line i {
    display: block;
    width: 18%;
    height: 100%;
    border-radius: inherit;
    background: var(--rc-yellow);
  }
  .wp-mark {
    display: grid;
    place-items: center;
    width: 7rem;
    height: 7rem;
    border: 1px solid rgba(10, 13, 20, 0.2);
    border-radius: 50%;
    font-family: Georgia, serif;
    font-size: 3.8rem;
    color: #0b0f18;
  }
  .terminal-lines {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: 100%;
    padding: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.8rem;
    background: rgba(10, 13, 20, 0.3);
  }
  .terminal-lines i {
    width: 68%;
    height: 0.35rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.16);
  }
  .terminal-lines i:nth-child(2) {
    width: 42%;
  }
  .terminal-lines i:nth-child(3) {
    width: 82%;
  }
  .terminal-lines b {
    margin-top: 0.5rem;
    color: var(--rc-yellow);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
  }
  .rack-stack,
  .reseller-stack {
    position: relative;
    width: 8rem;
    height: 7rem;
  }
  .rack-stack i,
  .reseller-stack i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2rem;
    border: 1px solid rgba(10, 13, 20, 0.16);
    border-radius: 0.55rem;
    background: #f6f4ef;
    box-shadow: 0 1rem 2rem -1.3rem rgba(10, 13, 20, 0.4);
  }
  .rack-stack i:nth-child(2),
  .reseller-stack i:nth-child(2) {
    top: 2.25rem;
  }
  .rack-stack i:nth-child(3),
  .reseller-stack i:nth-child(3) {
    top: 4.5rem;
  }
  .rack-stack i::after {
    content: "";
    position: absolute;
    top: 0.65rem;
    right: 0.7rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #5b8c6a;
  }
  .reseller-stack i {
    left: 50%;
    width: 4.4rem;
    transform-origin: center;
  }
  .reseller-stack i:first-child {
    transform: translateX(-90%) rotate(-9deg);
  }
  .reseller-stack i:nth-child(2) {
    top: 1.2rem;
    transform: translateX(-50%);
  }
  .reseller-stack i:nth-child(3) {
    top: 2.4rem;
    transform: translateX(-10%) rotate(9deg);
  }
  .home-manifesto {
    padding-block: clamp(9rem, 17vw, 16rem);
    background: #0b0f18;
  }
  .manifesto-wrap {
    max-width: 82rem;
  }
  .home-manifesto h2 {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.08em 0.2em;
    margin: 0;
    color: #fff;
    font-size: clamp(3rem, 7vw, 7.4rem);
    font-weight: 560;
    letter-spacing: -0.06em;
    line-height: 0.98;
    text-align: center;
  }
  .inline-server {
    display: inline-flex;
    align-self: center;
    width: clamp(5rem, 10vw, 10rem);
    height: clamp(2.25rem, 4.8vw, 4.8rem);
    overflow: hidden;
    border-radius: 999px;
    transform: translateY(0.04em);
  }
  .inline-server :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2);
  }
  .home-manifesto p {
    max-width: 39rem;
    margin: 4rem auto 0;
    color: rgba(255, 255, 255, 0.54);
    font-size: 1.05rem;
    line-height: 1.75;
    text-align: center;
  }
  .home-proof {
    background: #fff;
  }
  .proof-intro {
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .proof-accordions {
    display: flex;
    min-height: 36rem;
    overflow: hidden;
    border: 1px solid rgba(10, 13, 20, 0.12);
    border-radius: 1.25rem;
    background: #ecebe6;
  }
  .proof-panel {
    position: relative;
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    padding: 2rem;
    color: #fff;
    background: #151a24;
    transition: flex 0.7s var(--ease-out), background 0.45s ease;
  }
  .proof-panel + .proof-panel {
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }
  .proof-panel:nth-child(2) {
    background: #303947;
  }
  .proof-panel:nth-child(3) {
    background: #ded1af;
    color: #0b0f18;
  }
  .proof-panel.is-active {
    flex: 2.7 1 0;
  }
  .proof-panel button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    min-height: 8rem;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }
  .proof-title {
    max-width: 15rem;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.4vw, 2.35rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .proof-summary {
    max-width: 15rem;
    margin-top: 0.8rem;
    font-size: 0.82rem;
    line-height: 1.45;
    opacity: 0.56;
  }
  .proof-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 24rem;
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.35s ease 0s,
      transform 0.45s var(--ease-out) 0s;
  }
  .proof-panel.is-active .proof-content {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.22s;
  }
  .proof-content > p {
    max-width: 31rem;
    color: currentColor;
    font-size: 1rem;
    line-height: 1.65;
    opacity: 0.68;
  }
  .proof-meter,
  .backup-stack,
  .support-thread {
    margin-top: 2rem;
    padding: 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.06);
  }
  .proof-meter span {
    display: grid;
    grid-template-columns: 7rem 1fr 3rem;
    gap: 0.8rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .proof-meter span + span {
    margin-top: 1.1rem;
  }
  .proof-meter i {
    position: relative;
    height: 0.38rem;
    overflow: hidden;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.1);
  }
  .proof-meter i::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 18%;
    border-radius: inherit;
    background: var(--rc-yellow);
  }
  .proof-meter .meter-typical::after {
    width: 72%;
  }
  .proof-meter em,
  .backup-stack em,
  .support-thread em {
    font-style: normal;
    opacity: 0.58;
  }
  .backup-stack {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .backup-stack span {
    display: flex;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border-radius: 0.55rem;
    background: rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.73rem;
  }
  .support-thread {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    border-color: rgba(10, 13, 20, 0.12);
    background: rgba(255, 255, 255, 0.42);
  }
  .support-avatar {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.55rem;
    background: #0b0f18;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .support-thread b,
  .support-thread em {
    display: block;
    font-size: 0.78rem;
  }
  .support-thread i {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-style: normal;
    opacity: 0.52;
  }
  @media (max-width: 960px) {
    .home-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .offer-card {
      grid-column: span 6;
    }
    .offer-card--wide {
      grid-column: span 12;
    }
    .offer-card:last-child {
      grid-column: span 12;
    }
  }
  @media (max-width: 860px) {
    .proof-accordions {
      flex-direction: column;
      min-height: 0;
    }
    .proof-panel,
    .proof-panel.is-active {
      flex: none;
      min-height: 11rem;
      transition: min-height 0.55s var(--ease-out);
    }
    .proof-panel.is-active {
      min-height: 30rem;
    }
    .proof-panel + .proof-panel {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      border-left: 0;
    }
  }
  @media (max-width: 640px) {
    .home-products,
    .home-proof {
      padding-block: 6.5rem;
    }
    .home-intro h2 {
      font-size: clamp(2.7rem, 12vw, 4rem);
    }
    .offer-grid {
      grid-template-columns: 1fr;
    }
    .offer-card,
    .offer-card--wide,
    .offer-card:last-child {
      grid-column: auto;
      grid-template-columns: 1fr;
      min-height: 25rem;
    }
    .offer-card--wide {
      min-height: 34rem;
