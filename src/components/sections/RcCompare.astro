---
import Button from "~/components/rc/Button.astro";
import { Icon } from "astro-icon/components";

interface Row { label: string; sub: string; rc: string; them: string; rcCheck?: boolean; themX?: boolean }
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  rows?: Row[];
  themLabel?: string;
}
const {
  eyebrow = "Migration",
  title = "Move your sites — we do the lifting.",
  lead = "Tell us where you're hosted now. We move the files, databases, and email, keep your old host live until the switch, and reply to every migration request within two hours.",
  themLabel = "Typical budget host",
  rows = [
    { label: "Storage", sub: "What your files sit on", rc: "NVMe SSD, RAID-10", them: "Shared HDD / SATA SSD", rcCheck: true },
    { label: "Renewal pricing", sub: "The price after the promo", rc: "Shown up front, always", them: "Hidden until checkout", rcCheck: true, themX: true },
    { label: "Backups", sub: "When something breaks", rc: "Daily off-site · 1-click restore", them: "Manual, often an add-on", rcCheck: true, themX: true },
    { label: "Uptime SLA", sub: "What you can hold us to", rc: "99.99%, credited", them: "Best effort", rcCheck: true },
    { label: "Support", sub: "Who answers, how fast", rc: "Engineers · ~2h first reply", them: "Tier-1 scripts · days", rcCheck: true },
    { label: "Migration", sub: "Moving your existing sites", rc: "Free — we move it for you", them: "DIY or paid", rcCheck: true, themX: true },
    { label: "Root & SSH", sub: "Control over your box", rc: "Full on VPS & Dedicated", them: "Restricted", rcCheck: true },
  ],
} = Astro.props;
---

<section class="rc-sect" id="migrate">
  <div class="rc-container">
    <div class="rc-sect__head reveal">
      <span class="rc-eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p class="rc-sect__lead">{lead}</p>
    </div>
    <div class="rc-cmp reveal">
      <div class="rc-cmp__row rc-cmp__row--head">
        <span class="rc-cmp__colhead" style="color:var(--text-secondary)">Where it matters</span>
        <span class="rc-cmp__colhead rc-cmp__colhead--rc">Royal Clouds</span>
        <span class="rc-cmp__colhead rc-cmp__colhead--them rc-cmp__col--them">{themLabel}</span>
      </div>
      {rows.map((r) => (
        <div class="rc-cmp__row">
          <div>
            <div class="rc-cmp__rowlabel">{r.label}</div>
            <div class="rc-cmp__rowsub">{r.sub}</div>
          </div>
          <div class="rc-cmp__val rc-cmp__val--rc">
            {r.rcCheck && <span class="rc-cmp__check"><Icon name="tabler:check" size={18} /></span>}
            <span><b>{r.rc}</b></span>
          </div>
          <div class="rc-cmp__val rc-cmp__val--them rc-cmp__col--them">
            {r.themX && <span class="rc-cmp__x"><Icon name="tabler:x" size={16} /></span>}
            <span>{r.them}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="rc-cmp__foot reveal">
      <Button href="#pricing">Start a migration</Button>
      <Button variant="secondary" arrow href="/contact">Talk to an engineer</Button>
      <span style="font-family:var(--font-mono);font-size:12.5px;color:var(--text-secondary)">We reply within 2 hours.</span>
    </div>
  </div>
</section>
