---
import Button from "~/components/rc/Button.astro";

interface Cta { text: string; href: string; external?: boolean }
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  note?: string;
}
const {
  eyebrow = "Get started",
  title = "Deploy your first project tonight.",
  lead = "Spin up any plan in minutes. Keep your current host running until you're ready — then we move everything across for free.",
  primaryCta = { text: "Choose your plan", href: "#pricing" },
  secondaryCta = { text: "Compare plans", href: "#pricing" },
  note = "No card required to start · Cancel anytime · 30-day money-back",
} = Astro.props;
---

<section class="rc-cta rc-field-band" data-surface="dark">
  <div class="rc-cta__lines" aria-hidden="true"></div>
  <div class="rc-container">
    <div class="rc-cta__inner reveal">
      <span class="rc-eyebrow rc-eyebrow--center" style="color:rgb(244 246 251 / 0.72)">{eyebrow}</span>
      <h2>{title}</h2>
      <p class="rc-cta__lead">{lead}</p>
      <div class="rc-cta__actions">
        <Button href={primaryCta.href} external={primaryCta.external}>{primaryCta.text}</Button>
        <Button variant="secondary" arrow href={secondaryCta.href}>{secondaryCta.text}</Button>
      </div>
      <p class="rc-cta__note">{note}</p>
    </div>
  </div>
</section>
