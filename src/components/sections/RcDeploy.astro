---
import Button from "~/components/rc/Button.astro";
import DeployConsole from "~/components/rc/DeployConsole.astro";
import { Icon } from "astro-icon/components";

interface Point { t: string; d: string }
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  points?: Point[];
  cta?: { text: string; href: string };
}
const {
  eyebrow = "Deploy",
  title = "Push to deploy. Roll back in one click.",
  lead = "Ship from the command line or connect a repo. Every release is versioned, so going back is as easy as going live.",
  points = [
    { t: "Git-based deploys", d: "Push to a branch; we build the image and ship it to every edge region." },
    { t: "One-click rollback", d: "Restore the previous release from a snapshot in seconds — zero downtime." },
    { t: "No maintenance windows", d: "Deploys are atomic. Visitors never see a half-updated site." },
  ],
  cta = { text: "royal deploy --prod", href: "#pricing" },
} = Astro.props;
---

<section class="rc-sect" id="deploy">
  <div class="rc-container">
    <div class="rc-deploy__grid">
      <div class="rc-deploy__col reveal">
        <span class="rc-eyebrow">{eyebrow}</span>
        <h2 style="margin-block:var(--sp-4)">{title}</h2>
        <p class="rc-sect__lead" style="margin-bottom:var(--sp-6)">{lead}</p>
        <div style="display:flex;flex-direction:column;gap:var(--sp-5);margin-bottom:var(--sp-6)">
          {points.map((p) => (
            <div style="display:flex;gap:14px">
              <span style="color:var(--interactive);margin-top:2px"><Icon name="tabler:check" size={20} /></span>
              <div>
                <div style="font-weight:var(--fw-body-semi);margin-bottom:3px">{p.t}</div>
                <div style="color:var(--text-secondary);font-size:var(--t-body-sm);line-height:var(--lh-body)">{p.d}</div>
              </div>
            </div>
          ))}
        </div>
        <Button variant="console" icon="tabler:terminal-2" href={cta.href}>{cta.text}</Button>
      </div>
      <div class="rc-deploy__viz reveal">
        <DeployConsole />
      </div>
    </div>
  </div>
</section>
