---
import Button from "~/components/rc/Button.astro";
import { Icon } from "astro-icon/components";

/* Honest Ledger: every price is shown with its term and renewal, adjacent —
 * never hidden, never in a tooltip. Prices recompute from a base monthly USD
 * figure by billing term + currency, mirroring the design system. */
interface Spec { ico: string; b: string; t: string }
interface Plan {
  id: string;
  name: string;
  flag?: string;
  featured?: boolean;
  desc: string;
  byTerm: Record<string, number>;
  renew: number;
  cta: string;
  ctaUrl: string;
  specs: Spec[];
}
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  plans?: Plan[];
}

const RATES: Record<string, { sym: string; r: number }> = {
  USD: { sym: "$", r: 1 },
  EUR: { sym: "€", r: 0.92 },
  AED: { sym: "AED ", r: 3.67 },
  INR: { sym: "₹", r: 83 },
};
function money(usd: number, cur: string) {
  const c = RATES[cur] || RATES.USD;
  const v = usd * c.r;
  const dec = cur === "INR" ? 0 : v >= 100 ? 0 : 2;
  return c.sym + v.toLocaleString("en-US", { minimumFractionDigits: dec, maximumFractionDigits: dec });
}

const {
  eyebrow = "Transparent pricing",
  title = "Every price, with its renewal.",
  lead = "No intro-rate trap. The renewal sits right next to the promo, always — because you'll pay it eventually and we'd rather you know now.",
  plans = [
    {
      id: "shared", name: "SSD Shared", desc: "For founders and WordPress sites that need to be fast and simply work.",
      byTerm: { "1": 4.99, "12": 3.99, "24": 3.49, "48": 2.99 }, renew: 4.99, cta: "Start a site",
      ctaUrl: "https://my.royalclouds.net/cart.php?a=add&pid=3",
      specs: [
        { ico: "tabler:server", b: "30 GB", t: "SSD storage" },
        { ico: "tabler:world", b: "5", t: "sites · free SSL" },
        { ico: "tabler:mail", b: "15", t: "mailboxes" },
        { ico: "tabler:bolt", b: "1-click", t: "WordPress installer" },
        { ico: "tabler:shield", b: "Free", t: "SSL + daily backups" },
      ],
    },
    {
      id: "vps", name: "KVM VPS", flag: "Most deployed", featured: true,
      desc: "Root, scale, and headroom for developers and agencies running real traffic.",
      byTerm: { "1": 8, "12": 6, "24": 5, "48": 4 }, renew: 8, cta: "Deploy a VPS",
      ctaUrl: "https://my.royalclouds.net/cart.php?a=add&pid=12",
      specs: [
        { ico: "tabler:cpu", b: "2 vCPU", t: "dedicated cores" },
        { ico: "tabler:server", b: "4 GB", t: "RAM · 80 GB SSD" },
        { ico: "tabler:world", b: "1 TB", t: "transfer · 1 IPv4" },
        { ico: "tabler:terminal-2", b: "Full", t: "root access" },
        { ico: "tabler:shield", b: "DDoS", t: "protection + firewall" },
      ],
    },
    {
      id: "dedicated", name: "Dedicated", desc: "Single-tenant bare metal for teams migrating heavy workloads off budget hosts.",
      byTerm: { "1": 159, "12": 139, "24": 129, "48": 119 }, renew: 179, cta: "Configure server",
      ctaUrl: "https://my.royalclouds.net/cart.php?a=add&pid=31",
      specs: [
        { ico: "tabler:cpu", b: "8 cores", t: "@ 3.2 GHz" },
        { ico: "tabler:server", b: "32 GB", t: "RAM · 2×480 GB" },
        { ico: "tabler:world", b: "10 TB", t: "transfer · 5 IPv4" },
        { ico: "tabler:database", b: "IPMI", t: "remote console" },
        { ico: "tabler:shield", b: "Managed", t: "security + failover" },
      ],
    },
  ],
} = Astro.props;

const DEF_TERM = 24;
const DEF_CUR = "USD";
const terms = [
  { value: 1, label: "1 mo" },
  { value: 12, label: "12 mo" },
  { value: 24, label: "24 mo", note: "best" },
  { value: 48, label: "48 mo" },
];
const currencies = ["USD", "EUR", "AED", "INR"];
---

<section class="rc-sect" id="pricing" data-rc-pricing>
  <div class="rc-container">
    <div class="rc-sect__head rc-center reveal">
      <span class="rc-eyebrow rc-eyebrow--center">{eyebrow}</span>
      <h2>{title}</h2>
      <p class="rc-sect__lead" style="text-align:center">{lead}</p>
    </div>
    <div class="rc-pricing__controls reveal">
      <div class="rc-pricing__toggles">
        <div class="rc-seg" role="radiogroup" aria-label="Billing term" data-seg="term">
          {terms.map((t) => (
            <button type="button" class="rc-seg__opt" role="radio" data-value={t.value}
              aria-checked={t.value === DEF_TERM ? "true" : "false"}>
              {t.label}{t.note && <span class="rc-seg__note">{t.note}</span>}
            </button>
          ))}
        </div>
      </div>
      <div class="rc-pricing__toggles">
        <div class="rc-seg rc-seg--sm" role="radiogroup" aria-label="Currency" data-seg="cur">
          {currencies.map((c) => (
            <button type="button" class="rc-seg__opt" role="radio" data-value={c}
              aria-checked={c === DEF_CUR ? "true" : "false"}>{c}</button>
          ))}
        </div>
      </div>
    </div>
    <div class="rc-pricing__grid">
      {plans.map((p) => {
        const mo = p.byTerm[String(DEF_TERM)];
        return (
          <article class={`rc-plan reveal${p.featured ? " rc-plan--featured" : ""}`}
            data-plan data-byterm={JSON.stringify(p.byTerm)} data-renew={p.renew}>
            <div class="rc-plan__tier">
              <span class="rc-plan__name">{p.name}</span>
              {p.flag && <span class="rc-plan__flag">{p.flag}</span>}
            </div>
            <p class="rc-plan__desc">{p.desc}</p>
            <div class="rc-plan__price"><span data-price>{money(mo, DEF_CUR)}</span><span class="rc-plan__per">/mo</span></div>
            <div class="rc-plan__ledger" data-ledger set:html={`Billed <b>${money(mo * DEF_TERM, DEF_CUR)}</b> for ${DEF_TERM} months · Renews <b>${money(p.renew, DEF_CUR)}/mo</b>`}></div>
            <div class="rc-plan__specs">
              {p.specs.map((s) => (
                <div class="rc-plan__spec">
                  <span class="rc-plan__spec-ico"><Icon name={s.ico} size={18} /></span>
                  <span><b>{s.b}</b> {s.t}</span>
                </div>
              ))}
            </div>
            <div class="rc-plan__cta"><Button block href={p.ctaUrl} external arrow={p.featured}>{p.cta}</Button></div>
          </article>
        );
      })}
    </div>
    <div class="rc-pricing__foot reveal">
      <Icon name="tabler:shield" size={18} style="color:var(--interactive)" />
      <span>Every plan includes a 30-day money-back guarantee and free migration. <a href="#faq">Why we show renewals</a>.</span>
    </div>
  </div>
</section>

<script>
  function rcSetupPricing() {
    const RATES: Record<string, { sym: string; r: number }> = {
      USD: { sym: "$", r: 1 }, EUR: { sym: "€", r: 0.92 }, AED: { sym: "AED ", r: 3.67 }, INR: { sym: "₹", r: 83 },
    };
    const money = (usd: number, cur: string) => {
      const c = RATES[cur] || RATES.USD;
      const v = usd * c.r;
      const dec = cur === "INR" ? 0 : v >= 100 ? 0 : 2;
      return c.sym + v.toLocaleString("en-US", { minimumFractionDigits: dec, maximumFractionDigits: dec });
    };
    document.querySelectorAll<HTMLElement>("[data-rc-pricing]").forEach((root) => {
      if (root.dataset.rcInit) return;
      root.dataset.rcInit = "1";
      const state = { term: 24, cur: "USD" };
      const render = () => {
        root.querySelectorAll<HTMLElement>("[data-plan]").forEach((card) => {
          const byTerm = JSON.parse(card.dataset.byterm || "{}");
          const renew = Number(card.dataset.renew || 0);
          const mo = Number(byTerm[String(state.term)]);
          const price = card.querySelector<HTMLElement>("[data-price]");
          const ledger = card.querySelector<HTMLElement>("[data-ledger]");
          if (price) price.textContent = money(mo, state.cur);
          if (ledger) {
            ledger.innerHTML = state.term === 1
              ? `Billed monthly · Renews <b>${money(renew, state.cur)}/mo</b>`
              : `Billed <b>${money(mo * state.term, state.cur)}</b> for ${state.term} months · Renews <b>${money(renew, state.cur)}/mo</b>`;
          }
        });
      };
      root.querySelectorAll<HTMLElement>("[data-seg]").forEach((seg) => {
        const key = seg.dataset.seg as "term" | "cur";
        seg.querySelectorAll<HTMLButtonElement>(".rc-seg__opt").forEach((btn) => {
          btn.addEventListener("click", () => {
            seg.querySelectorAll(".rc-seg__opt").forEach((b) => b.setAttribute("aria-checked", "false"));
            btn.setAttribute("aria-checked", "true");
            const raw = btn.dataset.value as string;
            if (key === "term") state.term = Number(raw); else state.cur = raw;
            render();
          });
        });
      });
      render();
    });
  }
  rcSetupPricing();
  document.addEventListener("astro:after-swap", rcSetupPricing);
</script>
