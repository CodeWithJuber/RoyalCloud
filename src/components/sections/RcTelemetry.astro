---
import CapacityBar from "~/components/rc/CapacityBar.astro";
import LatencyRing from "~/components/rc/LatencyRing.astro";
import UptimeStrip from "~/components/rc/UptimeStrip.astro";
import StatusBadge from "~/components/rc/StatusBadge.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
}
const {
  eyebrow = "Live fleet",
  title = "Watch it run before you buy.",
  lead = "These aren't screenshots. Capacity, latency, and uptime read from a node in our San Francisco region — the same telemetry you get on your own dashboard.",
} = Astro.props;
---

<section class="rc-sect rc-field-band" data-surface="dark" style="background:var(--midnight)">
  <div class="rc-container">
    <div class="rc-sect__head reveal">
      <span class="rc-eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p class="rc-sect__lead">{lead}</p>
    </div>
    <div class="rc-telem__grid">
      <div class="rc-panel reveal">
        <div class="rc-telem__caps-head">
          <span class="rc-mono" style="font-size:13px;color:var(--chrome)">node ryl-sfo-04</span>
          <StatusBadge state="ok">Operational</StatusBadge>
        </div>
        <div class="rc-telem__caps">
          <CapacityBar label="vCPU" value={38} display="38% · 2 cores" />
          <CapacityBar label="Memory" value={37} display="5.9 / 16 GB" />
          <CapacityBar label="NVMe" value={44} display="212 / 480 GB" />
          <CapacityBar label="Transfer" value={22} display="0.9 / 4 TB" />
        </div>
        <div class="rc-telem__uptime">
          <UptimeStrip uptime="99.99%" period="trailing 90 days" href="/uptime" days={60} />
        </div>
      </div>
      <div class="rc-panel reveal">
        <div class="rc-telem__caps-head" style="margin-bottom:var(--sp-5)">
          <span class="rc-mono" style="font-size:13px;color:var(--chrome)">edge latency</span>
          <span class="rc-label" style="font-size:11px;color:var(--smoke)">trailing 24h</span>
        </div>
        <div class="rc-telem__rings">
          <LatencyRing value={41} unit="ms" label="Median TTFB" max={200} size={128} />
          <LatencyRing value={96} unit="ms" label="P95" max={300} size={128} />
        </div>
        <hr class="rc-hair" style="margin:var(--sp-6) 0 var(--sp-5)" />
        <div style="display:grid;gap:12px;font-family:var(--font-mono);font-size:13px;color:var(--smoke)">
          <div style="display:flex;justify-content:space-between"><span>region</span><span style="color:var(--chrome)">sfo · us-west</span></div>
          <div style="display:flex;justify-content:space-between"><span>stack</span><span style="color:var(--chrome)">litespeed · php 8.3</span></div>
          <div style="display:flex;justify-content:space-between"><span>cache</span><span style="color:var(--pulse-ok)">hit 94.2%</span></div>
        </div>
      </div>
    </div>
    <p style="margin-top:var(--sp-5);font-size:12.5px;color:var(--smoke);font-family:var(--font-mono)">Source: fleet metrics API · sampled live · illustrative node</p>
  </div>
</section>
