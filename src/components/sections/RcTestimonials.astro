---
import { Icon } from "astro-icon/components";
import testimonials from "~/data/testimonials.json";

interface Item { name: string; site?: string; quote: string; rating?: number }
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  limit?: number;
}
const {
  eyebrow = "Customers",
  title = "Rated 9.6/10 by the people who moved.",
  lead = "Founders, agencies, and developers who left a budget host and stayed.",
  limit = 3,
} = Astro.props;

const items = ((testimonials as { items: Item[] }).items || []).slice(0, limit);
const initials = (name: string) =>
  name.split(/\s+/).map((p) => p[0]).slice(0, 2).join("").toUpperCase();
---

<section class="rc-sect">
  <div class="rc-container">
    <div class="rc-sect__head reveal">
      <span class="rc-eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p class="rc-sect__lead">{lead}</p>
    </div>
    <div class="rc-tst">
      {items.map((t) => (
        <div class="rc-tst__row reveal">
          <div class="rc-tst__who">
            <span class="rc-tst__avatar">{initials(t.name)}</span>
            <span class="rc-tst__name">{t.name}</span>
            {t.site && <span class="rc-tst__site">{t.site}</span>}
          </div>
          <div>
            <p class="rc-tst__quote">“{t.quote}”</p>
            <div class="rc-tst__meta">
              <span style="display:inline-flex;align-items:center;gap:7px"><Icon name="tabler:check" size={15} style="color:var(--interactive)" /> Verified customer</span>
              {t.rating && <><span>·</span><span>{t.rating}.0 / 5 rating</span></>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
