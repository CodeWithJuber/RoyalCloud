---
import { Image } from "astro:assets";
import { pricify } from "~/utils/currency";
import bannerShapeOne from "~/assets/images/live/banner-shape/banner-shape-one.png";
import bannerShapeTwo from "~/assets/images/live/banner-shape/banner-shape-two.png";
import bannerShapeThree from "~/assets/images/live/banner-shape/banner-shape-three.png";
import bannerOneShapeOne from "~/assets/images/live/banner-one/banner-one-shape-one.png";
import bannerOneShapeTwo from "~/assets/images/live/banner-one/banner-one-shape-two.png";
import bannerOneShapeFive from "~/assets/images/live/banner-one/banner-one-shape-five.png";
import bannerOneShapeSix from "~/assets/images/live/banner-one/banner-one-shape-six.png";
import bannerOneShapeSeven from "~/assets/images/live/banner-one/banner-one-shape-seven.png";
import bannerOneShapeEight from "~/assets/images/live/banner-one/banner-one-shape-eight.png";
import cloudMascot from "~/assets/images/live/rcboy/cloud.png";
import separatorSvg from "~/assets/images/live/separator-rc.svg";
import site from "~/data/site.json";

import ssdHost from "~/assets/images/live/ssd-host.png";
import vpsImg from "~/assets/images/live/vps-img-1.png";
import vpsHosting from "~/assets/images/live/vps_hosting.png";
import dedicated from "~/assets/images/live/Dedicated.png";

interface Cta {
  text: string;
  href: string;
  external?: boolean;
}
interface Props {
  variant?: "gradient" | "product" | "simple";
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  offer?: string;
  art?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  badges?: string[];
}
const {
  variant = "product",
  eyebrow,
  title,
  subtitle,
  offer,
  art,
  primaryCta,
  secondaryCta,
  badges,
} = Astro.props;
const target = (cta?: Cta) =>
  cta?.external || /^https?:\/\//.test(cta?.href ?? "") ? "_blank" : undefined;

const PRODUCT_ART: Record<string, ImageMetadata> = {
  "il-shared": ssdHost,
  "il-cpanel": ssdHost,
  "il-vps": vpsImg,
  "il-cyberpanel": vpsHosting,
  "il-cloud": vpsHosting,
  "il-reseller": ssdHost,
  "il-wordpress": ssdHost,
  "il-dedicated": dedicated,
  "il-domains": ssdHost,
};
const productImg = art ? PRODUCT_ART[art] : undefined;
---

{variant === "gradient" && (
  <section class="hero-gradient" aria-labelledby="home-title">
    <div class="hero-shapes" aria-hidden="true">
      <Image src={bannerShapeOne} alt="" class="bs bs-1" width={400} height={400} />
      <Image src={bannerShapeTwo} alt="" class="bs bs-2" width={300} height={300} />
      <Image src={bannerShapeThree} alt="" class="bs bs-3" width={200} height={200} />
      <Image src={bannerOneShapeOne} alt="" class="bo bo-1" width={140} height={140} />
      <Image src={bannerOneShapeTwo} alt="" class="bo bo-2" width={100} height={100} />
      <Image src={bannerOneShapeFive} alt="" class="bo bo-5" width={80} height={80} />
      <Image src={bannerOneShapeSix} alt="" class="bo bo-6" width={60} height={60} />
      <Image src={bannerOneShapeSeven} alt="" class="bo bo-7" width={50} height={50} />
      <Image src={bannerOneShapeEight} alt="" class="bo bo-8" width={40} height={40} />
    </div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        {offer && <p class="hero-offer" set:html={pricify(offer)} />}
        <h1 id="home-title" set:html={title} />
        {subtitle && <p class="hero-sub" set:html={subtitle} />}

        <div class="hero-countdown" id="clockdiv">
          <div class="count-box"><span class="count-val" id="cd-days">0</span><span class="count-label">Days</span></div>
          <div class="count-box"><span class="count-val" id="cd-hours">0</span><span class="count-label">Hours</span></div>
          <div class="count-box"><span class="count-val" id="cd-mins">0</span><span class="count-label">Minutes</span></div>
          <div class="count-box"><span class="count-val" id="cd-secs">0</span><span class="count-label">Seconds</span></div>
        </div>

        <div class="hero-ctas">
          {primaryCta && (
            <a
              class="default-btn hero-primary"
              href={primaryCta.href}
              target={target(primaryCta)}
              rel={target(primaryCta) && "noopener"}
            >{primaryCta.text}</a>
          )}
          {secondaryCta && (
            <a
              class="hero-secondary"
              href={secondaryCta.href}
              target={target(secondaryCta)}
              rel={target(secondaryCta) && "noopener"}
            >{secondaryCta.text}</a>
          )}
        </div>

        {badges && badges.length > 0 && (
          <div class="hero-badges">
            {badges.map((b) => <span class="hero-badge">{b}</span>)}
          </div>
        )}
      </div>

      <div class="hero-art" aria-hidden="true">
        <Image src={cloudMascot} alt="" width={420} height={420} class="hero-mascot" />
      </div>
    </div>
  </section>
)}

{variant === "product" && (
  <section class="hero-product">
    <div class="wrap hero-product-inner">
      <div class="hero-product-copy">
        {eyebrow && <span class="hero-eyebrow">{eyebrow}</span>}
        <h1 set:html={title} />
        {subtitle && <p class="hero-product-sub" set:html={subtitle} />}
        {badges && badges.length > 0 && (
          <div class="hero-product-includes">
            {badges.map((b) => (
              <span class="hero-include-item">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="rgba(255,255,255,0.2)"/><path d="M5 8l2 2 4-4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {b}
              </span>
            ))}
          </div>
        )}
        {(primaryCta || secondaryCta) && (
          <div class="hero-ctas">
            {primaryCta && (
              <a class="btn-yellow" href={primaryCta.href} target={target(primaryCta)} rel={target(primaryCta) && "noopener"}>
                {primaryCta.text}
              </a>
            )}
            {secondaryCta && (
              <a class="default-btn" href={secondaryCta.href} target={target(secondaryCta)} rel={target(secondaryCta) && "noopener"}>
                {secondaryCta.text}
              </a>
            )}
          </div>
        )}
      </div>
      {productImg && (
        <div class="hero-product-art" aria-hidden="true">
          <Image src={productImg} alt="" width={400} height={400} class="hero-product-img" />
        </div>
      )}
    </div>
  </section>
)}

{variant === "simple" && (
  <section class="hero-simple">
    <div class="wrap">
      {eyebrow && <span class="hero-eyebrow">{eyebrow}</span>}
      <h1 set:html={title} />
      {subtitle && <p class="hero-simple-sub" set:html={subtitle} />}
    </div>
  </section>
)}

<style>
  /* ═══ GRADIENT HERO (homepage) ═══ */
  .hero-gradient {
    position: relative;
    background: var(--grad-royal);
    padding: 160px 0 100px;
    overflow: hidden;
    min-height: 700px;
    color: #fff;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .hero-copy {
    flex: 1;
    min-width: 0;
  }
  .hero-art {
    flex: 0 0 380px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hero-mascot {
    width: 100%;
    max-width: 420px;
    height: auto;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.2));
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-mascot {
      animation: mascotFloat 6s ease-in-out infinite;
    }
  }
  @keyframes mascotFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  .hero-offer {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: rgba(255,255,255,0.9);
    margin: 0 0 15px;
    padding: 6px 18px;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 50px;
  }

  .hero-gradient h1 {
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
    margin: 0 0 15px;
    max-width: 600px;
  }
  .hero-gradient h1 :global(em) {
    font-style: normal;
    color: #fdd700;
  }

  .hero-sub {
    font-size: 16px;
    color: rgba(255,255,255,0.85);
    line-height: 1.8;
    margin: 0 0 25px;
    max-width: 500px;
  }

  /* ── Countdown ── */
  .hero-countdown {
    display: flex;
    gap: 12px;
    margin-bottom: 30px;
  }
  .count-box {
    background: rgba(255,255,255,0.15);
    border-radius: 8px;
    padding: 12px 18px;
    text-align: center;
    min-width: 70px;
    backdrop-filter: blur(4px);
  }
  .count-val {
    display: block;
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 700;
    color: #fff;
    line-height: 1;
  }
  .count-label {
    display: block;
    font-size: 11px;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 4px;
  }

  /* ── CTAs ── */
  .hero-ctas {
    display: flex;
    gap: 15px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .hero-primary {
    font-size: 16px;
    padding: 14px 35px;
  }
  .hero-secondary {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    padding: 14px 25px;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50px;
    transition: border-color 0.2s, color 0.2s;
  }
  .hero-secondary:hover {
    border-color: #fff;
    color: #fff;
  }

  /* ── Badges ── */
  .hero-badges {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }
  .hero-badge {
    font-size: 13px;
    color: rgba(255,255,255,0.7);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .hero-badge::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fdd700;
  }

  /* ── Shapes ── */
  .hero-shapes {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }
  .bs, .bo {
    position: absolute;
    opacity: 0.12;
  }
  .bs-1 { top: -60px; right: -80px; width: 400px; }
  .bs-2 { bottom: -40px; left: -60px; width: 300px; }
  .bs-3 { top: 30%; right: 25%; width: 150px; opacity: 0.08; }
  .bo-1 { top: 15%; left: 5%; width: 100px; }
  .bo-2 { bottom: 20%; right: 10%; width: 80px; }
  .bo-5 { top: 50%; left: 30%; width: 50px; opacity: 0.06; }
  .bo-6 { top: 8%; right: 40%; width: 40px; opacity: 0.08; }
  .bo-7 { bottom: 35%; left: 15%; width: 35px; opacity: 0.06; }
  .bo-8 { bottom: 10%; left: 45%; width: 30px; opacity: 0.05; }

  @media (prefers-reduced-motion: no-preference) {
    .bs-1 { animation: shapeFloat 12s ease-in-out infinite; }
    .bs-2 { animation: shapeFloat 15s ease-in-out infinite 2s; }
    .bo-1 { animation: shapeFloat 10s ease-in-out infinite 1s; }
    .bo-2 { animation: shapeFloat 14s ease-in-out infinite 3s; }
  }
  @keyframes shapeFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  /* ── Responsive gradient hero ── */
  @media (max-width: 991px) {
    .hero-gradient { padding: 140px 0 80px; min-height: auto; }
    .hero-gradient h1 { font-size: 38px; }
    .hero-art { flex: 0 0 280px; }
    .hero-mascot { max-width: 280px; }
  }
  @media (max-width: 767px) {
    .hero-gradient { padding: 120px 0 60px; }
    .hero-inner { flex-direction: column; text-align: center; }
    .hero-gradient h1 { font-size: 30px; max-width: 100%; }
    .hero-sub { max-width: 100%; }
    .hero-ctas { justify-content: center; }
    .hero-badges { justify-content: center; }
    .hero-countdown { justify-content: center; }
    .hero-art { flex: none; order: -1; }
    .hero-mascot { max-width: 220px; }
    .count-box { padding: 10px 12px; min-width: 60px; }
    .count-val { font-size: 24px; }
  }

  /* ═══ PRODUCT HERO (interior pages) ═══ */
  .hero-product {
    background: var(--grad-royal);
    padding: 160px 0 55px;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .hero-product-inner {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .hero-product-copy {
    flex: 1;
    min-width: 0;
  }
  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: rgba(255,255,255,0.8);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }
  .hero-product h1 {
    font-family: var(--font-heading);
    font-size: 42px;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
    margin: 0 0 15px;
  }
  .hero-product h1 :global(em) {
    font-style: normal;
    color: #fdd700;
  }
  .hero-product-sub {
    font-size: 16px;
    color: rgba(255,255,255,0.8);
    line-height: 1.8;
    margin: 0 0 20px;
    max-width: 500px;
  }
  .hero-product-includes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-bottom: 25px;
  }
  .hero-include-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: rgba(255,255,255,0.85);
  }
  .hero-product-art {
    flex: 0 0 350px;
    text-align: center;
  }
  .hero-product-img {
    width: 100%;
    max-width: 400px;
    height: auto;
    filter: drop-shadow(0 15px 40px rgba(0,0,0,0.25));
  }
  @media (max-width: 991px) {
    .hero-product { padding: 140px 0 50px; }
    .hero-product h1 { font-size: 34px; }
    .hero-product-art { flex: 0 0 250px; }
  }
  @media (max-width: 767px) {
    .hero-product { padding: 120px 0 40px; }
    .hero-product-inner { flex-direction: column; text-align: center; }
    .hero-product h1 { font-size: 28px; }
    .hero-product-art { flex: none; order: -1; }
    .hero-product-img { max-width: 250px; }
    .hero-product-includes { justify-content: center; }
    .hero-product .hero-ctas { justify-content: center; }
  }

  /* ═══ SIMPLE HERO ═══ */
  .hero-simple {
    background: var(--grad-royal);
    padding: 160px 0 60px;
    color: #fff;
    text-align: center;
  }
  .hero-simple h1 {
    font-family: var(--font-heading);
    font-size: 42px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 15px;
  }
  .hero-simple-sub {
    font-size: 16px;
    color: rgba(255,255,255,0.8);
    line-height: 1.8;
    max-width: 600px;
    margin: 0 auto;
  }
  @media (max-width: 767px) {
    .hero-simple { padding: 120px 0 40px; }
    .hero-simple h1 { font-size: 28px; }
  }
</style>

<script>
  function initCountdown() {
    const el = document.getElementById("clockdiv");
    if (!el) return;

    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    tomorrow.setHours(23, 59, 59, 0);
    const deadline = tomorrow.getTime();

    const days = document.getElementById("cd-days");
    const hours = document.getElementById("cd-hours");
    const mins = document.getElementById("cd-mins");
    const secs = document.getElementById("cd-secs");
    if (!days || !hours || !mins || !secs) return;

    const tick = () => {
      const diff = Math.max(0, deadline - Date.now());
      const s = Math.floor(diff / 1000);
      days.textContent = String(Math.floor(s / 86400));
      hours.textContent = String(Math.floor((s % 86400) / 3600)).padStart(2, "0");
      mins.textContent = String(Math.floor((s % 3600) / 60)).padStart(2, "0");
      secs.textContent = String(s % 60).padStart(2, "0");
    };
    tick();
    setInterval(tick, 1000);
  }
  initCountdown();
  document.addEventListener("astro:after-swap", initCountdown);
</script>
