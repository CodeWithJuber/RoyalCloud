---
import { Image } from "astro:assets";
import HeroRC from "~/components/widgets/HeroRC.astro";
import SectionArt from "./SectionArt.astro";
import AltitudeScene from "~/components/widgets/AltitudeScene.astro";
import cloud from "~/assets/images/brand/cloud.png";
import IlShared from "~/components/illustrations/spots/IlShared.astro";
import IlWordpress from "~/components/illustrations/spots/IlWordpress.astro";
import IlVps from "~/components/illustrations/spots/IlVps.astro";
import IlDedicated from "~/components/illustrations/spots/IlDedicated.astro";
import IlCyberpanel from "~/components/illustrations/spots/IlCyberpanel.astro";
import IlCloud from "~/components/illustrations/spots/IlCloud.astro";
import IlReseller from "~/components/illustrations/spots/IlReseller.astro";
import IlDomains from "~/components/illustrations/spots/IlDomains.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface Cta {
  text: string;
  href: string;
  external?: boolean;
}
interface Props {
  variant?: "gradient" | "product" | "simple";
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  offer?: string;
  /** Themed illustration scene replacing the default hero art (see SectionArt). */
  art?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  badges?: string[];
}
const {
  variant = "product",
  eyebrow,
  title,
  subtitle,
  offer,
  art,
  primaryCta,
  secondaryCta,
  badges,
} = Astro.props;
const target = (cta?: Cta) =>
  cta?.external || /^https?:\/\//.test(cta?.href ?? "") ? "_blank" : undefined;

// Per-product hero illustration: each product page leads with its OWN custom
// spot illustration (passed as art: "il-vps" etc.) instead of the shared orbit.
const SPOT: Record<string, AstroComponentFactory> = {
  "il-shared": IlShared,
  "il-wordpress": IlWordpress,
  "il-vps": IlVps,
  "il-dedicated": IlDedicated,
  "il-cyberpanel": IlCyberpanel,
  "il-cloud": IlCloud,
  "il-reseller": IlReseller,
  "il-domains": IlDomains,
};
const Spot = art ? SPOT[art] : undefined;
---

{
  variant === "gradient" && (
    <HeroRC
      title={title}
      subtitle={subtitle}
      offer={offer ?? eyebrow}
      art={art}
      primary={
        primaryCta && {
          text: primaryCta.text,
          href: primaryCta.href,
          target: target(primaryCta),
        }
      }
      secondary={
        secondaryCta && {
          text: secondaryCta.text,
          href: secondaryCta.href,
          target: target(secondaryCta),
        }
      }
      badges={badges}
    />
  )
}

{
  variant === "product" && (
    <section class="p-hero">
      <div class="wrap inner">
        <div class="p-hero-copy">
          {eyebrow && (
            <span class="hero-eyebrow">
              <span class="dot" />
              {eyebrow}
            </span>
          )}
          <h1 set:html={title} />
          {subtitle && <p class="sub" set:html={subtitle} />}
          {(primaryCta || secondaryCta) && (
            <div class="hero-ctas">
              {primaryCta && (
                <a
                  class="btn btn-primary btn-lg"
                  href={primaryCta.href}
                  target={target(primaryCta)}
                  rel={target(primaryCta) && "noopener"}
                >
                  {primaryCta.text}
                </a>
              )}
              {secondaryCta && (
                <a
                  class="btn btn-ghost-dark btn-lg"
                  href={secondaryCta.href}
                  target={target(secondaryCta)}
                  rel={target(secondaryCta) && "noopener"}
                >
                  {secondaryCta.text}
                </a>
              )}
            </div>
          )}
        </div>
        <div class="p-hero-art" aria-hidden="true">
          {Spot ? (
            <div class="p-hero-illus" data-phero-illus>
              <span class="p-hero-halo" />
              <Spot />
            </div>
          ) : art ? (
            <>
              <div class="disc" />
              <Image src={cloud} alt="" width={120} height={90} class="c1" />
              <Image src={cloud} alt="" width={90} height={70} class="c2" />
              <SectionArt kind={art} bare />
            </>
          ) : (
            <AltitudeScene variant="light" class="p-hero-altitude" />
          )}
        </div>
      </div>
    </section>
  )
}

{
  variant === "simple" && (
    <section class="s-hero">
      <div class="wrap">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 set:html={title} />
        {subtitle && <p class="sub" set:html={subtitle} />}
      </div>
    </section>
  )
}

<style>
  /* per-product hero illustration on a soft glow halo (gentle cursor tilt
     wired in SmoothScroll via [data-phero-illus]) */
  .p-hero-illus {
    position: relative;
    width: clamp(280px, 33vw, 430px);
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
  }
  .p-hero-illus :global(.rc-spot) {
    position: relative;
    z-index: 1;
    width: 100%;
    filter: drop-shadow(0 22px 44px rgba(81, 17, 224, 0.2));
  }
  .p-hero-halo {
    position: absolute;
    inset: -10%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 46%,
      color-mix(in srgb, var(--theme-accent, #5a1ee6) 22%, transparent),
      rgba(30, 150, 232, 0.08) 46%,
      transparent 70%
    );
  }
  @media (prefers-reduced-motion: no-preference) {
    .p-hero-illus {
      animation: pHeroFloat 7s ease-in-out infinite;
    }
  }
  @keyframes pHeroFloat {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -10px;
    }
  }
  /* default product-hero art: the Altitude scene on a soft spectrum halo */
  .p-hero-art :global(.p-hero-altitude) {
    width: clamp(260px, 30vw, 380px);
    height: auto;
  }
  .p-hero-art:has(.p-hero-altitude)::before {
    content: "";
    position: absolute;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 45%,
      rgba(81, 17, 224, 0.12) 0%,
      rgba(25, 182, 255, 0.08) 45%,
      transparent 70%
    );
    z-index: 0;
  }
</style>
