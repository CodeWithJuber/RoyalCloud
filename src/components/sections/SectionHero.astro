---
import { Image } from "astro:assets";
import HeroRC from "~/components/widgets/HeroRC.astro";
import SectionArt from "./SectionArt.astro";
import cloud from "~/assets/images/brand/cloud.png";
import cloudServer from "~/assets/images/brand/cloud-server.png";

interface Cta {
  text: string;
  href: string;
  external?: boolean;
}
interface Props {
  variant?: "gradient" | "product" | "simple";
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  offer?: string;
  /** Themed illustration scene replacing the default hero art (see SectionArt). */
  art?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  badges?: string[];
}
const {
  variant = "product",
  eyebrow,
  title,
  subtitle,
  offer,
  art,
  primaryCta,
  secondaryCta,
  badges,
} = Astro.props;
const target = (cta?: Cta) =>
  cta?.external || /^https?:\/\//.test(cta?.href ?? "") ? "_blank" : undefined;
---

{
  variant === "gradient" && (
    <HeroRC
      title={title}
      subtitle={subtitle}
      offer={offer ?? eyebrow}
      art={art}
      primary={
        primaryCta && {
          text: primaryCta.text,
          href: primaryCta.href,
          target: target(primaryCta),
        }
      }
      secondary={
        secondaryCta && {
          text: secondaryCta.text,
          href: secondaryCta.href,
          target: target(secondaryCta),
        }
      }
      badges={badges}
    />
  )
}

{
  variant === "product" && (
    <section class="p-hero">
      <div class="wrap inner">
        <div class="p-hero-copy">
          {eyebrow && (
            <span class="hero-eyebrow">
              <span class="dot" />
              {eyebrow}
            </span>
          )}
          <h1 set:html={title} />
          {subtitle && <p class="sub" set:html={subtitle} />}
          {badges && badges.length > 0 && (
            <div class="hero-badges">
              {badges.map((b) => (
                <span class="b">{b}</span>
              ))}
            </div>
          )}
          {offer && <span class="offer" set:html={offer} />}
          {(primaryCta || secondaryCta) && (
            <div class="hero-ctas">
              {primaryCta && (
                <a
                  class="btn btn-primary btn-lg"
                  href={primaryCta.href}
                  target={target(primaryCta)}
                  rel={target(primaryCta) && "noopener"}
                >
                  {primaryCta.text}
                </a>
              )}
              {secondaryCta && (
                <a
                  class="btn btn-ghost-dark btn-lg"
                  href={secondaryCta.href}
                  target={target(secondaryCta)}
                  rel={target(secondaryCta) && "noopener"}
                >
                  {secondaryCta.text}
                </a>
              )}
            </div>
          )}
          <p class="cta-fine">30-day money-back guarantee · Instant setup</p>
        </div>
        <div class="p-hero-art" aria-hidden="true">
          <div class="disc" />
          <Image src={cloud} alt="" width={120} height={90} class="c1" />
          <Image src={cloud} alt="" width={90} height={70} class="c2" />
          {art ? (
            <SectionArt kind={art} bare />
          ) : (
            <Image src={cloudServer} alt="" width={240} height={240} />
          )}
        </div>
      </div>
    </section>
  )
}

{
  variant === "simple" && (
    <section class="s-hero">
      <div class="wrap">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 set:html={title} />
        {subtitle && <p class="sub" set:html={subtitle} />}
      </div>
    </section>
  )
}
