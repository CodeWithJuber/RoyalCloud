---
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<section class="stats">
  <div class="wrap">
    <div class="stat-grid">
      {
        items.map((s, i) => (
          <div class={`stat reveal reveal-d${(i % 4) + 1}`}>
            <div class="amount">{s.value}</div>
            <div class="label">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
