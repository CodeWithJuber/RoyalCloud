---
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;

// Split "99.99%" → count target 99.99 + suffix "%"; "24/7" stays static.
const parse = (v: string) => {
  const m = v.match(/^(\d+(?:\.\d+)?)([^\d].*)?$/);
  if (!m || v.includes("/")) return null;
  return { target: m[1], suffix: m[2] ?? "" };
};
---

<section class="stats">
  <div class="wrap">
    <div class="stat-grid">
      {
        items.map((s, i) => {
          const c = parse(s.value);
          return (
            <div class={`stat reveal reveal-d${(i % 4) + 1}`}>
              <div
                class="amount"
                {...(c
                  ? {
                      "data-count": c.target,
                      "data-suffix": c.suffix,
                    }
                  : {})}
              >
                {s.value}
              </div>
              <div class="label">{s.label}</div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

