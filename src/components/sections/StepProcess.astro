---
import { Image } from "astro:assets";
import mascot from "~/assets/images/brand/mascot.png";
import cloud from "~/assets/images/brand/cloud.png";

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items: { title?: string; text?: string }[];
}
const { eyebrow, title, subtitle, items } = Astro.props;
---

<section class="steps-sec cv-auto">
  <div class="wrap">
    {
      (eyebrow || title) && (
        <div class="sec-head center reveal">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          {title && <h2 set:html={title} />}
          {subtitle && <p set:html={subtitle} />}
        </div>
      )
    }
    <div class="steps-grid">
      <div class="step-list">
        {
          items.map((s, i) => (
            <div class={`step reveal reveal-d${(i % 4) + 1}`}>
              <span class="step-num" />
              <div>
                <h4>{s.title}</h4>
                <p>{s.text}</p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="steps-figure reveal rv-right" aria-hidden="true">
        <Image src={cloud} alt="" width={92} height={70} class="c" />
        <Image src={mascot} alt="" width={190} height={395} class="m" />
      </div>
    </div>
  </div>
</section>
