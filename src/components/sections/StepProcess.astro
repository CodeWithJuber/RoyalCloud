---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items: { title?: string; text?: string }[];
}
const { eyebrow, title, subtitle, items } = Astro.props;
---

<section class="steps-sec cv-auto">
  <div class="wrap">
    {
      (eyebrow || title) && (
        <div class="sec-head center reveal">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          {title && <h2 set:html={title} />}
          {subtitle && <p set:html={subtitle} />}
        </div>
      )
    }
    <div class="step-list" style="max-width: 720px; margin: 0 auto;">
      {
        items.map((s, i) => (
          <div class={`step reveal reveal-d${(i % 4) + 1}`}>
            <span class="step-num" />
            <div>
              <h4>{s.title}</h4>
              <p>{s.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
