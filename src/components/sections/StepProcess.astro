---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items: { title?: string; text?: string }[];
}
const { eyebrow, title, subtitle, items } = Astro.props;
---

<section class="steps-sec cv-auto">
  <div class="wrap">
    {
      (eyebrow || title) && (
        <div class="sec-head center reveal">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          {title && <h2 set:html={title} />}
          {subtitle && <p set:html={subtitle} />}
        </div>
      )
    }
    <ol
      class="timeline"
      style={`grid-template-columns: repeat(${items.length}, 1fr); --n: ${items.length};`}
    >
      {
        items.map((s, i) => (
          <li class={`tl-step reveal reveal-d${(i % 4) + 1}`}>
            <span class="tl-node">{i + 1}</span>
            <div class="tl-body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 28px;
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
  }
  /* horizontal spectrum connector, spanning first node centre to last */
  .timeline::before {
    content: "";
    position: absolute;
    top: 27px;
    left: calc(50% / var(--n));
    right: calc(50% / var(--n));
    height: 2px;
    background: var(--spectrum);
    opacity: 0.55;
  }
  .tl-step {
    position: relative;
    text-align: center;
  }
  .tl-node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin: 0 auto 18px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--theme-accent, var(--rc-violet));
    color: var(--theme-accent, var(--rc-violet));
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    box-shadow: var(--shadow-sm);
  }
  .tl-body h3 {
    font-family: var(--font-heading);
    font-size: 18.5px;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0 0 6px;
  }
  .tl-body p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 32ch;
    margin: 0 auto;
  }

  /* vertical timeline on phones */
  @media (max-width: 760px) {
    .timeline {
      grid-template-columns: 1fr !important;
      gap: 0;
    }
    .timeline::before {
      top: 27px;
      bottom: 27px;
      left: 27px;
      right: auto;
      width: 2px;
      height: auto;
    }
    .tl-step {
      display: grid;
      grid-template-columns: 54px 1fr;
      gap: 0 16px;
      text-align: left;
      padding-bottom: 30px;
    }
    .tl-node {
      margin: 0;
    }
    .tl-body {
      padding-top: 6px;
    }
    .tl-body p {
      max-width: none;
      margin: 0;
    }
  }
</style>
