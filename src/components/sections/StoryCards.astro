---
import separatorSvg from "~/assets/images/live/separator-rc.svg";

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items: {
    tag: string;
    metric: string;
    metricLabel: string;
    quote: string;
    name: string;
    site?: string;
  }[];
}
const { eyebrow, title, subtitle, items } = Astro.props;
---

<section class="rc-stories">
  <div class="wrap">
    {
      (eyebrow || title) && (
        <div class="section-title">
          {eyebrow && <span class="story-eyebrow">{eyebrow}</span>}
          {title && <h2 set:html={title} />}
          <img src={separatorSvg.src} alt="" class="separator-rc" width="250" height="30" />
          {subtitle && <p set:html={subtitle} />}
        </div>
      )
    }
    <div class="story-grid" data-cols={Math.min(items.length, 3)}>
      {
        items.map((s) => (
          <article class="story-card">
            <span class="story-tag">{s.tag}</span>
            <div class="story-metric">
              <strong>{s.metric}</strong>
              <small>{s.metricLabel}</small>
            </div>
            <blockquote>"{s.quote}"</blockquote>
            <footer>
              <span class="story-avatar">{s.name.slice(0, 1)}</span>
              <span>
                <b>{s.name}</b>
                {s.site && <small>{s.site}</small>}
              </span>
            </footer>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rc-stories {
    padding: var(--space-section) 0;
    background: #fafafa;
  }

  .story-eyebrow {
    display: block;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--rc-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .story-grid[data-cols="2"] {
    grid-template-columns: repeat(2, 1fr);
    max-width: 880px;
    margin: 0 auto;
  }

  .story-card {
    background: #fff;
    border: 1px solid #eaeaea;
    border-radius: 12px;
    padding: 30px 25px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .story-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.06);
  }

  .story-tag {
    align-self: flex-start;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: var(--rc-primary);
    border-radius: 50px;
    padding: 5px 14px;
  }

  .story-metric {
    margin-top: 18px;
  }
  .story-metric strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.05;
    color: var(--rc-primary);
  }
  .story-metric small {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    color: var(--rc-muted);
  }

  .story-card blockquote {
    margin: 16px 0 22px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--rc-body);
    flex: 1;
  }

  .story-card footer {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .story-avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--rc-primary);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
  }
  .story-card footer b {
    display: block;
    font-family: var(--font-heading);
    font-size: 14px;
    color: var(--rc-ink);
    line-height: 1.3;
  }
  .story-card footer small {
    font-size: 12px;
    color: var(--rc-muted);
  }

  @media (max-width: 900px) {
    .story-grid,
    .story-grid[data-cols="2"] {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin: 0 auto;
    }
  }
</style>
