---
import { Icon } from "astro-icon/components";
import testimonialsData from "~/data/testimonials.json";
import site from "~/data/site.json";

interface Testimonial {
  name: string;
  site?: string;
  rating?: number;
  quote: string;
}
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  source?: "global" | "inline";
  limit?: number;
  items?: Testimonial[];
}
const {
  eyebrow = "Reviews",
  title = "Loved by website owners",
  subtitle,
  source = "global",
  limit,
  items,
} = Astro.props;

let list: Testimonial[] =
  source === "inline" && items?.length
    ? items
    : (testimonialsData.items as Testimonial[]);
if (limit) list = list.slice(0, limit);

// middle card of each row of three gets the spotlight treatment
const featured = (i: number) => i % 3 === 1;

const initials = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();
---

<section class="testi-sec cv-auto">
  <div class="wrap">
    <div class="sec-head center reveal">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {title && <h2 set:html={title} />}
      {subtitle && <p set:html={subtitle} />}
    </div>

    <div class="t-score reveal">
      <strong class="t-num">{site.rating}<em>/{site.ratingMax}</em></strong>
      <span class="t-stars" aria-hidden="true">
        {
          Array.from({ length: 5 }).map(() => (
            <Icon name="tabler:star-filled" />
          ))
        }
      </span>
      <span class="t-cap">
        Average rating from our customers — real sites, real reviews
      </span>
    </div>

    <div class="testi-grid slider">
      {
        list.map((t, i) => (
          <div
            class={`card testi reveal rv-scale reveal-d${(i % 3) + 1} ${featured(i) ? "t-feat" : ""}`}
          >
            <div class="stars" aria-label={`${t.rating ?? 5} out of 5 stars`}>
              {Array.from({ length: t.rating ?? 5 }).map(() => (
                <Icon name="tabler:star-filled" />
              ))}
            </div>
            <blockquote>“{t.quote}”</blockquote>
            <div class="who">
              <span class="avatar">
                {initials(t.name)}
                {t.site && (
                  <img
                    class="avatar-logo"
                    src={`https://www.google.com/s2/favicons?domain=${t.site}&sz=64`}
                    alt=""
                    width="38"
                    height="38"
                    loading="lazy"
                  />
                )}
              </span>
              <div>
                <div class="name">{t.name}</div>
                {t.site && <div class="site">{t.site}</div>}
              </div>
              <span class="t-check" title="Verified customer">
                <Icon name="tabler:discount-check-filled" />
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* rating banner above the cards */
  .t-score {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: -16px auto 36px;
  }
  .t-num {
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 700;
    color: var(--rc-ink);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .t-num em {
    font-style: normal;
    font-size: 20px;
    color: var(--text-muted);
    font-weight: 700;
  }
  .t-stars {
    display: inline-flex;
    gap: 3px;
    color: var(--rc-yellow);
  }
  .t-stars :global(svg) {
    width: 22px;
    height: 22px;
    filter: drop-shadow(0 2px 3px rgba(200, 170, 0, 0.35));
  }
  .t-cap {
    font-size: 13.5px;
    color: var(--text-muted);
  }

  /* spotlight card: brand gradient, lifts above its neighbours */
  .testi.t-feat {
    background: var(--rc-grad-vivid);
    border: none;
  }
  .testi.t-feat :global(blockquote),
  .testi.t-feat :global(.name) {
    color: #fff;
  }
  .testi.t-feat :global(.site) {
    color: rgba(255, 255, 255, 0.7);
  }
  .testi.t-feat :global(.stars) {
    color: var(--rc-yellow);
  }
  .testi.t-feat::after {
    color: rgba(255, 255, 255, 0.14);
  }
  .testi.t-feat :global(.avatar) {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
  }
  @media (min-width: 901px) {
    .testi.t-feat {
      transform: translateY(-10px);
      box-shadow: var(--shadow-lg);
    }
    .testi.t-feat:hover {
      transform: translateY(-14px);
    }
  }

  /* real site favicon over the initials; initials show through if the
     favicon fails or is a blank placeholder */
  .who :global(.avatar) {
    position: relative;
  }
  .avatar-logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    padding: 7px;
    background: #fff;
    border: 1.5px solid var(--line);
  }
  .testi.t-feat .avatar-logo {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .t-check {
    margin-left: auto;
    color: var(--rc-blue);
    display: inline-flex;
  }
  .t-check :global(svg) {
    width: 20px;
    height: 20px;
  }
  .testi.t-feat .t-check {
    color: var(--rc-yellow);
  }

  @media (max-width: 560px) {
    .t-num {
      font-size: 36px;
    }
    .t-score {
      margin-bottom: 28px;
    }
  }
</style>
