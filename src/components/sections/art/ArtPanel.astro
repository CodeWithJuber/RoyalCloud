---
/**
 * Control-panel scene, a browser frame around an original dashboard mock:
 * sidebar nav, stat cards, a traffic area chart and resource meters.
 */
---

<div class="pnl-scene" aria-hidden="true">
  <div class="pnl-browser">
    <div class="pnl-bar">
      <i></i><i></i><i></i>
      <span class="pnl-url">panel.royalclouds.net</span>
    </div>
    <div class="pnl-app">
      <aside class="pnl-side">
        <span class="pnl-logo"></span>
        <i class="nav on"></i>
        <i class="nav"></i>
        <i class="nav"></i>
        <i class="nav"></i>
      </aside>
      <div class="pnl-main">
        <div class="pnl-cards">
          <div class="pc">
            <small>Visitors</small>
            <b>12.4k</b>
            <em class="up">▲ 18%</em>
          </div>
          <div class="pc">
            <small>SSL</small>
            <b class="ok-text">Active</b>
            <em>auto-renews</em>
          </div>
        </div>
        <svg class="pnl-chart" viewBox="0 0 260 70" fill="none">
          <path
            class="pnl-line"
            d="M0 56 C 30 56 36 38 62 38 C 88 38 94 50 120 50 C 150 50 156 22 186 22 C 214 22 222 34 260 30"
            stroke="var(--theme-art-a, #7652f2)"
            stroke-width="3"
            stroke-linecap="round"></path>
          <path
            d="M0 56 C 30 56 36 38 62 38 C 88 38 94 50 120 50 C 150 50 156 22 186 22 C 214 22 222 34 260 30 L 260 70 L 0 70 Z"
            fill="var(--theme-art-a, #7652f2)"
            opacity="0.1"></path>
        </svg>
        <div class="pnl-meters">
          <div class="m"><small>CPU</small><span><i style="width: 26%"></i></span></div>
          <div class="m"><small>RAM</small><span><i style="width: 44%"></i></span></div>
        </div>
      </div>
    </div>
  </div>
  <div class="pnl-chip">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
    One-click everything
  </div>
</div>

<style>
  .pnl-scene {
    position: relative;
    width: min(440px, 100%);
  }
  .pnl-browser {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .pnl-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    background: #fbfaff;
  }
  .pnl-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .pnl-bar i:first-child { background: var(--rc-primary); }
  .pnl-bar i:nth-child(2) { background: var(--rc-gold); }
  .pnl-bar i:nth-child(3) { background: var(--ok); }
  .pnl-url {
    margin-left: 10px;
    font-size: 11.5px;
    color: var(--text-muted);
    background: var(--bg-tint);
    border-radius: 6px;
    padding: 3px 12px;
  }
  .pnl-app {
    display: flex;
  }
  .pnl-side {
    width: 52px;
    background: var(--bg-tint);
    padding: 14px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .pnl-logo {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--theme-art-a, #7652f2), var(--theme-art-b, #00a7f5));
    margin-bottom: 6px;
  }
  .pnl-side .nav {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: var(--line-strong);
    opacity: 0.55;
  }
  .pnl-side .nav.on {
    background: var(--theme-art-a, #7652f2);
    opacity: 1;
  }
  .pnl-main {
    flex: 1;
    padding: 14px 16px 16px;
  }
  .pnl-cards {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
  }
  .pc {
    flex: 1;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 10px 12px;
    box-shadow: var(--shadow-xs);
  }
  .pc small {
    display: block;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .pc b {
    font-family: var(--font-heading);
    font-size: 17px;
    color: var(--rc-ink);
  }
  .pc b.ok-text {
    color: #0e9f6e;
  }
  .pc em {
    display: block;
    font-style: normal;
    font-size: 10.5px;
    color: var(--text-muted);
  }
  .pc em.up {
    color: #0e9f6e;
    font-weight: 600;
  }
  .pnl-chart {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 12px;
  }
  .pnl-meters .m {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 7px;
  }
  .pnl-meters small {
    width: 30px;
    font-size: 10px;
    color: var(--text-muted);
  }
  .pnl-meters span {
    flex: 1;
    height: 7px;
    border-radius: 4px;
    background: var(--bg-tint-strong);
    overflow: hidden;
    display: block;
  }
  .pnl-meters i {
    display: block;
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--theme-art-a, #7652f2), var(--theme-art-b, #00a7f5));
  }
  .pnl-chip {
    position: absolute;
    right: -12px;
    bottom: -16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 18px;
    font-family: var(--font-heading);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--rc-ink);
    box-shadow: var(--shadow-md);
  }
  .pnl-chip svg {
    width: 16px;
    height: 16px;
    color: var(--theme-art-a, #7652f2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pnl-line {
      stroke-dasharray: 340;
      stroke-dashoffset: 340;
      animation: pnlDraw 2s cubic-bezier(0.4, 0, 0.2, 1) 0.4s forwards;
    }
    .pnl-meters i {
      transform: scaleX(0);
      transform-origin: left;
      animation: pnlMeter 1.1s cubic-bezier(0.3, 0, 0.2, 1) 0.8s forwards;
    }
    .pnl-chip {
      animation: pnlFloat 7s ease-in-out infinite 0.8s;
    }
    @keyframes pnlDraw {
      to {
        stroke-dashoffset: 0;
      }
    }
    @keyframes pnlMeter {
      to {
        transform: scaleX(1);
      }
    }
    @keyframes pnlFloat {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }
  }
  @media (max-width: 560px) {
    .pnl-side {
      width: 42px;
    }
    .pnl-chip {
      right: 0;
      bottom: -14px;
    }
  }
</style>
