---
/**
 * Speed scene — a gauge card whose needle sweeps and arc fills on load,
 * with a hand-drawn rocket climbing past it. Recolors via --theme-art-a/b.
 */
---

<div class="rkt-scene" aria-hidden="true">
  <div class="gauge-card">
    <svg class="gauge" viewBox="0 0 220 130">
      <defs>
        <linearGradient id="rcrkt-arc" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" stop-color="var(--theme-art-a, #f59e0b)"></stop>
          <stop offset="1" stop-color="var(--theme-art-b, #f43f5e)"></stop>
        </linearGradient>
      </defs>
      <path
        d="M 20 120 A 90 90 0 0 1 200 120"
        fill="none"
        stroke="var(--bg-tint-strong)"
        stroke-width="14"
        stroke-linecap="round"></path>
      <path
        class="arc-fill"
        d="M 20 120 A 90 90 0 0 1 200 120"
        fill="none"
        stroke="url(#rcrkt-arc)"
        stroke-width="14"
        stroke-linecap="round"></path>
      <g class="needle">
        <line x1="110" y1="120" x2="110" y2="48" stroke="var(--rc-ink)" stroke-width="4" stroke-linecap="round"></line>
        <circle cx="110" cy="120" r="8" fill="var(--rc-ink)"></circle>
      </g>
    </svg>
    <strong class="reading">0.4s</strong>
    <small>Avg. page load on Royal Clouds</small>
  </div>

  <svg class="rocket" viewBox="0 0 64 84" fill="none">
    <path
      d="M32 4c10 8 14 20 14 32 0 8-2 15-5 21H23c-3-6-5-13-5-21C18 24 22 12 32 4Z"
      fill="url(#rcrkt-body)"></path>
    <circle cx="32" cy="30" r="7" fill="#fff" stroke="var(--rc-ink)" stroke-width="2.5"></circle>
    <path d="M18 44 8 58l12-2" fill="var(--theme-art-b, #f43f5e)"></path>
    <path d="M46 44l10 14-12-2" fill="var(--theme-art-b, #f43f5e)"></path>
    <path class="flame" d="M27 60c0 6 2 11 5 16 3-5 5-10 5-16h-10Z" fill="var(--rc-yellow)"></path>
    <defs>
      <linearGradient id="rcrkt-body" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--theme-art-a, #f59e0b)"></stop>
        <stop offset="1" stop-color="var(--theme-art-b, #f43f5e)"></stop>
      </linearGradient>
    </defs>
  </svg>
  <i class="trail t1"></i>
  <i class="trail t2"></i>
  <i class="trail t3"></i>

  <div class="speed-chip">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"></path>
    </svg>
    <span><b>15x faster</b><small>SSD + LiteSpeed</small></span>
  </div>
</div>

<style>
  .rkt-scene {
    position: relative;
    width: min(420px, 100%);
    display: flex;
    justify-content: center;
    padding: 30px 0 26px;
  }
  .gauge-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
    padding: 26px 30px 22px;
    text-align: center;
    width: min(300px, 84%);
  }
  .gauge {
    display: block;
    width: 100%;
    height: auto;
  }
  .reading {
    display: block;
    font-family: var(--font-heading);
    font-size: 34px;
    font-weight: 700;
    color: var(--rc-ink);
    margin-top: -34px;
  }
  .gauge-card small {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 6px;
  }
  .arc-fill {
    stroke-dasharray: 283;
    stroke-dashoffset: 113; /* fills 60% of the arc */
  }
  .needle {
    transform-origin: 110px 120px;
    transform: rotate(18deg); /* matches the 60% fill */
  }
  .rocket {
    position: absolute;
    width: 74px;
    height: auto;
    right: 2px;
    top: -6px;
    transform: rotate(14deg);
    filter: drop-shadow(0 14px 18px rgba(10, 14, 31, 0.22));
  }
  .trail {
    position: absolute;
    width: 26px;
    height: 4px;
    border-radius: 4px;
    background: var(--theme-art-a, #f59e0b);
    opacity: 0.35;
  }
  .t1 { right: 78px; top: 34px; }
  .t2 { right: 92px; top: 50px; width: 18px; opacity: 0.22; }
  .t3 { right: 70px; top: 66px; width: 12px; opacity: 0.16; }

  .speed-chip {
    position: absolute;
    left: -8px;
    bottom: -6px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 11px 16px;
    box-shadow: var(--shadow-md);
  }
  .speed-chip svg {
    width: 18px;
    height: 18px;
    color: var(--theme-art-b, #f43f5e);
  }
  .speed-chip b {
    display: block;
    font-family: var(--font-heading);
    font-size: 14.5px;
    font-weight: 700;
    color: var(--rc-ink);
    line-height: 1.2;
  }
  .speed-chip small {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .arc-fill {
      stroke-dashoffset: 283;
      animation: rktArc 1.6s cubic-bezier(0.3, 0, 0.2, 1) 0.3s forwards;
    }
    .needle {
      transform: rotate(-88deg);
      animation: rktNeedle 1.6s cubic-bezier(0.3, 0, 0.3, 1.18) 0.3s forwards;
    }
    .rocket {
      animation: rktFly 6s ease-in-out infinite;
    }
    .speed-chip {
      animation: rktFloat 7.5s ease-in-out infinite 0.6s;
    }
    .flame {
      animation: rktFlame 0.5s ease-in-out infinite alternate;
      transform-origin: 32px 60px;
    }
    @keyframes rktArc {
      to {
        stroke-dashoffset: 113;
      }
    }
    @keyframes rktNeedle {
      to {
        transform: rotate(18deg);
      }
    }
    @keyframes rktFly {
      0%,
      100% {
        transform: rotate(14deg) translateY(0);
      }
      50% {
        transform: rotate(14deg) translateY(-12px);
      }
    }
    @keyframes rktFloat {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }
    @keyframes rktFlame {
      to {
        transform: scaleY(1.25);
      }
    }
  }
  @media (max-width: 560px) {
    .rocket {
      width: 58px;
      right: -2px;
    }
    .speed-chip {
      left: 0;
    }
  }
</style>
