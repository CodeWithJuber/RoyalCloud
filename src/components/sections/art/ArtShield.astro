---
/**
 * Security scene — gradient shield inside dashed orbit rings with
 * slowly revolving status dots and proof chips.
 */
---

<div class="shl-scene" aria-hidden="true">
  <div class="shl-rings">
    <span class="ring r1"></span>
    <span class="ring r2"></span>
    <span class="orbit o1">
      <i class="sat sat-ok"></i>
    </span>
    <span class="orbit o2">
      <i class="sat sat-blue"></i>
    </span>
    <svg class="shield" viewBox="0 0 96 112" fill="none">
      <defs>
        <linearGradient id="rcshld-g" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="var(--theme-art-a, #0e9f6e)"></stop>
          <stop offset="1" stop-color="var(--theme-art-b, #00a7f5)"></stop>
        </linearGradient>
      </defs>
      <path
        d="M48 4 88 18v34c0 26-17 46-40 54C25 98 8 78 8 52V18L48 4Z"
        fill="url(#rcshld-g)"></path>
      <path
        d="M32 54l11 11 21-22"
        stroke="#fff"
        stroke-width="7"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
  <div class="shl-chip shl-chip-a">
    <b>1M+</b>
    <small>attacks blocked daily</small>
  </div>
  <div class="shl-chip shl-chip-b">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="11" width="16" height="10" rx="2"></rect>
      <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
    </svg>
    Free SSL · DDoS shield
  </div>
</div>

<style>
  .shl-scene {
    position: relative;
    width: min(380px, 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 330px;
  }
  .shl-rings {
    position: relative;
    width: 280px;
    height: 280px;
    display: grid;
    place-items: center;
  }
  .ring {
    position: absolute;
    border-radius: 50%;
  }
  .r1 {
    inset: 0;
    border: 1.5px dashed color-mix(in srgb, var(--theme-art-a, #0e9f6e) 45%, transparent);
  }
  .r2 {
    inset: 42px;
    border: 1.5px solid color-mix(in srgb, var(--theme-art-a, #0e9f6e) 25%, transparent);
  }
  .orbit {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .o2 {
    inset: 42px;
  }
  .sat {
    position: absolute;
    top: -7px;
    left: calc(50% - 7px);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 3px solid #fff;
    box-shadow: var(--shadow-sm);
  }
  .sat-ok {
    background: var(--ok);
  }
  .sat-blue {
    background: var(--theme-art-b, #00a7f5);
  }
  .shield {
    width: 120px;
    height: auto;
    filter: drop-shadow(0 20px 26px rgba(34, 16, 95, 0.25));
    position: relative;
    z-index: 1;
  }
  .shl-chip {
    position: absolute;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 11px 16px;
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-heading);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--rc-ink);
    z-index: 2;
  }
  .shl-chip-a {
    top: 18px;
    left: -6px;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
  }
  .shl-chip-a b {
    font-size: 18px;
  }
  .shl-chip-a small {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 11px;
    color: var(--text-muted);
  }
  .shl-chip-b {
    bottom: 12px;
    right: -4px;
  }
  .shl-chip-b svg {
    width: 16px;
    height: 16px;
    color: var(--theme-art-a, #0e9f6e);
  }

  @media (prefers-reduced-motion: no-preference) {
    .orbit {
      animation: shlSpin 16s linear infinite;
    }
    .o2 {
      animation-duration: 11s;
      animation-direction: reverse;
    }
    .shield {
      animation: shlFloat 6.5s ease-in-out infinite;
    }
    .shl-chip-a {
      animation: shlFloat 7.5s ease-in-out infinite 0.7s;
    }
    .shl-chip-b {
      animation: shlFloat 8.5s ease-in-out infinite 1.4s;
    }
    @keyframes shlSpin {
      to {
        transform: rotate(360deg);
      }
    }
    @keyframes shlFloat {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-9px);
      }
    }
  }
  @media (max-width: 560px) {
    .shl-rings {
      width: 240px;
      height: 240px;
    }
    .shield {
      width: 104px;
    }
    .shl-chip-a {
      left: -2px;
    }
    .shl-chip-b {
      right: 0;
    }
  }
</style>
