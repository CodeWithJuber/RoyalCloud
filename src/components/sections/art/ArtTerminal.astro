---
/**
 * Terminal scene, dark console window with typed commands and a blinking
 * cursor. `flavor` switches the distro story (ubuntu, debian, centos,
 * fedora, opensuse, scientific) so every Linux landing page reads native.
 */
interface Props {
  flavor?: string;
}
const { flavor = "linux" } = Astro.props;

const FLAVORS: Record<string, { title: string; lines: string[]; chip: string }> = {
  linux: {
    title: "root@royal-vps: ~",
    lines: ["$ ssh root@your-vps", "Linux kernel 6.x, KVM virtualized", "$ uptime", "up 412 days · load 0.08"],
    chip: "Full root access",
  },
  ubuntu: {
    title: "root@ubuntu-vps: ~",
    lines: ["$ ssh root@your-vps", "Welcome to Ubuntu 24.04 LTS", "$ apt install nginx -y", "✓ nginx active in 0.6s"],
    chip: "Ubuntu 24.04 LTS",
  },
  debian: {
    title: "root@debian-vps: ~",
    lines: ["$ ssh root@your-vps", "Debian GNU/Linux 12 (bookworm)", "$ apt install mariadb-server", "✓ rock-solid stable", ],
    chip: "Debian 12 stable",
  },
  centos: {
    title: "root@centos-vps: ~",
    lines: ["$ ssh root@your-vps", "CentOS / AlmaLinux 9 ready", "$ dnf install httpd -y", "✓ enterprise-grade base"],
    chip: "RHEL-compatible",
  },
  fedora: {
    title: "root@fedora-vps: ~",
    lines: ["$ ssh root@your-vps", "Fedora Server, latest stack", "$ dnf install podman -y", "✓ cutting-edge packages"],
    chip: "Latest packages",
  },
  opensuse: {
    title: "root@opensuse-vps: ~",
    lines: ["$ ssh root@your-vps", "openSUSE Leap installed", "$ zypper install nginx", "✓ YaST + snapshots ready"],
    chip: "Btrfs snapshots",
  },
  scientific: {
    title: "root@sci-vps: ~",
    lines: ["$ ssh root@your-vps", "Scientific Linux environment", "$ module load python/3.12", "✓ research stack ready"],
    chip: "Research-ready",
  },
};
const t = FLAVORS[flavor] ?? FLAVORS.linux;
---

<div class="term-scene" aria-hidden="true">
  <div class="term">
    <div class="term-bar">
      <i></i><i></i><i></i>
      <span class="term-title">{t.title}</span>
    </div>
    <div class="term-body">
      {
        t.lines.map((line, i) => (
          <p class={`tl tl-${i + 1} ${line.startsWith("$") ? "cmd" : ""} ${line.startsWith("✓") ? "ok" : ""}`}>
            {line}
          </p>
        ))
      }
      <p class="tl tl-5 cmd">$ <span class="cursor"></span></p>
    </div>
  </div>
  <div class="term-chip">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line>
    </svg>
    {t.chip}
  </div>
</div>

<style>
  .term-scene {
    position: relative;
    width: min(420px, 100%);
  }
  .term {
    background: #18103d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 14px;
    background: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .term-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }
  .term-bar i:first-child {
    background: var(--rc-coral);
  }
  .term-bar i:nth-child(2) {
    background: var(--rc-yellow);
  }
  .term-bar i:nth-child(3) {
    background: var(--ok);
  }
  .term-title {
    margin-left: 10px;
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.55);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  .term-body {
    padding: 20px 20px 24px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 13.5px;
    line-height: 1.5;
  }
  .tl {
    margin: 0 0 10px;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
    overflow: hidden;
  }
  .tl.cmd {
    color: #fff;
  }
  .tl.cmd::first-letter {
    color: var(--theme-art-a, #0f9b8e);
  }
  .tl.ok {
    color: #4ade80;
  }
  .cursor {
    display: inline-block;
    width: 9px;
    height: 16px;
    vertical-align: -3px;
    background: var(--theme-art-a, #0f9b8e);
  }
  .term-chip {
    position: absolute;
    right: -14px;
    bottom: -18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 18px;
    font-family: var(--font-heading);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--rc-ink);
    box-shadow: var(--shadow-md);
  }
  .term-chip svg {
    width: 16px;
    height: 16px;
    color: var(--theme-art-a, #0f9b8e);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tl {
      max-width: 0;
      animation: termType 0.55s steps(24, end) forwards;
    }
    .tl-1 { animation-delay: 0.2s; }
    .tl-2 { animation-delay: 0.9s; }
    .tl-3 { animation-delay: 1.6s; }
    .tl-4 { animation-delay: 2.3s; }
    .tl-5 { animation-delay: 2.9s; }
    .cursor {
      animation: termBlink 1.1s steps(1) infinite;
    }
    .term-chip {
      animation: artFloat 7s ease-in-out infinite 0.8s;
    }
    @keyframes termType {
      to {
        max-width: 100%;
      }
    }
    @keyframes termBlink {
      50% {
        opacity: 0;
      }
    }
    @keyframes artFloat {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }
  }
  @media (max-width: 560px) {
    .term-body {
      font-size: 12px;
      padding: 16px 14px 20px;
    }
    .term-chip {
      right: 0;
      bottom: -14px;
    }
  }
</style>
