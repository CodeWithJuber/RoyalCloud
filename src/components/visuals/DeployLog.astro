---
/* Deploy Log (DESIGN.md 8.7) — a monospace ticker of a real deploy.
   Lines are passed in, never invented here: this renders a transcript, it does not
   claim one. A caller with no real deploy output should not render it (DESIGN.md 11). */
export interface LogLine {
  kind: "cmd" | "out" | "ok";
  text: string;
}

interface Props {
  title?: string;
  lines: LogLine[];
  class?: string;
}

const { title = "deploy", lines, class: className } = Astro.props;

const PREFIX: Record<LogLine["kind"], string> = { cmd: "$ ", out: "  ", ok: "✓ " };
const TOKEN: Record<LogLine["kind"], string> = { cmd: "tok-cmd", out: "tok-dim", ok: "tok-ok" };
---

<div class:list={["terminal", className]}>
  <div class="terminal-bar">
    <span class="terminal-dot" aria-hidden="true"></span>
    <span class="terminal-dot" aria-hidden="true"></span>
    <span class="terminal-dot" aria-hidden="true"></span>
    <span class="terminal-title">{title}</span>
  </div>

  {/* Each line is its own block, so no literal newlines are needed — which also
      keeps this out of <pre>, where Astro cannot parse nested expressions. */}
  <div class="terminal-body">
    {
      lines.map((line, index) => (
        <code class:list={["line", TOKEN[line.kind]]} style={`--i:${index}`}>
          {PREFIX[line.kind]}
          {line.text}
        </code>
      ))
    }
  </div>
</div>

<style>
  .line {
    display: block;
  }

  /* The log types itself in on reveal — opacity only, staggered. Nothing moves
     layout, and every line is in the DOM whether or not JS runs. */
  [data-js="true"] [data-reveal] .line {
    opacity: 0;
  }
  [data-reveal][data-visible="true"] .line {
    animation: log-in 400ms var(--ease) forwards;
    animation-delay: calc(var(--i) * 90ms);
  }
  @keyframes log-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-js="true"] [data-reveal] .line,
    [data-reveal][data-visible="true"] .line {
      opacity: 1;
      animation: none;
    }
  }
</style>
