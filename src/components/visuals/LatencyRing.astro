---
interface Props {
  label: string;
  value: number;
  unit: string;
  max?: number;
  class?: string;
}

// The caller owns the number. We never derive, round or invent it — we only
// place it on a scale. `max` is the scale ceiling, not a claim about the data.
const { label, value, unit, max = 100, class: className } = Astro.props;

const ceiling = max > 0 ? max : 100;
const fraction = Math.min(1, Math.max(0, value / ceiling));
const percent = (fraction * 100).toFixed(2);
---

<figure class:list={["latency-ring", className]} data-reveal style={`--pct:${percent}`}>
  <svg viewBox="0 0 120 120" role="img" focusable="false">
    <title>{label}: {value}{unit}</title>
    <desc>Measured {label} of {value}{unit}, shown against a scale of 0 to {ceiling}{unit}.</desc>

    <g transform="rotate(-90 60 60)">
      <circle class="ring-track" cx="60" cy="60" r="50" pathLength="100" />
      <circle class="ring-arc" cx="60" cy="60" r="50" pathLength="100" />
    </g>

    <text class="ring-readout" x="60" y="60" text-anchor="middle" dominant-baseline="central">
      {value}<tspan class="ring-unit">{unit}</tspan>
    </text>
  </svg>

  <figcaption class="ring-label">{label}</figcaption>
</figure>

<style>
  .latency-ring {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: min(100%, 200px);
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .ring-track {
    fill: none;
    stroke: var(--viz-line-soft);
    stroke-width: 7;
    opacity: 0.35;
  }

  .ring-arc {
    fill: none;
    stroke: var(--viz-line);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 100 100;
    stroke-dashoffset: calc(100 - var(--pct, 0));
    transition: stroke-dashoffset 900ms var(--ease);
  }

  /* Settle only when JS is present; with no script the arc is already correct. */
  [data-js="true"] .latency-ring[data-reveal] .ring-arc {
    stroke-dashoffset: 100;
  }

  .latency-ring[data-reveal][data-visible="true"] .ring-arc {
    stroke-dashoffset: calc(100 - var(--pct, 0));
  }

  .ring-readout {
    fill: var(--heading);
    font-family: var(--font-mono);
    font-size: 25px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .ring-unit {
    font-size: 13px;
    fill: var(--muted);
    letter-spacing: 0;
  }

  .ring-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 720;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--viz-label);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .ring-arc {
      transition: none;
    }

    [data-js="true"] .latency-ring[data-reveal] .ring-arc {
      stroke-dashoffset: calc(100 - var(--pct, 0));
    }
  }
</style>
