---
interface Props { label?: string }
const { label = "Royal Clouds" } = Astro.props;
const instanceId = `royal-cloudscape-${Math.random().toString(36).slice(2, 10)}`;
const titleId = `${instanceId}-title`;
const descriptionId = `${instanceId}-description`;
---

<figure class="cloudscape">
  <svg
    viewBox="0 0 880 650"
    role="img"
    aria-labelledby={`${titleId} ${descriptionId}`}
    preserveAspectRatio="xMidYMid meet"
  >
    <title id={titleId}>{label} orbital compute landscape</title>
    <desc id={descriptionId}>
      An isometric infrastructure system showing a central compute core, connected storage planes,
      protected edge nodes, and routed global traffic.
    </desc>

    <g class="coordinates" aria-hidden="true">
      <path d="M58 490 438 270 820 490 440 710Z" />
      <path d="M106 518 438 326 772 518" />
      <path d="M155 546 438 382 723 546" />
      <path d="M204 574 438 438 674 574" />
      <path d="M253 602 438 494 625 602" />
      <path d="M303 630 438 550 575 630" />
      <path d="M106 462 487 682M155 434 536 654M204 406 585 626M253 378 634 598M302 350 683 570M351 322 732 542" />
      <path d="M770 462 389 682M721 434 340 654M672 406 291 626M623 378 242 598M574 350 193 570M525 322 144 542" />
    </g>

    <g class="orbit orbit--outer" aria-hidden="true">
      <ellipse cx="440" cy="332" rx="330" ry="146" />
      <circle class="orbit-node orbit-node--signal" cx="142" cy="395" r="7" />
      <circle class="orbit-node" cx="716" cy="245" r="5" />
    </g>
    <g class="orbit orbit--inner" aria-hidden="true">
      <ellipse cx="440" cy="332" rx="229" ry="101" />
      <circle class="orbit-node" cx="617" cy="268" r="5" />
      <circle class="orbit-node orbit-node--signal" cx="277" cy="401" r="6" />
    </g>

    <g class="edge-sites" aria-hidden="true">
      <g class="edge-site edge-site--one">
        <path class="site-stem" d="M150 397v-84" />
        <path class="site-top" d="m118 296 32-18 32 18-32 18Z" />
        <path class="site-side site-side--dark" d="m118 296 32 18v39l-32-18Z" />
        <path class="site-side" d="m182 296-32 18v39l32-18Z" />
        <circle cx="150" cy="330" r="4" />
      </g>
      <g class="edge-site edge-site--two">
        <path class="site-stem" d="M716 245v-92" />
        <path class="site-top" d="m684 136 32-18 32 18-32 18Z" />
        <path class="site-side site-side--dark" d="m684 136 32 18v39l-32-18Z" />
        <path class="site-side" d="m748 136-32 18v39l32-18Z" />
        <circle cx="716" cy="170" r="4" />
      </g>
      <g class="edge-site edge-site--three">
        <path class="site-stem" d="M617 268v-58" />
        <path class="site-top" d="m593 197 24-14 24 14-24 14Z" />
        <path class="site-side site-side--dark" d="m593 197 24 14v29l-24-14Z" />
        <path class="site-side" d="m641 197-24 14v29l24-14Z" />
      </g>
    </g>

    <g class="platform platform--lower" aria-hidden="true">
      <path class="platform-shadow" d="m228 454 210-122 215 124-210 123Z" />
      <path class="platform-top" d="m213 425 225-130 230 132-225 131Z" />
      <path class="platform-left" d="m213 425 230 133v49L213 474Z" />
      <path class="platform-right" d="m668 427-225 131v49l225-131Z" />
      <path class="platform-trace" d="m281 426 157-91 162 93-157 92Z" />
      <path class="platform-trace platform-trace--hot" d="m339 425 99-57 103 59-99 58Z" />
    </g>

    <g class="data-columns" aria-hidden="true">
      <g class="data-column data-column--left">
        <path d="m292 396 36-21 37 22-36 21Z" />
        <path d="m292 396 37 22v52l-37-22Z" />
        <path d="m365 397-36 21v52l36-21Z" />
        <path class="column-light" d="M304 410v25M316 417v25" />
      </g>
      <g class="data-column data-column--right">
        <path d="m512 398 36-21 37 22-36 21Z" />
        <path d="m512 398 37 22v52l-37-22Z" />
        <path d="m585 399-36 21v52l36-21Z" />
        <path class="column-light" d="M561 413v25M573 406v25" />
      </g>
    </g>

    <g class="compute-core" aria-hidden="true">
      <path class="core-aura" d="m350 299 88-51 91 52-89 52Z" />
      <path class="core-top" d="m362 278 76-44 79 45-78 45Z" />
      <path class="core-left" d="m362 278 77 46v94l-77-45Z" />
      <path class="core-right" d="m517 279-78 45v94l78-45Z" />
      <path class="core-window" d="m385 302 35 21v48l-35-21Z" />
      <path class="core-window" d="m458 322 36-21v49l-36 20Z" />
      <path class="core-slot" d="m378 284 60-35 63 36-62 36Z" />
      <path class="core-signal" d="m424 274 14-8 15 9-15 8Z" />
    </g>

    <g class="route-lines" aria-hidden="true">
      <path d="M150 313 362 278M517 279l199-143M517 373l100-57M329 470l-62 36M549 472l66 38" />
      <circle cx="267" cy="506" r="6" />
      <circle cx="615" cy="510" r="6" />
    </g>

    <g class="telemetry" aria-hidden="true">
      <g transform="translate(70 162)">
        <path d="M0 0h126" />
        <circle cx="0" cy="0" r="4" />
        <text x="0" y="-14">EDGE / 03</text>
      </g>
      <g transform="translate(660 516)">
        <path d="M0 0h150" />
        <circle cx="150" cy="0" r="4" />
        <text x="28" y="-14">CORE / RC-01</text>
      </g>
      <text class="axis-label" x="58" y="535">X / 25.2048</text>
      <text class="axis-label" x="736" y="535">Y / 55.2708</text>
    </g>
  </svg>
</figure>

<style>
  .cloudscape {
    width: 100%;
    margin: 0;
    color: var(--viz-face-top);
    container-type: inline-size;
    overflow: clip;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .coordinates path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.12;
  }

  .orbit {
    transform-box: fill-box;
    transform-origin: center;
  }

  .orbit ellipse {
    fill: none;
    stroke: var(--viz-line-soft);
    stroke-width: 1.2;
    stroke-dasharray: 5 10;
    opacity: 0.48;
  }

  .orbit--inner ellipse { opacity: 0.3; }

  .orbit-node {
    fill: var(--viz-recess);
    stroke: var(--viz-line-soft);
    stroke-width: 3;
    transform-box: fill-box;
    transform-origin: center;
  }

  .orbit-node--signal {
    fill: var(--viz-accent);
    stroke: color-mix(in srgb, var(--viz-accent) 30%, transparent);
    stroke-width: 7;
  }

  .site-stem,
  .route-lines path {
    fill: none;
    stroke: var(--viz-line-soft);
    stroke-width: 1.5;
    opacity: 0.65;
  }

  .site-top {
    fill: var(--viz-face-top);
    stroke: var(--viz-recess);
    stroke-width: 1;
  }

  .site-side { fill: var(--viz-face-right); }
  .site-side--dark { fill: var(--viz-face-left); }
  .edge-site circle { fill: var(--viz-accent); }

  .platform-shadow {
    fill: var(--viz-shadow);
    opacity: 0.42;
    transform: translateY(13px);
  }

  .platform-top {
    fill: var(--viz-face-top);
    stroke: var(--viz-face-top);
    stroke-width: 1.25;
  }

  .platform-left { fill: var(--viz-face-left); stroke: var(--viz-line-soft); stroke-width: 1; }
  .platform-right { fill: var(--viz-face-right); stroke: var(--viz-line); stroke-width: 1; }

  .platform-trace {
    fill: none;
    stroke: var(--viz-line-soft);
    stroke-width: 1;
    opacity: 0.75;
  }

  .platform-trace--hot { stroke: var(--viz-accent); opacity: 0.7; }

  .data-column path:not(.column-light) {
    fill: var(--viz-face-right);
    stroke: var(--viz-line);
    stroke-width: 0.9;
  }

  .data-column path:nth-child(2) { fill: var(--viz-recess); }
  .data-column path:nth-child(3) { fill: var(--viz-face-right); }

  .column-light {
    fill: none;
    stroke: var(--viz-accent);
    stroke-width: 2;
    opacity: 0.85;
  }

  .compute-core {
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  .core-aura {
    fill: var(--viz-line-soft);
    opacity: 0.14;
    transform: scale(1.18);
    transform-origin: center;
    transform-box: fill-box;
  }

  .core-top { fill: var(--viz-face-top); stroke: var(--viz-line-soft); stroke-width: 1.2; }
  .core-left { fill: var(--viz-face-left); stroke: var(--viz-line-soft); stroke-width: 1; }
  .core-right { fill: var(--viz-face-right); stroke: var(--viz-line); stroke-width: 1; }
  .core-window { fill: var(--viz-recess); stroke: var(--viz-line-soft); stroke-width: 1; }
  .core-slot { fill: var(--viz-face-left); stroke: var(--viz-line); stroke-width: 1; }
  .core-signal { fill: var(--viz-accent); }

  .route-lines circle {
    fill: var(--viz-accent);
    stroke: color-mix(in srgb, var(--viz-accent) 28%, transparent);
    stroke-width: 8;
  }

  .telemetry path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.48;
  }

  .telemetry circle { fill: var(--viz-accent); }

  .telemetry text,
  .axis-label {
    fill: var(--viz-label);
    font-family: var(--font-body, "Manrope Variable", sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .compute-core { animation: core-drift 6s ease-in-out infinite alternate; }
    .orbit--outer { animation: orbit-drift 13s ease-in-out infinite alternate; }
    .orbit--inner { animation: orbit-drift 9s ease-in-out infinite alternate-reverse; }
    .orbit-node--signal { animation: signal-pulse 2.8s ease-in-out infinite; }
    .edge-site--two { animation: site-drift 5.5s ease-in-out infinite alternate; }
  }

  @keyframes core-drift {
    from { transform: translateY(0); }
    to { transform: translateY(-10px); }
  }

  @keyframes orbit-drift {
    from { transform: translate(-2px, 0) rotate(-0.35deg); }
    to { transform: translate(3px, -4px) rotate(0.35deg); }
  }

  @keyframes site-drift {
    from { transform: translateY(0); }
    to { transform: translateY(-7px); }
  }

  @keyframes signal-pulse {
    0%, 100% { opacity: 0.55; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.18); }
  }

  @container (max-width: 560px) {
    svg { transform: scale(1.12); transform-origin: center; }
    .telemetry,
    .edge-site--three,
    .orbit--outer,
    .data-column--right { display: none; }
    .coordinates { opacity: 0.72; }
  }
</style>
