---
/* Royal Console frame (DESIGN.md 8.6, 7) — a double-bezel shell around a stylised
   rendering of the control panel. It is CHROME, not data: every row it shows is
   passed in by the caller. It never invents a metric: with no rows it renders as
   chrome around whatever real copy it was given, rather than filling the panel with
   plausible fiction (DESIGN.md 11). */
export interface ConsoleRow {
  label: string;
  value: string;
}

interface Props {
  label: string;
  caption?: string;
  rows?: ConsoleRow[];
  class?: string;
}

const { label, caption, rows = [], class: className } = Astro.props;
const hasRows = rows.length > 0;
---

<div class:list={["console", className]}>
  <div class="console-panel">
    <div class="console-bar">
      <span class="console-dots" aria-hidden="true">
        <span class="console-dot"></span>
        <span class="console-dot"></span>
        <span class="console-dot"></span>
      </span>
      <span class="console-label">{label}</span>
    </div>

    <div class="console-body">
      {caption && <p class="console-caption">{caption}</p>}

      {hasRows && (
        <dl class="console-rows">
          {rows.map((row, index) => (
            <div class="console-row" style={`--i:${index}`}>
              <dt class="console-row-label">{row.label}</dt>
              <dd class="console-row-value">{row.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {/* With a caption the console is pure chrome around real copy — nothing is
          missing, so it says nothing. The empty line is only for a frame that has
          genuinely nothing to show. */}
      {!hasRows && !caption && (
        <p class="console-empty">No readings published for this panel.</p>
      )}

      <slot />
    </div>
  </div>
</div>

<style>
  /* Outer bezel: 30px shell, 7px reveal, chrome hairline. Inner panel: 23px.
     The panel body is always --console-bg so the console reads the same on any
     semantic field; only the shell follows the field's --surface-card / --line. */
  .console {
    padding: 0.4375rem;
    border: 1px solid var(--line);
    border-radius: var(--r-shell);
    background: var(--surface-card);
    box-shadow: var(--sh-2);
  }

  .console-panel {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--chrome) 22%, transparent);
    border-radius: var(--r-inner);
    background: var(--console-bg, var(--midnight));
  }

  .console-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--chrome) 18%, transparent);
    background: color-mix(in srgb, var(--night) 55%, transparent);
  }

  .console-dots {
    display: flex;
    gap: 0.375rem;
  }
  .console-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--chrome) 45%, transparent);
  }

  .console-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--chrome);
    letter-spacing: 0.02em;
  }

  .console-body {
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .console-caption {
    margin: 0 0 1rem;
    max-width: 60ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--smoke);
  }
  /* Chrome-only console: caption is the last thing in the body, so it owns no gap. */
  .console-caption:last-child {
    margin-bottom: 0;
  }

  .console-rows {
    margin: 0;
  }

  /* Ledger rhythm: hairline-separated rows, label left, value right, tabular. */
  .console-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid color-mix(in srgb, var(--chrome) 14%, transparent);
  }
  .console-row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .console-row-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--smoke);
  }

  .console-row-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 550;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--ice);
  }

  .console-empty {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--chrome);
  }

  @media (max-width: 30rem) {
    .console-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    .console-row-value {
      text-align: left;
    }
  }

  /* Rows fade in on reveal; without JS or with reduced motion they are simply there. */
  [data-js="true"] [data-reveal] .console-row {
    opacity: 0;
  }
  [data-reveal][data-visible="true"] .console-row {
    animation: console-row-in 400ms var(--ease) forwards;
    animation-delay: calc(var(--i) * 70ms);
  }
  @keyframes console-row-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-js="true"] [data-reveal] .console-row,
    [data-reveal][data-visible="true"] .console-row {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
