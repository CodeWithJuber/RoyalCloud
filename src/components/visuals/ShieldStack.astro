---
/* Shield Stack (DESIGN.md 8.5) — the security layers as concentric plates.
   Reads only the --viz-* contract, so it renders correctly on light, night, and
   cobalt fields without knowing which one it sits on. */
interface Props {
  layers?: string[];
  class?: string;
}

const {
  layers = ["WAF", "DDoS scrub", "Malware scan", "Isolation", "Backup"],
  class: className
} = Astro.props;

const STEP = 26;
const OUTER = 320;
const CORE = OUTER - layers.length * STEP * 2;

const plates = layers.map((label, index) => ({
  label,
  origin: 20 + index * STEP,
  size: OUTER - index * STEP * 2,
  index
}));
---

<figure class:list={["shield", className]}>
  <svg viewBox="0 0 360 360" role="img" aria-labelledby="shield-title shield-desc">
    <title id="shield-title">The Royal Clouds protection stack</title>
    <desc id="shield-desc">
      Concentric protection layers around a workload, outermost first: {layers.join(", ")}.
    </desc>

    {
      plates.map((plate) => (
        <g class="plate-group" style={`--i:${plate.index}`}>
          <rect
            x={plate.origin}
            y={plate.origin}
            width={plate.size}
            height={plate.size}
            rx={30 - plate.index * 4}
            fill="none"
            stroke="var(--viz-line-soft)"
            stroke-width="1.5"
          />
          <text x={plate.origin + 14} y={plate.origin + 20} class="plate-label" fill="var(--viz-label)">
            {plate.label.toUpperCase()}
          </text>
        </g>
      ))
    }

    <rect
      x={20 + layers.length * STEP}
      y={20 + layers.length * STEP}
      width={CORE}
      height={CORE}
      rx="10"
      fill="var(--viz-face-right)"
    />
    <text x="180" y="184" text-anchor="middle" class="core-label" fill="var(--viz-recess)">WORKLOAD</text>
  </svg>
</figure>

<style>
  .shield {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
  }
  .plate-label {
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }
  .core-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 550;
    letter-spacing: 0.14em;
  }

  /* Ambient: plates breathe on a long, offset loop. Transform-only, >=40s per
     DESIGN.md 9 — it should read as a system idling, not as an animation. */
  .plate-group {
    transform-origin: 180px 180px;
    animation: breathe 44s var(--ease) infinite;
    animation-delay: calc(var(--i) * -3.5s);
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.012);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plate-group {
      animation: none;
    }
  }
</style>
