---
/**
 * Aurora Depth — client enhancements.
 * Builds accessible swipe-progress dots under the mobile carousels
 * (pricing, feature tiles, testimonials) so it's obvious the row
 * scrolls and where you are. Idempotent + view-transition safe.
 */
---

<script>
  function rcAuroraInit() {
    const carousels: Array<{ sel: string; wide?: boolean; card: string }> = [
      { sel: ".plan-grid", card: ".plan" },
      { sel: ".feature-grid.tiles", card: ".feature-card" },
      { sel: ".testi-grid.slider", card: ".testi", wide: true },
    ];

    carousels.forEach(({ sel, card, wide }) => {
      document.querySelectorAll<HTMLElement>(sel).forEach((track) => {
        if (track.dataset.rcDots) return;
        track.dataset.rcDots = "1";
        const cards = Array.from(track.querySelectorAll<HTMLElement>(card));
        if (cards.length < 2) return;

        const dots = document.createElement("div");
        dots.className = "rc-dots is-on";
        if (wide) dots.setAttribute("data-wide", "");
        dots.setAttribute("role", "tablist");
        dots.setAttribute("aria-label", "Carousel position");

        cards.forEach((c, i) => {
          const b = document.createElement("button");
          b.type = "button";
          b.setAttribute("aria-label", `Go to item ${i + 1}`);
          if (i === 0) b.setAttribute("aria-current", "true");
          b.addEventListener("click", () => {
            c.scrollIntoView({
              behavior: "smooth",
              inline: "center",
              block: "nearest",
            });
          });
          dots.appendChild(b);
        });
        track.insertAdjacentElement("afterend", dots);

        // Reflect the centered card in the active dot.
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.intersectionRatio > 0.6) {
                const idx = cards.indexOf(e.target as HTMLElement);
                dots.querySelectorAll("button").forEach((d, di) =>
                  di === idx
                    ? d.setAttribute("aria-current", "true")
                    : d.removeAttribute("aria-current"),
                );
              }
            });
          },
          { root: track, threshold: [0.6] },
        );
        cards.forEach((c) => io.observe(c));
      });
    });
  }
  // Scroll progress bar — a goal-gradient cue that the page is being consumed.
  function rcProgressInit() {
    const bar = document.querySelector<HTMLElement>(".rc-progress span");
    if (!bar) return;
    let ticking = false;
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
      bar.style.width = pct + "%";
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  rcAuroraInit();
  rcProgressInit();
  document.addEventListener("astro:after-swap", () => {
    rcAuroraInit();
    rcProgressInit();
  });
</script>
