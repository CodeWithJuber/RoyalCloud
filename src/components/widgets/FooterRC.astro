---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logoWhite from "~/assets/images/brand/logo-white.png";
import mascot from "~/assets/images/brand/mascot.png";
import { footerData } from "~/navigation";
import site from "~/data/site.json";

/**
 * Royal Clouds footer, modeled on the original royalclouds.net:
 * help cards (live chat / email / ticket), a centered newsletter strip
 * with the mascot peeking over its edge, navy column grid (accordion
 * on phones), drifting cloud skyline, payment marks, and the original
 * scroll-to-top button.
 */
const year = new Date().getFullYear();
const external = (href: string) => /^https?:\/\//.test(href);
const { links: columns, secondaryLinks, socialLinks } = footerData;

const helpCards = [
  {
    icon: "tabler:message-circle",
    title: "Live Chat",
    text: "We're always available to chat — instant replies, real humans.",
    cta: "Start chatting",
    href: "/contact",
  },
  {
    icon: "tabler:mail",
    title: "Send Email",
    text: "Write to us 24/7 and we'll get back to you right away.",
    cta: "Email support",
    href: `mailto:${site.contact.email}`,
  },
  {
    icon: "tabler:ticket",
    title: "Submit Ticket",
    text: "Open a ticket any time and track it through to resolution.",
    cta: "Open a ticket",
    href: site.portal.submitTicket,
  },
];

const payments = ["PayPal", "Visa", "Mastercard", "AmEx", "UPI ₹"];
---

<footer class="site-footer">
  <!-- "Need help?" strip (original royalclouds.net section) -->
  <div class="f-help-sec">
    <div class="wrap">
      <p class="f-help-lead">
        Need help? Chat with our <em>friendly support team</em> — 24/7 live chat,
        email or a ticket.
      </p>
      <div class="f-help-grid">
        {
          helpCards.map((c) => (
            <a
              class="f-help-card"
              href={c.href}
              {...(external(c.href)
                ? { target: "_blank", rel: "noopener" }
                : {})}
            >
              <span class="f-help-ic">
                <Icon name={c.icon} />
              </span>
              <span>
                <strong>{c.title}</strong>
                <small>{c.text}</small>
                <em>{c.cta} →</em>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Newsletter: centered panel, mascot peeking over the edge -->
  <div class="f-news">
    <Image src={mascot} alt="" width={120} height={250} class="f-news-mascot" />
    <div class="wrap f-news-inner">
      <h4>Join our newsletter</h4>
      <p>Better offers, product news and updates from Royal Clouds.</p>
      <form class="f-news-form" data-newsletter>
        <input
          type="email"
          name="email"
          placeholder="Your email address"
          aria-label="Email address"
          required
        />
        <button class="btn btn-coral" type="submit">Subscribe</button>
      </form>
    </div>
  </div>

  <!-- drifting cloud skyline over the navy footer -->
  <div class="f-sky" aria-hidden="true"></div>

  <div class="wrap">
    <div class="footer-grid" id="rcFooterCols">
      <div class="footer-brand">
        <Image src={logoWhite} alt={site.name} width={160} height={55} />
        <p>{site.description}</p>
        <span class="f-status">
          <i></i>
          All systems operational
        </span>
        <div class="footer-social">
          {
            socialLinks.map((s) => (
              <a
                href={s.href}
                aria-label={s.ariaLabel}
                {...(external(s.href)
                  ? { target: "_blank", rel: "noopener" }
                  : {})}
              >
                <Icon name={s.icon} />
              </a>
            ))
          }
        </div>
      </div>
      {
        columns.map((col) => (
          <div class="fcol">
            <h5>
              <button type="button" class="fcol-toggle" aria-expanded="true">
                {col.title}
                <Icon name="tabler:chevron-down" class="fcol-caret" />
              </button>
            </h5>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    {...(external(l.href)
                      ? { target: "_blank", rel: "noopener" }
                      : {})}
                  >
                    {l.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.legalName}. All rights reserved.</span>
      <div class="footer-legal">
        {secondaryLinks.map((l) => <a href={l.href}>{l.text}</a>)}
      </div>
      <div class="f-pay" aria-label="Accepted payment methods">
        {payments.map((p) => <span class="f-pay-chip">{p}</span>)}
      </div>
    </div>
  </div>

  <!-- scroll-to-top (the original royalclouds.net sky-blue button) -->
  <button class="to-top" id="rcToTop" aria-label="Back to top" hidden>
    <Icon name="tabler:chevron-up" />
  </button>
</footer>

<style>
  /* ---- help strip ---- */
  .f-help-sec {
    background: var(--bg-tint);
    border-top: 1px solid var(--line);
    padding: 56px 0;
  }
  .f-help-lead {
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(17px, 2.2vw, 21px);
    font-weight: 700;
    color: var(--rc-plum);
    margin: 0 0 30px;
  }
  .f-help-lead em {
    font-style: normal;
    color: var(--rc-blue);
  }
  .f-help-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 980px;
    margin: 0 auto;
  }
  .f-help-card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px 22px 20px;
    box-shadow: var(--shadow-xs);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }
  .f-help-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--line-strong);
  }
  .f-help-ic {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #ffe9ed;
    color: var(--rc-coral);
    display: grid;
    place-items: center;
  }
  .f-help-ic :global(svg) {
    width: 22px;
    height: 22px;
  }
  .f-help-card strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 15.5px;
    font-weight: 700;
    color: var(--rc-ink);
  }
  .f-help-card small {
    display: block;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 4px 0 8px;
  }
  .f-help-card em {
    display: inline-block;
    font-style: normal;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--rc-coral);
    transition: transform 0.18s ease;
  }
  .f-help-card:hover em {
    transform: translateX(3px);
  }
  .f-help-card:hover em {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- newsletter: centered, bulletproof at every width ---- */
  .f-news {
    position: relative;
    background: var(--rc-grad-vivid);
    padding: 52px 0 48px;
    text-align: center;
  }
  .f-news-mascot {
    position: absolute;
    top: -46px;
    right: clamp(16px, 8vw, 120px);
    width: 78px;
    height: auto;
    filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.3));
    pointer-events: none;
  }
  .f-news-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .f-news h4 {
    color: #fff;
    font-size: clamp(21px, 3vw, 26px);
    font-weight: 700;
    margin: 0 0 8px;
  }
  .f-news p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 14.5px;
    margin: 0 0 24px;
    max-width: 440px;
  }
  .f-news-form {
    display: flex;
    align-items: center;
    gap: 0;
    background: #fff;
    border-radius: 999px;
    padding: 6px 6px 6px 22px;
    width: min(100%, 480px);
    box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.4);
    transition: box-shadow 0.2s ease;
  }
  .f-news-form:focus-within {
    box-shadow:
      0 0 0 4px rgba(253, 215, 0, 0.35),
      0 18px 40px -16px rgba(0, 0, 0, 0.4);
  }
  .f-news-form input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--rc-ink);
    min-width: 0;
    text-align: left;
  }
  .f-news-form input::placeholder {
    color: var(--text-muted);
  }
  .f-news-form .btn {
    flex: none;
    padding: 14px 26px;
    font-size: 12.5px;
  }
  @media (max-width: 480px) {
    .f-news-form {
      flex-direction: column;
      align-items: stretch;
      border-radius: 22px;
      padding: 16px 16px 12px;
      gap: 10px;
    }
    .f-news-form input {
      padding: 2px 4px 12px;
      border-bottom: 1.5px solid var(--line);
    }
    .f-news-form .btn {
      width: 100%;
    }
    .f-news-mascot {
      width: 60px;
      top: -36px;
      right: 14px;
    }
  }

  /* ---- drifting cloud skyline over the navy ---- */
  .f-sky {
    height: 30px;
    background: #0d1a30;
    position: relative;
    overflow: hidden;
  }
  .f-sky::before {
    content: "";
    position: absolute;
    inset: 6px 0 0;
    width: 200%;
    background: rgba(255, 255, 255, 0.05);
    -webkit-mask: url("/brand-cloud.svg") 0 0 / 96px 96px repeat-x;
    mask: url("/brand-cloud.svg") 0 0 / 96px 96px repeat-x;
  }
  @media (prefers-reduced-motion: no-preference) {
    .f-sky::before {
      animation: fSkyDrift 80s linear infinite;
    }
  }
  @keyframes fSkyDrift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-96px);
    }
  }

  /* ---- footer columns: accordion on phones ---- */
  .fcol h5 {
    margin: 0 0 20px;
  }
  .fcol-toggle {
    all: unset;
    outline: revert;
    cursor: default;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-heading);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .fcol-toggle :global(.fcol-caret) {
    display: none;
    width: 17px;
    height: 17px;
    opacity: 0.6;
    transition: transform 0.22s ease;
  }
  @media (max-width: 700px) {
    .footer-grid .fcol {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 16px;
    }
    .fcol h5 {
      margin: 0;
    }
    .fcol-toggle {
      cursor: pointer;
      padding: 4px 0;
      min-height: 44px;
    }
    .fcol-toggle :global(.fcol-caret) {
      display: block;
    }
    .footer-grid .fcol ul {
      display: block;
      overflow: hidden;
      max-height: 0;
      transition: max-height 0.32s ease;
    }
    .footer-grid .fcol ul li {
      margin-bottom: 8px;
    }
    .footer-grid .fcol ul li:first-child {
      margin-top: 14px;
    }
    .footer-grid .fcol.open ul {
      max-height: 420px;
    }
    .fcol.open .fcol-toggle :global(.fcol-caret) {
      transform: rotate(180deg);
    }
    /* no-JS fallback: stay expanded until the accordion script arms */
    .footer-grid:not(.acc-ready) .fcol ul {
      max-height: none !important;
    }
    .footer-grid:not(.acc-ready) .fcol-toggle :global(.fcol-caret) {
      display: none;
    }
  }

  /* ---- live status pill ---- */
  .f-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.8);
  }
  .f-status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
  }
  @media (prefers-reduced-motion: no-preference) {
    .f-status i {
      animation: fPulse 2.2s ease-in-out infinite;
    }
  }
  @keyframes fPulse {
    50% {
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.12);
    }
  }

  /* ---- social / legal / payments ---- */
  .footer-social {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }
  .footer-social a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.65);
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease,
      transform 0.16s ease;
  }
  .footer-social a:hover {
    color: var(--rc-ink);
    border-color: var(--rc-yellow);
    background: var(--rc-yellow);
    transform: translateY(-2px);
  }
  .footer-social :global(svg) {
    width: 18px;
    height: 18px;
  }
  .footer-legal {
    display: flex;
    gap: 8px 18px;
    flex-wrap: wrap;
  }
  .footer-legal a {
    display: inline-block;
    padding-block: 6px;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.15s ease;
  }
  .footer-legal a:hover {
    color: var(--rc-yellow);
  }
  .f-pay {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .f-pay-chip {
    font-family: var(--font-heading);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 7px;
    padding: 5px 10px;
    white-space: nowrap;
  }

  /* ---- scroll-to-top (original sky-blue button) ---- */
  .to-top {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    width: 46px;
    height: 46px;
    border: none;
    border-radius: 13px;
    background: var(--rc-blue);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 12px 26px -10px rgba(0, 167, 245, 0.6);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      background 0.16s ease;
  }
  .to-top.show {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: no-preference) {
    .to-top.show {
      animation: toTopIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }
  @keyframes toTopIn {
    0% {
      opacity: 0;
      transform: translateY(14px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .to-top:hover {
    background: #0095db;
  }
  .to-top :global(svg) {
    width: 22px;
    height: 22px;
  }

  @media (max-width: 860px) {
    .f-help-grid {
      grid-template-columns: 1fr;
      max-width: 460px;
    }
  }
  @media (max-width: 560px) {
    .footer-social {
      justify-content: center;
    }
    .footer-legal,
    .f-pay {
      justify-content: center;
    }
  }
</style>

<script>
  function rcFooterInit() {
    /* newsletter: no backend on the static site — hand the address to the
       sales inbox via the visitor's mail client */
    document
      .querySelectorAll<HTMLFormElement>("[data-newsletter]")
      .forEach((form) => {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const email =
            (form.querySelector("input[name=email]") as HTMLInputElement)
              ?.value ?? "";
          window.location.href = `mailto:sales@royalclouds.net?subject=${encodeURIComponent(
            "Newsletter signup",
          )}&body=${encodeURIComponent(`Please add ${email} to the Royal Clouds newsletter.`)}`;
        });
      });

    /* footer columns: accordion on phones */
    const grid = document.getElementById("rcFooterCols");
    if (grid && !grid.classList.contains("acc-ready")) {
      grid.classList.add("acc-ready");
      const mq = window.matchMedia("(max-width: 700px)");
      grid.querySelectorAll(".fcol").forEach((col, i) => {
        const btn = col.querySelector(".fcol-toggle");
        col.classList.toggle("open", !mq.matches || i === 0);
        btn?.setAttribute(
          "aria-expanded",
          String(col.classList.contains("open")),
        );
        btn?.addEventListener("click", () => {
          if (!mq.matches) return;
          const open = col.classList.toggle("open");
          btn.setAttribute("aria-expanded", String(open));
        });
      });
      mq.addEventListener?.("change", () => {
        grid.querySelectorAll(".fcol").forEach((col, i) => {
          col.classList.toggle("open", !mq.matches || i === 0);
        });
      });
    }

    /* scroll-to-top */
    const top = document.getElementById("rcToTop");
    if (top) {
      top.hidden = false;
      const onScroll = () => {
        top.classList.toggle("show", window.scrollY > 700);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      top.addEventListener("click", () => {
        window.scrollTo({ top: 0 });
      });
    }
  }
  rcFooterInit();
  document.addEventListener("astro:after-swap", rcFooterInit);
</script>
