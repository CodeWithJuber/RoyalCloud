---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logoDark from "~/assets/images/brand/logo-dark.png";
import { headerData } from "~/navigation";
import { tablerIcon } from "~/utils/plans";

/**
 * Royal Clouds header — clean white, always sticky.
 * `solid` pages start with the scrolled shadow; others gain it on scroll.
 * Navigation content comes from src/data/navigation.json (Decap-editable).
 */
interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;

type Link = { text: string; href: string; icon?: string; description?: string };
type Item = Link | { text: string; links: Link[] };

const items = headerData.links as Item[];
const actions = headerData.actions as {
  text: string;
  href: string;
  variant?: string;
}[];
const isGroup = (i: Item): i is { text: string; links: Link[] } => "links" in i;
const external = (href: string) => /^https?:\/\//.test(href);
---

<header class={`site-header ${solid ? "scrolled solid" : ""}`} id="siteHeader">
  <div class="wrap header-inner">
    <a class="header-logo" href="/" aria-label="Royal Clouds home">
      <Image
        src={logoDark}
        alt="Royal Clouds"
        width={176}
        height={60}
        loading="eager"
      />
    </a>
    <nav class="nav" aria-label="Primary">
      {
        items.map((item) =>
          isGroup(item) ? (
            <span class="nav-dd">
              <a href={item.links[0]?.href ?? "#"} aria-haspopup="true">
                {item.text}
                <Icon name="tabler:chevron-down" class="dd-caret" />
              </a>
              <span
                class={`dd-panel ${item.links.some((l) => l.description) ? "mega" : ""}`}
              >
                {item.links.map((l) =>
                  l.description ? (
                    <a href={l.href} class="mega-item">
                      <span class="mega-ic">
                        <Icon name={tablerIcon(l.icon ?? "")} />
                      </span>
                      <span>
                        <strong>{l.text}</strong>
                        <small>{l.description}</small>
                      </span>
                    </a>
                  ) : (
                    <a href={l.href}>{l.text}</a>
                  ),
                )}
              </span>
            </span>
          ) : (
            <a href={item.href}>{item.text}</a>
          ),
        )
      }
    </nav>
    <div class="header-cta">
      {
        actions.map((a) =>
          a.variant === "secondary" ? (
            <a
              class="login"
              href={a.href}
              {...(external(a.href)
                ? { target: "_blank", rel: "noopener" }
                : {})}
            >
              {a.text}
            </a>
          ) : (
            <a
              class="btn btn-primary"
              href={a.href}
              {...(external(a.href)
                ? { target: "_blank", rel: "noopener" }
                : {})}
            >
              {a.text}
            </a>
          ),
        )
      }
      <button
        class="menu-btn"
        id="rcMenuBtn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="rcMobileNav"
      >
        <Icon name="tabler:menu-2" />
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="rcMobileNav" hidden aria-label="Mobile">
    {
      items.map((item) =>
        isGroup(item) ? (
          <details class="m-group">
            <summary>
              {item.text}
              <Icon name="tabler:chevron-down" class="dd-caret" />
            </summary>
            {item.links.map((l) => (
              <a href={l.href}>{l.text}</a>
            ))}
          </details>
        ) : (
          <a href={item.href}>{item.text}</a>
        ),
      )
    }
    {
      actions
        .filter((a) => a.variant !== "secondary")
        .map((a) => (
          <a
            class="btn btn-primary"
            href={a.href}
            {...(external(a.href) ? { target: "_blank", rel: "noopener" } : {})}
          >
            {a.text}
          </a>
        ))
    }
  </nav>
</header>

<style>
  /* dropdowns + mobile menu, styled to the design language */
  .nav-dd {
    position: relative;
    display: inline-flex;
  }
  .nav-dd > a {
    font-size: 15px;
    font-weight: 600;
    font-family: var(--font-heading);
    color: var(--rc-ink);
    padding: 8px 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .nav-dd > a:hover {
    color: var(--rc-violet);
  }
  .nav :global(.dd-caret) {
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: transform 0.18s ease;
  }
  .nav-dd:hover :global(.dd-caret),
  .nav-dd:focus-within :global(.dd-caret) {
    transform: rotate(180deg);
  }
  .dd-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    display: flex;
    flex-direction: column;
    min-width: 230px;
    background: #fff;
    border: 1px solid #efecfa;
    border-radius: 14px;
    box-shadow: 0 24px 56px -18px rgba(34, 16, 95, 0.35);
    padding: 10px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    z-index: 60;
  }
  .dd-panel::before {
    content: "";
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }
  .nav-dd:hover .dd-panel,
  .nav-dd:focus-within .dd-panel {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .dd-panel a {
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 500;
    color: #22105f !important;
    padding: 9px 14px;
    border-radius: 9px;
    transition:
      background 0.14s ease,
      color 0.14s ease;
  }
  .dd-panel a:hover {
    background: #f7f5ff;
    color: #7652f2 !important;
  }
  .dd-panel a::after {
    display: none;
  }

  /* mega panel: two-column product grid with icon + one-liner.
     Anchored to the left of its nav item (not centered) so the 560px panel
     can never clip off the viewport's left edge. */
  .dd-panel.mega {
    display: grid;
    grid-template-columns: repeat(2, minmax(250px, 1fr));
    gap: 4px;
    min-width: 560px;
    padding: 14px;
    left: -80px;
    transform: translateY(6px);
  }
  .nav-dd:hover .dd-panel.mega,
  .nav-dd:focus-within .dd-panel.mega {
    transform: translateY(0);
  }
  .mega-item {
    display: flex !important;
    align-items: flex-start;
    gap: 12px;
    padding: 11px 12px !important;
  }
  .mega-item .mega-ic {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: #f7f5ff;
    border: 1px solid #e9e3fc;
    display: grid;
    place-items: center;
    color: #7652f2;
    transition:
      background 0.14s ease,
      color 0.14s ease,
      border-color 0.14s ease;
  }
  .mega-item .mega-ic :global(svg) {
    width: 20px;
    height: 20px;
  }
  .mega-item:hover .mega-ic {
    background: var(--rc-gradient);
    border-color: transparent;
    color: #fff;
  }
  .mega-item strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .mega-item small {
    display: block;
    font-size: 12.5px;
    color: #6b6b88;
    line-height: 1.45;
    margin-top: 2px;
  }

  .menu-btn {
    display: none;
    background: var(--bg-tint);
    color: var(--rc-ink);
    border: 1px solid var(--line);
    border-radius: 10px;
    width: 42px;
    height: 42px;
    font-size: 18px;
    cursor: pointer;
  }
  .menu-btn :global(svg) {
    width: 20px;
    height: 20px;
    margin: auto;
  }
  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: #fff;
    padding: 14px 22px 26px;
    border-top: 1px solid var(--line);
    box-shadow: 0 24px 40px -20px rgba(34, 16, 95, 0.2);
    max-height: calc(100dvh - 70px);
    overflow-y: auto;
  }
  .mobile-nav a {
    color: var(--rc-ink);
    font-size: 16px;
    font-weight: 500;
    padding: 11px 4px;
  }
  .mobile-nav a:hover {
    color: var(--rc-violet);
  }
  .mobile-nav .btn {
    margin-top: 12px;
    justify-content: center;
    color: #fff;
  }
  .mobile-nav.open {
    display: flex;
  }
  .m-group summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--rc-ink);
    font-size: 16px;
    font-weight: 500;
    padding: 11px 4px;
  }
  .m-group summary::-webkit-details-marker {
    display: none;
  }
  .m-group :global(.dd-caret) {
    width: 16px;
    height: 16px;
    transition: transform 0.18s ease;
  }
  .m-group[open] summary :global(.dd-caret) {
    transform: rotate(180deg);
  }
  .m-group a {
    padding-left: 18px;
    font-size: 15px;
    color: var(--text-muted);
    display: block;
  }

  @media (max-width: 860px) {
    .menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .header-cta .login {
      display: none;
    }
    .header-cta > .btn {
      display: none;
    }
  }
</style>

<script>
  function rcHeaderInit() {
    const header = document.getElementById("siteHeader");
    if (!header) return;
    const solid = header.classList.contains("solid");
    const onScroll = () => {
      if (!solid) header.classList.toggle("scrolled", window.scrollY > 24);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const btn = document.getElementById("rcMenuBtn");
    const nav = document.getElementById("rcMobileNav");
    btn?.addEventListener("click", () => {
      const open = nav?.classList.toggle("open");
      if (nav) nav.hidden = !open;
      btn.setAttribute("aria-expanded", String(!!open));
      if (open) header.classList.add("scrolled");
    });
  }
  rcHeaderInit();
  document.addEventListener("astro:after-swap", rcHeaderInit);
</script>
