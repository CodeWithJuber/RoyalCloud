---
import { Image } from 'astro:assets';
import logoWhite from '~/assets/images/brand/logo-white.png';

/**
 * Design-handoff header (Royal Clouds Premium Home.html).
 * Fixed; transparent over the dark hero, indigo glass once scrolled.
 * `solid` renders it pre-scrolled for pages without a dark hero.
 */
interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
const PORTAL = 'https://my.royalclouds.net';

const hosting = [
  { text: 'SSD Shared Hosting', href: '/shared-hosting' },
  { text: 'cPanel Hosting', href: '/cpanel-hosting' },
  { text: 'Managed WordPress', href: '/managed-wordpress-hosting' },
  { text: 'KVM VPS Hosting', href: '/kvm-vps-hosting' },
  { text: 'CyberPanel VPS', href: '/cyberpanel-vps-hosting' },
  { text: 'Dedicated Servers', href: '/dedicated-servers' },
];
const technology = [
  { text: 'Top Speed Solutions', href: '/speed' },
  { text: 'Amazing Uptime', href: '/uptime' },
  { text: 'Datacenter', href: '/datacenter' },
];
---

<header class={`site-header ${solid ? 'scrolled solid' : ''}`} id="siteHeader">
  <div class="wrap header-inner">
    <a class="header-logo" href="/" aria-label="Royal Clouds home">
      <Image src={logoWhite} alt="Royal Clouds" width={176} height={60} loading="eager" />
    </a>
    <nav class="nav" aria-label="Primary">
      <span class="nav-dd">
        <a href="/shared-hosting">Hosting ▾</a>
        <span class="dd-panel">
          {hosting.map((l) => (<a href={l.href}>{l.text}</a>))}
        </span>
      </span>
      <span class="nav-dd">
        <a href="/speed">Technology ▾</a>
        <span class="dd-panel">
          {technology.map((l) => (<a href={l.href}>{l.text}</a>))}
        </span>
      </span>
      <a href="/#pricing">Pricing</a>
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
    <div class="header-cta">
      <a class="login" href={`${PORTAL}/clientarea.php`} target="_blank" rel="noopener">Log in</a>
      <a class="btn btn-primary" href={`${PORTAL}/cart.php`} target="_blank" rel="noopener">Get Started</a>
      <button class="menu-btn" id="rcMenuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="rcMobileNav">☰</button>
    </div>
  </div>
  <nav class="mobile-nav" id="rcMobileNav" hidden aria-label="Mobile">
    <a href="/shared-hosting">SSD Shared Hosting</a>
    <a href="/cpanel-hosting">cPanel Hosting</a>
    <a href="/managed-wordpress-hosting">Managed WordPress</a>
    <a href="/kvm-vps-hosting">KVM VPS Hosting</a>
    <a href="/cyberpanel-vps-hosting">CyberPanel VPS</a>
    <a href="/dedicated-servers">Dedicated Servers</a>
    <a href="/speed">Technology</a>
    <a href="/blog">Blog</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a class="btn btn-primary" href={`${PORTAL}/cart.php`} target="_blank" rel="noopener">Get Started</a>
  </nav>
</header>

<style>
  /* dropdowns + mobile menu, styled to the design language */
  .nav-dd { position: relative; display: inline-flex; }
  .nav-dd > a { font-size: 15px; font-weight: 500; color: rgba(255, 255, 255, 0.82); padding: 6px 0; }
  .nav-dd > a:hover { color: #fff; }
  .dd-panel {
    position: absolute; top: calc(100% + 14px); left: 50%; transform: translateX(-50%) translateY(6px);
    display: flex; flex-direction: column; min-width: 230px;
    background: #fff; border: 1px solid #efecfa; border-radius: 14px;
    box-shadow: 0 24px 56px -18px rgba(34, 16, 95, 0.35);
    padding: 10px; opacity: 0; visibility: hidden;
    transition: opacity 0.18s ease, transform 0.18s ease;
    z-index: 60;
  }
  .dd-panel::before { content: ''; position: absolute; top: -14px; left: 0; right: 0; height: 14px; }
  .nav-dd:hover .dd-panel, .nav-dd:focus-within .dd-panel { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .dd-panel a {
    font-family: var(--font-body); font-size: 14.5px; font-weight: 500; color: #22105f !important;
    padding: 9px 14px; border-radius: 9px; transition: background 0.14s ease, color 0.14s ease;
  }
  .dd-panel a:hover { background: #f7f5ff; color: #7652f2 !important; }
  .dd-panel a::after { display: none; }

  .menu-btn {
    display: none; background: rgba(255,255,255,0.1); color: #fff;
    border: 1px solid rgba(255,255,255,0.25); border-radius: 10px;
    width: 42px; height: 42px; font-size: 18px; cursor: pointer;
  }
  .mobile-nav {
    display: none; flex-direction: column; gap: 4px;
    background: rgba(22, 10, 64, 0.98); backdrop-filter: blur(14px);
    padding: 14px 22px 26px; border-top: 1px solid rgba(255,255,255,0.1);
  }
  .mobile-nav a { color: rgba(255,255,255,0.85); font-size: 16px; padding: 11px 4px; }
  .mobile-nav a:hover { color: #fff; }
  .mobile-nav .btn { margin-top: 12px; justify-content: center; color: #fff; }
  .mobile-nav.open { display: flex; }

  /* solid variant for inner pages */
  .site-header.solid { position: sticky; }

  @media (max-width: 860px) {
    .menu-btn { display: inline-flex; align-items: center; justify-content: center; }
    .header-cta .login { display: none; }
    .header-cta > .btn { display: none; }
  }
</style>

<script>
  function rcHeaderInit() {
    const header = document.getElementById('siteHeader');
    if (!header) return;
    const solid = header.classList.contains('solid');
    const onScroll = () => {
      if (!solid) header.classList.toggle('scrolled', window.scrollY > 24);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const btn = document.getElementById('rcMenuBtn');
    const nav = document.getElementById('rcMobileNav');
    btn?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open');
      if (nav) nav.hidden = !open;
      btn.setAttribute('aria-expanded', String(!!open));
      if (open) header.classList.add('scrolled');
    });
  }
  rcHeaderInit();
  document.addEventListener('astro:after-swap', rcHeaderInit);
</script>
