---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logoDark from "~/assets/images/brand/logo-dark.png";
import { headerData } from "~/navigation";
import { tablerIcon } from "~/utils/plans";
import { pricify } from "~/utils/currency";
import site from "~/data/site.json";

/**
 * Royal Clouds header — clean white, always sticky.
 * `solid` pages start with the scrolled shadow; others gain it on scroll.
 * Navigation content comes from src/data/navigation.json (Decap-editable).
 */
interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;

type Link = { text: string; href: string; icon?: string; description?: string };
type Item = Link | { text: string; links: Link[] };

const items = headerData.links as Item[];
const actions = headerData.actions as {
  text: string;
  href: string;
  variant?: string;
}[];
const isGroup = (i: Item): i is { text: string; links: Link[] } => "links" in i;
const external = (href: string) => /^https?:\/\//.test(href);

// Wayfinding: mark the visitor's current location (aria-current) so they always
// know where they are in the nav (Jakob's Law / WCAG 2.4.8).
const pathname = (Astro.url.pathname.replace(/\/+$/, "") || "/").toLowerCase();
const isCurrent = (href: string) => {
  if (!href || external(href) || href.startsWith("#")) return false;
  const h = (href.replace(/\/+$/, "") || "/").toLowerCase();
  return h === pathname;
};
const groupActive = (links: Link[]) => links.some((l) => isCurrent(l.href));

// icon chips for the mobile sheet's top-level items
const NAV_ICONS: Record<string, string> = {
  hosting: "tabler:server-2",
  technology: "tabler:cpu",
  domains: "tabler:world",
  blog: "tabler:news",
  about: "tabler:info-circle",
  contact: "tabler:message-circle",
};
const navIcon = (text: string) =>
  NAV_ICONS[text.toLowerCase()] ?? "tabler:point";
---

{
  "promo" in site && site.promo && (
    <div class="promo-bar">
      <span set:html={pricify(site.promo)} />
    </div>
  )
}
<header class={`site-header ${solid ? "scrolled solid" : ""}`} id="siteHeader">
  <div class="wrap header-inner">
    <a class="header-logo" href="/" aria-label="Royal Clouds home">
      <Image
        src={logoDark}
        alt="Royal Clouds"
        width={176}
        height={60}
        loading="eager"
      />
    </a>
    <nav class="nav" aria-label="Primary">
      {
        items.map((item, gi) =>
          isGroup(item) ? (
            <span class="nav-dd" data-dd>
              <a
                href={item.links[0]?.href ?? "#"}
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls={`dd-panel-${gi}`}
                class={groupActive(item.links) ? "is-current" : ""}
                {...(groupActive(item.links) ? { "aria-current": "true" } : {})}
              >
                {item.text}
                <Icon name="tabler:chevron-down" class="dd-caret" />
              </a>
              <span
                id={`dd-panel-${gi}`}
                class={`dd-panel ${item.links.some((l) => l.description) ? "mega" : ""}`}
              >
                {item.links.map((l) =>
                  l.description ? (
                    <a
                      href={l.href}
                      class="mega-item"
                      {...(isCurrent(l.href) ? { "aria-current": "page" } : {})}
                    >
                      <span class="mega-ic">
                        <Icon name={tablerIcon(l.icon ?? "")} />
                      </span>
                      <span>
                        <strong>{l.text}</strong>
                        <small>{l.description}</small>
                      </span>
                    </a>
                  ) : (
                    <a
                      href={l.href}
                      {...(isCurrent(l.href) ? { "aria-current": "page" } : {})}
                    >
                      {l.text}
                    </a>
                  ),
                )}
              </span>
            </span>
          ) : (
            <a
              href={item.href}
              class={isCurrent(item.href) ? "is-current" : ""}
              {...(isCurrent(item.href) ? { "aria-current": "page" } : {})}
            >
              {item.text}
            </a>
          ),
        )
      }
    </nav>
    <div class="header-cta">
      <div class="cur-toggle" role="group" aria-label="Currency">
        <button type="button" data-cur="inr" class="active" aria-pressed="true"
          >₹</button
        >
        <button type="button" data-cur="usd" aria-pressed="false">$</button>
      </div>
      {
        actions.map((a) =>
          a.variant === "secondary" ? (
            <a
              class="login"
              href={a.href}
              {...(external(a.href)
                ? { target: "_blank", rel: "noopener" }
                : {})}
            >
              {a.text}
            </a>
          ) : (
            <a
              class="btn btn-primary"
              href={a.href}
              {...(external(a.href)
                ? { target: "_blank", rel: "noopener" }
                : {})}
            >
              {a.text}
            </a>
          ),
        )
      }
      <button
        class="menu-btn"
        id="rcMenuBtn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="rcMobileNav"
      >
        <Icon name="tabler:menu-2" />
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="rcMobileNav" hidden aria-label="Mobile">
    {
      items.map((item) =>
        isGroup(item) ? (
          <details class="m-group">
            <summary class="m-item">
              <span class="m-ic">
                <Icon name={navIcon(item.text)} />
              </span>
              {item.text}
              <Icon name="tabler:chevron-down" class="dd-caret" />
            </summary>
            <div class="m-sub">
              {item.links.map((l) => (
                <a
                  href={l.href}
                  {...(isCurrent(l.href) ? { "aria-current": "page" } : {})}
                >
                  <span class="m-sub-ic">
                    <Icon name={tablerIcon(l.icon ?? "point")} />
                  </span>
                  {l.text}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            class="m-item"
            href={item.href}
            {...(isCurrent(item.href) ? { "aria-current": "page" } : {})}
          >
            <span class="m-ic">
              <Icon name={navIcon(item.text)} />
            </span>
            {item.text}
            <Icon name="tabler:chevron-right" class="dd-caret m-go" />
          </a>
        ),
      )
    }
    <div class="cur-toggle m-cur" role="group" aria-label="Currency">
      <button type="button" data-cur="inr" class="active" aria-pressed="true"
        >₹ INR</button
      >
      <button type="button" data-cur="usd" aria-pressed="false">$ USD</button>
    </div>
    <div class="m-actions">
      {
        actions.map((a) => (
          <a
            class={`btn ${a.variant === "secondary" ? "btn-ghost-dark" : "btn-primary"}`}
            href={a.href}
            {...(external(a.href) ? { target: "_blank", rel: "noopener" } : {})}
          >
            {a.text}
          </a>
        ))
      }
    </div>
    <p class="m-trust">
      <Icon name="tabler:shield-check" /> 99.99% uptime · Free SSL · 24/7 human
      support
    </p>
  </nav>
</header>

<style>
  /* dropdowns + mobile menu, styled to the design language */
  .nav-dd {
    position: relative;
    display: inline-flex;
  }
  .nav-dd > a {
    font-size: 15px;
    font-weight: 600;
    font-family: var(--font-heading);
    color: var(--rc-ink);
    padding: 8px 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .nav-dd > a:hover {
    color: var(--rc-violet);
  }
  /* Wayfinding: highlight the current top-level location */
  .nav > a.is-current,
  .nav-dd > a.is-current {
    color: var(--rc-violet);
  }
  .nav > a.is-current::after,
  .nav-dd > a.is-current::after {
    content: "";
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--rc-violet);
  }
  .nav > a {
    position: relative;
  }
  .dd-panel a[aria-current="page"],
  .m-sub a[aria-current="page"],
  .m-item[aria-current="page"] {
    color: var(--rc-violet) !important;
    background: var(--bg-tint);
    font-weight: 700;
  }
  .nav :global(.dd-caret) {
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: transform 0.18s ease;
  }
  .nav-dd:hover :global(.dd-caret),
  .nav-dd:focus-within :global(.dd-caret) {
    transform: rotate(180deg);
  }
  .dd-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    display: flex;
    flex-direction: column;
    min-width: 230px;
    background: #fff;
    border: 1px solid #efecfa;
    border-radius: 14px;
    box-shadow: 0 24px 56px -18px rgba(34, 16, 95, 0.35);
    padding: 10px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    z-index: 60;
  }
  .dd-panel::before {
    content: "";
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }
  .nav-dd:hover .dd-panel,
  .nav-dd:focus-within .dd-panel {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .dd-panel a {
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 500;
    color: #22105f !important;
    padding: 9px 14px;
    border-radius: 9px;
    transition:
      background 0.14s ease,
      color 0.14s ease;
  }
  .dd-panel a:hover {
    background: var(--bg-tint);
    color: #7652f2 !important;
  }
  .dd-panel a::after {
    display: none;
  }

  /* mega panel: two-column product grid with icon + one-liner.
     Anchored to the left of its nav item (not centered) so the 560px panel
     can never clip off the viewport's left edge. */
  .dd-panel.mega {
    display: grid;
    grid-template-columns: repeat(2, minmax(250px, 1fr));
    gap: 4px;
    min-width: 560px;
    padding: 14px;
    left: -80px;
    transform: translateY(6px);
  }
  .nav-dd:hover .dd-panel.mega,
  .nav-dd:focus-within .dd-panel.mega {
    transform: translateY(0);
  }
  .mega-item {
    display: flex !important;
    align-items: flex-start;
    gap: 12px;
    padding: 11px 12px !important;
  }
  .mega-item .mega-ic {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--bg-tint);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    color: #7652f2;
    transition:
      background 0.14s ease,
      color 0.14s ease,
      border-color 0.14s ease;
  }
  .mega-item .mega-ic :global(svg) {
    width: 20px;
    height: 20px;
  }
  .mega-item:hover .mega-ic {
    background: var(--rc-gradient);
    border-color: transparent;
    color: #fff;
  }
  .mega-item strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .mega-item small {
    display: block;
    font-size: 12.5px;
    color: #6b6b88;
    line-height: 1.45;
    margin-top: 2px;
  }

  /* ₹/$ currency switch */
  .cur-toggle {
    display: inline-flex;
    background: var(--bg-tint);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px;
  }
  .cur-toggle button {
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted);
    width: 30px;
    height: 28px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .cur-toggle button.active {
    background: var(--rc-ink);
    color: #fff;
  }
  .cur-toggle.m-cur {
    margin-top: 12px;
    align-self: center;
  }
  .cur-toggle.m-cur button {
    width: auto;
    padding: 0 18px;
    height: 34px;
    font-size: 12.5px;
  }
  @media (max-width: 860px) {
    .header-cta > .cur-toggle {
      display: none;
    }
  }

  .menu-btn {
    display: none;
    background: var(--bg-tint);
    color: var(--rc-ink);
    border: 1px solid var(--line);
    border-radius: 10px;
    width: 42px;
    height: 42px;
    font-size: 18px;
    cursor: pointer;
  }
  .menu-btn :global(svg) {
    width: 20px;
    height: 20px;
    margin: auto;
  }
  /* modern mobile sheet: icon chips, rounded rows, action bar */
  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: #fff;
    padding: 14px 16px 22px;
    border-top: 1px solid var(--line);
    border-radius: 0 0 22px 22px;
    box-shadow: 0 30px 50px -22px rgba(34, 16, 95, 0.28);
    max-height: calc(100dvh - 70px);
    overflow-y: auto;
  }
  .mobile-nav.open {
    display: flex;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav.open {
      animation: mSheet 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mobile-nav.open > * {
      animation: mItem 0.45s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }
    .mobile-nav.open > :nth-child(2) {
      animation-delay: 0.04s;
    }
    .mobile-nav.open > :nth-child(3) {
      animation-delay: 0.08s;
    }
    .mobile-nav.open > :nth-child(4) {
      animation-delay: 0.12s;
    }
    .mobile-nav.open > :nth-child(5) {
      animation-delay: 0.16s;
    }
    .mobile-nav.open > :nth-child(6) {
      animation-delay: 0.2s;
    }
    .mobile-nav.open > :nth-child(7) {
      animation-delay: 0.24s;
    }
    .mobile-nav.open > :nth-child(8) {
      animation-delay: 0.28s;
    }
  }
  @keyframes mSheet {
    from {
      opacity: 0;
      translate: 0 -10px;
    }
  }
  @keyframes mItem {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  .m-item {
    display: flex;
    align-items: center;
    gap: 13px;
    color: var(--rc-ink);
    font-family: var(--font-heading);
    font-size: 15.5px;
    font-weight: 600;
    padding: 10px 12px;
    border-radius: 14px;
    transition: background 0.15s ease;
  }
  .m-item:hover,
  .m-item:active {
    background: var(--bg-tint);
  }
  .m-ic {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--theme-soft, var(--pastel-lavender));
    color: var(--theme-accent, var(--rc-violet));
    display: grid;
    place-items: center;
  }
  .m-ic :global(svg) {
    width: 20px;
    height: 20px;
  }
  .mobile-nav :global(.m-go) {
    margin-left: auto;
    opacity: 0.45;
  }
  .m-group summary.m-item {
    list-style: none;
    cursor: pointer;
  }
  .m-group summary::-webkit-details-marker {
    display: none;
  }
  .m-group summary :global(.dd-caret) {
    margin-left: auto;
    width: 17px;
    height: 17px;
    opacity: 0.45;
    transition: transform 0.2s ease;
  }
  .m-group[open] summary :global(.dd-caret) {
    transform: rotate(180deg);
  }
  .m-group[open] summary.m-item {
    background: var(--bg-tint);
  }
  .m-sub {
    display: flex;
    flex-direction: column;
    margin: 4px 0 6px 30px;
    padding-left: 16px;
    border-left: 2px solid var(--line);
  }
  .m-sub a {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text-default);
    padding: 9px 10px;
    border-radius: 10px;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .m-sub a:hover,
  .m-sub a:active {
    background: var(--bg-tint);
    color: var(--rc-violet);
  }
  .m-sub-ic {
    display: inline-flex;
    color: var(--theme-accent, var(--rc-violet));
    opacity: 0.8;
  }
  .m-sub-ic :global(svg) {
    width: 17px;
    height: 17px;
  }
  .m-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .m-actions .btn {
    justify-content: center;
    padding: 14px 18px;
  }
  .m-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin: 14px 0 0;
    font-size: 12px;
    color: var(--text-muted);
  }
  .m-trust :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--ok);
  }

  @media (max-width: 860px) {
    .menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .header-cta .login {
      display: none;
    }
    .header-cta > .btn {
      display: none;
    }
  }
</style>

<script>
  function rcHeaderInit() {
    const header = document.getElementById("siteHeader");
    if (!header) return;
    const solid = header.classList.contains("solid");
    const onScroll = () => {
      if (!solid) header.classList.toggle("scrolled", window.scrollY > 24);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // Desktop dropdowns: keep aria-expanded in sync with the CSS hover/focus
    // state and let Escape dismiss an open menu (WAI-ARIA menu conventions).
    header.querySelectorAll<HTMLElement>("[data-dd]").forEach((dd) => {
      const trigger = dd.querySelector<HTMLElement>("a[aria-haspopup]");
      const sync = (open: boolean) =>
        trigger?.setAttribute("aria-expanded", String(open));
      dd.addEventListener("mouseenter", () => sync(true));
      dd.addEventListener("mouseleave", () => sync(false));
      dd.addEventListener("focusin", () => sync(true));
      dd.addEventListener("focusout", (e) => {
        if (!dd.contains(e.relatedTarget as Node)) sync(false);
      });
      dd.addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key === "Escape") {
          sync(false);
          (document.activeElement as HTMLElement)?.blur();
          trigger?.focus();
        }
      });
    });

    const btn = document.getElementById("rcMenuBtn");
    const nav = document.getElementById("rcMobileNav");
    const setMenu = (open: boolean) => {
      nav?.classList.toggle("open", open);
      if (nav) nav.hidden = !open;
      btn?.setAttribute("aria-expanded", String(open));
      btn?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (open) header.classList.add("scrolled");
      // Lock the page behind the sheet so it feels like a native overlay
      // (no scroll bleed-through); restore on close.
      document.documentElement.style.overflow = open ? "hidden" : "";
    };
    btn?.addEventListener("click", () => {
      const open = !nav?.classList.contains("open");
      setMenu(open);
      if (open) {
        // Move focus into the sheet so keyboard users land where they expect.
        nav?.querySelector<HTMLElement>("a, button, summary")?.focus();
      }
    });
    // Escape closes the mobile sheet and returns focus to its toggle.
    nav?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        setMenu(false);
        btn?.focus();
      }
    });
    // Clicking a destination link closes the sheet.
    nav?.querySelectorAll("a[href]").forEach((a) =>
      a.addEventListener("click", () => setMenu(false)),
    );
  }
  rcHeaderInit();
  document.addEventListener("astro:after-swap", rcHeaderInit);

  /** Global ₹/$ switch — swaps every .px span and plan-grid symbol,
      persists in localStorage, notifies pricing grids via rc-currency. */
  function rcCurrencyInit() {
    const KEY = "rc-currency";
    const apply = (cur: string) => {
      document.documentElement.dataset.currency = cur;
      document.querySelectorAll(".px").forEach((el) => {
        const v = el.getAttribute(cur === "usd" ? "data-usd" : "data-inr");
        if (v) el.textContent = v;
      });
      document.querySelectorAll("[data-cur-sym]").forEach((el) => {
        el.textContent = cur === "usd" ? "$" : "₹";
      });
      document.querySelectorAll(".cur-toggle button").forEach((b) => {
        const on = b.getAttribute("data-cur") === cur;
        b.classList.toggle("active", on);
        b.setAttribute("aria-pressed", String(on));
      });
      document.dispatchEvent(new CustomEvent("rc-currency"));
    };
    document.querySelectorAll(".cur-toggle button").forEach((b) => {
      b.addEventListener("click", () => {
        const cur = b.getAttribute("data-cur") || "inr";
        try {
          localStorage.setItem(KEY, cur);
        } catch {
          /* private mode */
        }
        apply(cur);
      });
    });
    let saved = "inr";
    try {
      saved = localStorage.getItem(KEY) || "inr";
    } catch {
      /* private mode */
    }
    if (saved !== "inr") apply(saved);
  }
  rcCurrencyInit();
  document.addEventListener("astro:after-swap", rcCurrencyInit);
</script>
