---
import HeroSkyline from "~/components/illustrations/scenes/HeroSkyline.astro";
import { pricify } from "~/utils/currency";

/**
 * Royal Clouds home hero. Disciplined 4-element stack (offer eyebrow, headline,
 * subtext, CTAs) on the deep royal-night gradient, with the custom isometric
 * "HeroSkyline" cloud-city on the right (desktop). The proof/trust signals that
 * used to crowd the hero now live in the TrustBar + Stats sections directly
 * below. A gentle GSAP copy parallax (motion-safe) lives in SmoothScroll.astro
 * via [data-rc-hero].
 */
interface Action {
  text: string;
  href: string;
  target?: string;
}
interface Props {
  title?: string;
  subtitle?: string;
  offer?: string;
  primary?: Action;
  secondary?: Action;
  /** kept for API compatibility */
  art?: string;
  badges?: string[];
}
const {
  title = "India's <em>fastest</em> hosting, minus the big-brand price",
  subtitle = "Pure SSD servers with LiteSpeed, free SSL and daily backups, plus genuinely friendly 24/7 support.",
  offer = "Up to 30% off domains &amp; hosting",
  primary = {
    text: "Get started",
    href: "https://my.royalclouds.net/cart.php",
    target: "_blank",
  },
  secondary = { text: "See plans", href: "#pricing" },
} = Astro.props;
---

<section class="rc-hero" data-rc-hero>
  <div class="rc-sky-veil" aria-hidden="true"></div>

  <div class="wrap rc-hero-grid">
    <div class="rc-hero-copy">
      <span class="hero-eyebrow"
        ><span class="dot"></span><span set:html={pricify(offer)} /></span
      >
      <h1 set:html={title} />
      <p class="rc-sub" set:html={subtitle} />
      <div class="hero-ctas">
        <a
          href={primary.href}
          target={primary.target}
          rel={primary.target === "_blank" ? "noopener" : undefined}
          class="btn btn-primary btn-lg">{primary.text}</a
        >
        <a
          href={secondary.href}
          target={secondary.target}
          class="btn btn-ghost-dark btn-lg">{secondary.text}</a
        >
      </div>
    </div>

    <div class="rc-hero-aside" aria-hidden="true">
      <HeroSkyline class="rc-hero-skyline" />
    </div>
  </div>

  <div class="rc-hero-rule" aria-hidden="true"></div>
</section>

<style>
  .rc-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--rc-grad-vivid);
    color: #fff;
    padding: clamp(48px, 7vw, 96px) 0 clamp(44px, 6vw, 80px);
  }
  /* one soft static bloom for depth */
  .rc-hero::before {
    content: "";
    position: absolute;
    z-index: -2;
    width: min(70vw, 760px);
    aspect-ratio: 1;
    top: -28%;
    right: -10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(30, 150, 232, 0.32) 0%, transparent 66%);
    pointer-events: none;
  }
  .rc-sky-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      120% 100% at 20% 30%,
      rgba(5, 7, 15, 0.5) 0%,
      rgba(5, 7, 15, 0.12) 46%,
      transparent 74%
    );
  }

  .rc-hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 48px;
  }
  .rc-hero-copy {
    position: relative;
    z-index: 1;
    max-width: 620px;
  }
  .rc-hero-aside {
    position: relative;
    z-index: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .rc-hero-aside :global(.rc-hero-skyline) {
    width: clamp(340px, 40vw, 520px);
    height: auto;
  }
  @media (max-width: 980px) {
    .rc-hero-grid {
      display: block;
      max-width: 760px;
    }
    .rc-hero-aside {
      display: none;
    }
  }

  /* white-on-sky overrides */
  .rc-hero :global(.hero-eyebrow) {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .rc-hero :global(.hero-eyebrow .dot) {
    background: var(--rc-yellow);
  }
  .rc-hero h1 {
    color: #fff;
    font-size: clamp(34px, 4.8vw, 56px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.06;
    margin: 20px 0 0;
  }
  .rc-hero h1 :global(em) {
    font-style: normal;
    color: var(--rc-yellow);
    background: linear-gradient(96deg, #ffd680 0%, #f5a524 45%, #ffd680 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .rc-sub {
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
    max-width: 540px;
    margin: 20px 0 0;
  }
  .rc-hero .hero-ctas {
    margin-top: 28px;
  }
  .rc-hero :global(.btn-ghost-dark) {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .rc-hero :global(.btn-ghost-dark:hover) {
    border-color: #fff;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  /* the spectrum "altitude rule" closes the hero */
  .rc-hero-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--spectrum);
    z-index: 1;
  }

  /* living hero: gentle, continuous, low-key motion (motion-safe) */
  @media (prefers-reduced-motion: no-preference) {
    .rc-hero {
      background-size: 150% 150%;
      animation: rcHeroDrift 24s ease-in-out infinite;
    }
    .rc-hero::before {
      animation: rcBloom 10s ease-in-out infinite;
    }
    .rc-hero-aside {
      animation: rcFloatY 8s ease-in-out infinite;
    }
  }
  @keyframes rcHeroDrift {
    0%,
    100% {
      background-position: 0% 0%;
    }
    50% {
      background-position: 100% 100%;
    }
  }
  @keyframes rcBloom {
    0%,
    100% {
      opacity: 0.85;
      transform: translate(0, 0) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-3%, 3%) scale(1.08);
    }
  }
  @keyframes rcFloatY {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  /* page-load entrance (motion-safe) */
  @media (prefers-reduced-motion: no-preference) {
    .rc-hero-copy > * {
      opacity: 0;
      transform: translateY(16px);
      animation: rcRise 0.6s cubic-bezier(0.2, 0.65, 0.25, 1) forwards;
    }
    .rc-hero-copy > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .rc-hero-copy > :nth-child(3) {
      animation-delay: 0.16s;
    }
    .rc-hero-copy > :nth-child(4) {
      animation-delay: 0.24s;
    }
    @keyframes rcRise {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  @media (max-width: 860px) {
    .rc-hero-grid {
      max-width: none;
    }
    .rc-hero-copy {
      text-align: center;
      margin-inline: auto;
    }
    .rc-sub {
      margin-inline: auto;
    }
    .rc-hero .hero-ctas {
      justify-content: center;
    }
  }
  @media (max-width: 560px) {
    .rc-hero h1 {
      font-size: clamp(32px, 8.5vw, 44px);
    }
    .rc-sub {
      font-size: 16px;
    }
    .hero-ctas .btn {
      width: 100%;
    }
  }
</style>
