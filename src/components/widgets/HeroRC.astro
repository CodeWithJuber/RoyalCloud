---
import { Icon } from "astro-icon/components";
import AltitudeScene from "~/components/widgets/AltitudeScene.astro";
import { pricify } from "~/utils/currency";
import site from "~/data/site.json";

/**
 * Royal Clouds home hero — "Living Sky" (STRATOSPHERE signature).
 * A full-bleed WebGL flow-noise aurora/cloudfield (royal → azure with
 * gold motes) reacts to cursor parallax + scroll drift behind crisp
 * Bricolage display type. The animated canvas sits over the static
 * --rc-grad-vivid gradient, so if WebGL is unavailable, low-power, or
 * prefers-reduced-motion is set, the gradient simply shows through —
 * zero CLS, no broken state.
 */
interface Action {
  text: string;
  href: string;
  target?: string;
}
interface Props {
  title?: string;
  subtitle?: string;
  offer?: string;
  primary?: Action;
  secondary?: Action;
  badges?: string[];
  /** kept for API compatibility; the Living Sky replaces the old art slot */
  art?: string;
}
const {
  title = "India's <em>fastest</em> hosting — minus the big-brand price",
  subtitle = "Pure SSD RAID-10 servers with LiteSpeed, CloudLinux, free cPanel &amp; SSL, daily backups and genuinely friendly 24/7 support.",
  offer = "Up to 30% off domains &amp; hosting",
  primary = {
    text: "Get Started",
    href: "https://my.royalclouds.net/cart.php",
    target: "_blank",
  },
  secondary = { text: "View Plans", href: "#pricing" },
  badges = [
    "99.99% Uptime SLA",
    "Free SSL Certificate",
    "30-Day Money-Back",
    "Instant Setup",
  ],
} = Astro.props;
---

<section class="rc-hero" data-rc-hero>
  <canvas class="rc-sky" data-rc-sky aria-hidden="true"></canvas>
  <div class="rc-sky-veil" aria-hidden="true"></div>

  <div class="wrap rc-hero-grid">
    <div class="rc-hero-copy">
      <span class="hero-eyebrow"
        ><span class="dot"></span><span set:html={pricify(offer)} /></span
      >
      <h1 set:html={title} />
      <p class="rc-sub" set:html={subtitle} />
      <ul class="hero-badges rc-badges">
        {badges.map((b) => <li class="b">{b}</li>)}
      </ul>
      <p
        class="rc-from"
        set:html={pricify(
          `From <em>${site.startingPrice}/mo</em> · Free SSL &amp; migration`,
        )}
      />
      <div class="hero-ctas">
        <a
          href={primary.href}
          target={primary.target}
          rel={primary.target === "_blank" ? "noopener" : undefined}
          class="btn btn-primary btn-lg">{primary.text}</a
        >
        <a
          href={secondary.href}
          target={secondary.target}
          class="btn btn-ghost-dark btn-lg">{secondary.text}</a
        >
      </div>
      <p class="cta-fine">
        Risk free: 30-day money-back guarantee · Instant setup
      </p>
    </div>

    <div class="rc-hero-aside" aria-hidden="true">
      <AltitudeScene variant="dark" class="rc-hero-altitude" />
    </div>
  </div>

  <div class="wrap">
    <div class="rating-strip rc-rating">
      <span class="stars" aria-hidden="true">
        <Icon name="tabler:star-filled" />
        <Icon name="tabler:star-filled" />
        <Icon name="tabler:star-filled" />
        <Icon name="tabler:star-filled" />
        <Icon name="tabler:star-filled" />
      </span>
      <span
        ><b>Excellent</b> — rated {site.rating}/{site.ratingMax} by our customers</span
      >
      <span class="rc-rating-sep" aria-hidden="true"></span>
      <span
        ><b>Since {site.since}</b> — {new Date().getFullYear() - site.since}+ years
        hosting India's websites</span
      >
    </div>
  </div>

  <div class="rc-hero-rule" aria-hidden="true"></div>
</section>

<script>
  // ── Living Sky: a single-pass GLSL fbm cloudfield reacting to cursor + scroll.
  // Self-contained, dependency-free, ~one draw call. Degrades to the CSS
  // gradient on no-WebGL / low-power / reduced-motion.
  type SkyHandle = { destroy: () => void };

  function initSky(canvas: HTMLCanvasElement): SkyHandle | null {
    const gl = (canvas.getContext("webgl", {
      antialias: false,
      alpha: true,
      premultipliedAlpha: false,
      powerPreference: "low-power",
    }) ||
      canvas.getContext("experimental-webgl")) as WebGLRenderingContext | null;
    if (!gl) return null;

    const vert = `
      attribute vec2 a_pos;
      void main(){ gl_Position = vec4(a_pos, 0.0, 1.0); }
    `;
    const frag = `
      precision mediump float;
      uniform vec2 u_res;
      uniform float u_time;
      uniform vec2 u_mouse;
      uniform float u_scroll;

      float hash(vec2 p){
        p = fract(p * vec2(123.34, 456.21));
        p += dot(p, p + 45.32);
        return fract(p.x * p.y);
      }
      float noise(vec2 p){
        vec2 i = floor(p); vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        return mix(mix(hash(i + vec2(0.0,0.0)), hash(i + vec2(1.0,0.0)), u.x),
                   mix(hash(i + vec2(0.0,1.0)), hash(i + vec2(1.0,1.0)), u.x), u.y);
      }
      float fbm(vec2 p){
        float v = 0.0; float a = 0.5;
        for(int i = 0; i < 5; i++){ v += a * noise(p); p *= 2.02; a *= 0.5; }
        return v;
      }
      void main(){
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        vec2 p = uv; p.x *= u_res.x / u_res.y;
        float t = u_time * 0.018;
        vec2 drift = vec2(u_mouse.x * 0.10 + t, -u_mouse.y * 0.06 - u_scroll * 0.30);
        float n  = fbm(p * 1.7 + drift);
        float n2 = fbm(p * 3.3 - drift * 0.7 + 4.0);

        vec3 deep  = vec3(0.066, 0.018, 0.207);
        vec3 royal = vec3(0.318, 0.067, 0.878);
        vec3 azure = vec3(0.098, 0.714, 1.0);
        vec3 gold  = vec3(1.0, 0.714, 0.153);

        vec3 col = mix(deep, royal, smoothstep(0.15, 0.95, n));
        col = mix(col, azure, smoothstep(0.45, 1.05, n2) * 0.55 * (1.0 - uv.y * 0.6));
        float motes = pow(fbm(p * 6.5 + vec2(t * 2.2, -t)), 7.0);
        col += gold * motes * 0.9 * smoothstep(0.0, 0.7, uv.y);
        // soft top-darken + corner vignette so headline type stays legible
        col *= 0.82 + 0.18 * smoothstep(0.0, 0.55, uv.y);
        float vig = smoothstep(1.25, 0.25, distance(uv, vec2(0.5)));
        col *= 0.78 + 0.22 * vig;
        gl_FragColor = vec4(col, 1.0);
      }
    `;

    const compile = (type: number, src: string): WebGLShader | null => {
      const s = gl.createShader(type);
      if (!s) return null;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
        gl.deleteShader(s);
        return null;
      }
      return s;
    };
    const vs = compile(gl.VERTEX_SHADER, vert);
    const fs = compile(gl.FRAGMENT_SHADER, frag);
    if (!vs || !fs) return null;
    const prog = gl.createProgram();
    if (!prog) return null;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return null;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    const loc = gl.getAttribLocation(prog, "a_pos");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, "u_res");
    const uTime = gl.getUniformLocation(prog, "u_time");
    const uMouse = gl.getUniformLocation(prog, "u_mouse");
    const uScroll = gl.getUniformLocation(prog, "u_scroll");

    let mx = 0.5;
    let my = 0.4;
    let tmx = 0.5;
    let tmy = 0.4;
    let scroll = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);

    const resize = () => {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    resize();

    const onMove = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      tmx = (e.clientX - r.left) / r.width;
      tmy = (e.clientY - r.top) / r.height;
    };
    const onScroll = () => {
      const r = canvas.getBoundingClientRect();
      scroll = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height)));
    };
    window.addEventListener("pointermove", onMove, { passive: true });
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", resize);

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let visible = true;
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) visible = en.isIntersecting;
      },
      { threshold: 0 },
    );
    io.observe(canvas);

    let raf = 0;
    const start = performance.now();
    const draw = () => {
      mx += (tmx - mx) * 0.05;
      my += (tmy - my) * 0.05;
      const time = reduce ? 0 : (performance.now() - start) / 1000;
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, time);
      gl.uniform2f(uMouse, mx, my);
      gl.uniform1f(uScroll, scroll);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    // first paint always happens; animate only when visible + motion allowed
    draw();
    if (!reduce) {
      const tick = () => {
        if (visible) draw();
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    }

    return {
      destroy() {
        cancelAnimationFrame(raf);
        io.disconnect();
        window.removeEventListener("pointermove", onMove);
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", resize);
      },
    };
  }

  let handle: SkyHandle | null = null;
  const boot = () => {
    handle?.destroy();
    handle = null;
    const c = document.querySelector<HTMLCanvasElement>("[data-rc-sky]");
    if (c) handle = initSky(c);
    if (c && !handle) c.style.display = "none"; // fall back to CSS gradient
  };
  boot();
  // re-init across Astro view transitions
  document.addEventListener("astro:after-swap", boot);
  document.addEventListener("astro:before-swap", () => handle?.destroy());
</script>

<style>
  .rc-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--rc-grad-vivid);
    color: #fff;
    padding: clamp(72px, 11vw, 150px) 0 clamp(56px, 7vw, 96px);
  }
  /* the animated sky sits over the gradient fallback */
  .rc-sky {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* legibility veil: darkens the upper-left where the copy lives */
  .rc-sky-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      120% 100% at 20% 30%,
      rgba(5, 7, 15, 0.55) 0%,
      rgba(5, 7, 15, 0.18) 42%,
      transparent 72%
    );
  }

  .rc-hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 48px;
  }
  .rc-hero-copy {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }
  /* desktop-only balancing scene over the sky */
  .rc-hero-aside {
    position: relative;
    z-index: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .rc-hero-aside :global(.rc-hero-altitude) {
    width: clamp(320px, 34vw, 460px);
    height: auto;
    filter: drop-shadow(0 30px 80px rgba(5, 7, 15, 0.45));
  }
  @media (max-width: 980px) {
    .rc-hero-grid {
      display: block;
      max-width: 820px;
    }
    .rc-hero-aside {
      display: none;
    }
  }

  /* white-on-sky overrides */
  .rc-hero :global(.hero-eyebrow) {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .rc-hero :global(.hero-eyebrow .dot) {
    background: var(--rc-yellow);
  }
  .rc-hero h1 {
    color: #fff;
    font-size: clamp(40px, 6.2vw, 76px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 22px 0 0;
  }
  .rc-hero h1 :global(em) {
    font-style: normal;
    color: var(--rc-yellow);
    background: none;
    -webkit-text-fill-color: var(--rc-yellow);
  }
  .rc-sub {
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
    max-width: 600px;
    margin: 22px 0 0;
  }
  .rc-badges {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: start;
    gap: 12px 36px;
  }
  .rc-hero :global(.hero-badges .b) {
    color: rgba(255, 255, 255, 0.92);
  }
  .rc-hero :global(.hero-badges .b)::before {
    background: rgba(255, 255, 255, 0.16);
    color: var(--rc-yellow);
  }
  .rc-from {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #fff;
    margin: 26px 0 0;
  }
  .rc-from :global(em) {
    font-style: normal;
    color: var(--rc-yellow);
  }
  .rc-hero .hero-ctas {
    margin-top: 22px;
  }
  .rc-hero :global(.btn-ghost-dark) {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .rc-hero :global(.btn-ghost-dark:hover) {
    border-color: #fff;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }
  .rc-hero :global(.cta-fine) {
    color: rgba(255, 255, 255, 0.66);
  }

  /* rating strip */
  .rc-rating {
    position: relative;
    z-index: 1;
    margin-top: clamp(40px, 5vw, 60px);
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.8);
  }
  .rc-rating :global(b) {
    color: #fff;
  }
  .rc-rating-sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
  }

  /* the spectrum "altitude rule" closes the hero and hands off to content */
  .rc-hero-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--spectrum);
    z-index: 1;
  }

  /* page-load entrance (motion-safe) */
  @media (prefers-reduced-motion: no-preference) {
    .rc-hero-copy > * {
      opacity: 0;
      transform: translateY(18px);
      animation: rcRise 0.7s cubic-bezier(0.2, 0.65, 0.25, 1) forwards;
    }
    .rc-hero-copy > :nth-child(2) {
      animation-delay: 0.07s;
    }
    .rc-hero-copy > :nth-child(3) {
      animation-delay: 0.14s;
    }
    .rc-hero-copy > :nth-child(4) {
      animation-delay: 0.21s;
    }
    .rc-hero-copy > :nth-child(5) {
      animation-delay: 0.28s;
    }
    .rc-hero-copy > :nth-child(6) {
      animation-delay: 0.35s;
    }
    .rc-hero-copy > :nth-child(7) {
      animation-delay: 0.42s;
    }
    .rc-rating {
      opacity: 0;
      animation: rcRise 0.8s cubic-bezier(0.2, 0.65, 0.25, 1) 0.5s forwards;
    }
    @keyframes rcRise {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  @media (max-width: 860px) {
    .rc-hero-grid {
      max-width: none;
    }
    .rc-badges {
      gap: 12px 24px;
    }
  }
  @media (max-width: 560px) {
    .rc-hero h1 {
      font-size: clamp(34px, 9.5vw, 46px);
    }
    .rc-sub {
      font-size: 16px;
    }
    .rc-rating {
      font-size: 13px;
      gap: 8px 12px;
    }
    .rc-badges :global(.b) {
      font-size: 13px;
    }
    .hero-ctas .btn {
      width: 100%;
    }
  }
</style>
