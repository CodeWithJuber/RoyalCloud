---
import { Image } from "astro:assets";
import mascot from "~/assets/images/brand/mascot.png";
import cloud from "~/assets/images/brand/cloud.png";
import cloudServer from "~/assets/images/brand/cloud-server.png";

interface Action {
  text: string;
  href: string;
  target?: string;
}
interface Props {
  title?: string;
  subtitle?: string;
  offer?: string;
  primary?: Action;
  secondary?: Action;
  badges?: string[];
}
const {
  title = "Experience the Premium &amp; Speed-Optimized Hosting",
  subtitle = "Pure SSD RAID-10 servers with LiteSpeed, CloudLinux, free cPanel &amp; SSL, daily backups and genuinely friendly 24/7 support.",
  offer = "Up to 30% off domains &amp; hosting · from $1.99/mo · Free SSL",
  primary = {
    text: "Get Started",
    href: "https://my.royalclouds.net/cart.php",
    target: "_blank",
  },
  secondary = { text: "View Plans", href: "#pricing" },
  badges = [
    "99.99% Uptime SLA",
    "Free SSL Certificate",
    "30-Day Money-Back",
    "Instant Setup",
  ],
} = Astro.props;
---

<section class="rc-hero relative overflow-hidden text-white">
  <!-- gradient + decorative blobs -->
  <div
    class="absolute inset-0 -z-10"
    style="background:linear-gradient(125deg,#5b34d6 0%,#7652f2 42%,#00a7f5 100%)"
  >
  </div>
  <div
    class="absolute -z-10 top-[-10%] right-[-6%] w-[40rem] h-[40rem] rounded-full opacity-30 blur-3xl"
    style="background:radial-gradient(circle,#00a7f5,transparent 60%)"
  >
  </div>
  <div
    class="absolute -z-10 bottom-[-20%] left-[-10%] w-[36rem] h-[36rem] rounded-full opacity-30 blur-3xl"
    style="background:radial-gradient(circle,#fdd700,transparent 60%)"
  >
  </div>
  <!-- dotted grid -->
  <div
    class="absolute inset-0 -z-10 opacity-[0.12]"
    style="background-image:radial-gradient(#fff 1px,transparent 1px);background-size:26px 26px"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-28 pb-16 md:pt-36 md:pb-24">
    <div class="grid md:grid-cols-2 gap-8 md:gap-6 items-center">
      <div class="text-center md:text-left">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-white/15 ring-1 ring-white/25 px-4 py-1.5 text-sm font-semibold backdrop-blur"
        >
          <span class="inline-block w-2 h-2 rounded-full bg-[#fdd700]"></span>
          <span set:html={offer} />
        </span>
        <h1
          class="mt-5 font-extrabold tracking-tight text-4xl md:text-5xl lg:text-6xl leading-[1.07]"
          style="font-family:var(--aw-font-heading)"
          set:html={title}
        />
        <p
          class="mt-5 text-lg md:text-xl text-white/85 max-w-xl mx-auto md:mx-0"
          set:html={subtitle}
        />
        <div class="mt-8 flex flex-wrap gap-3 justify-center md:justify-start">
          <a href={primary.href} target={primary.target} class="btn btn-primary"
            >{primary.text}</a
          >
          <a
            href={secondary.href}
            target={secondary.target}
            class="btn btn-ghost-light"
            >{secondary.text}</a
          >
        </div>
        <ul
          class="mt-8 flex flex-wrap gap-x-6 gap-y-2 justify-center md:justify-start text-sm font-medium text-white/90"
        >
          {
            badges.map((b) => (
              <li class="inline-flex items-center gap-1.5">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#fdd700"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {b}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- mascot + floating cloud cards -->
      <div class="relative h-[360px] sm:h-[440px] md:h-[480px]">
        <div class="absolute inset-0 flex items-center justify-center">
          <div
            class="absolute w-[19rem] h-[19rem] sm:w-[23rem] sm:h-[23rem] rounded-full border border-white/15"
          >
          </div>
          <div
            class="absolute w-[14rem] h-[14rem] sm:w-[17rem] sm:h-[17rem] rounded-full border border-white/10"
          >
          </div>
          <Image
            src={mascot}
            alt="Royal Clouds mascot"
            width={230}
            height={478}
            class="relative z-10 w-[150px] sm:w-[185px] md:w-[210px] h-auto drop-shadow-2xl rc-float"
          />
        </div>
        <Image
          src={cloud}
          alt=""
          width={120}
          height={90}
          class="absolute z-20 top-6 left-2 w-16 sm:w-24 rc-float-slow"
        />
        <Image
          src={cloudServer}
          alt=""
          width={120}
          height={120}
          class="absolute z-20 bottom-8 right-2 w-16 sm:w-24 rc-float"
        />
        <Image
          src={cloud}
          alt=""
          width={90}
          height={70}
          class="absolute z-0 bottom-4 left-8 w-12 sm:w-16 opacity-80 rc-float-slow"
        />
      </div>
    </div>
  </div>

  <!-- bottom wave into white -->
  <svg
    class="block w-full h-[40px] sm:h-[64px]"
    viewBox="0 0 1440 80"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0 80 L0 40 C 240 80 480 80 720 50 C 960 20 1200 20 1440 50 L1440 80 Z"
      fill="#ffffff"></path>
  </svg>
</section>

<style>
  .rc-float {
    animation: rcFloat 6s ease-in-out infinite;
  }
  .rc-float-slow {
    animation: rcFloat 8s ease-in-out infinite;
  }
  @keyframes rcFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rc-float,
    .rc-float-slow {
      animation: none;
    }
  }
</style>
