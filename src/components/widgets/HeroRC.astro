---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import SectionArt from "~/components/sections/SectionArt.astro";
import mascot from "~/assets/images/brand/mascot.png";
import cloud from "~/assets/images/brand/cloud.png";
import cloudServer from "~/assets/images/brand/cloud-server.png";
import site from "~/data/site.json";

/**
 * Royal Clouds home hero — light, friendly, illustration-led.
 * SiteGround anatomy: offer chip, huge ink headline, check bullets,
 * orange pill CTA with money-back fine print; the brand mascot on a
 * soft cloud disc with floating proof cards on the right; a
 * Trustpilot-style rating strip across the bottom.
 */
interface Action {
  text: string;
  href: string;
  target?: string;
}
interface Props {
  title?: string;
  subtitle?: string;
  offer?: string;
  primary?: Action;
  secondary?: Action;
  badges?: string[];
  /** Themed illustration scene — replaces mascot + proof chips (SectionArt kind). */
  art?: string;
}
const {
  title = "Experience the <em>Premium</em> &amp; Speed-Optimized Hosting",
  subtitle = "Pure SSD RAID-10 servers with LiteSpeed, CloudLinux, free cPanel &amp; SSL, daily backups and genuinely friendly 24/7 support.",
  offer = "Up to 30% off domains &amp; hosting",
  primary = {
    text: "Get Started",
    href: "https://my.royalclouds.net/cart.php",
    target: "_blank",
  },
  secondary = { text: "View Plans", href: "#pricing" },
  badges = [
    "99.99% Uptime SLA",
    "Free SSL Certificate",
    "30-Day Money-Back",
    "Instant Setup",
  ],
  art,
} = Astro.props;
---

<section class="rc-hero">
  <div class="wrap rc-hero-grid">
    <div class="rc-hero-copy">
      <span class="hero-eyebrow"
        ><span class="dot"></span><span set:html={offer} /></span
      >
      <h1 set:html={title} />
      <p class="rc-sub" set:html={subtitle} />
      <ul class="hero-badges rc-badges">
        {badges.map((b) => <li class="b">{b}</li>)}
      </ul>
      <p class="rc-from">
        From <em>{site.startingPrice}/mo</em> · Free SSL &amp; migration
      </p>
      <div class="hero-ctas">
        <a
          href={primary.href}
          target={primary.target}
          rel={primary.target === "_blank" ? "noopener" : undefined}
          class="btn btn-primary btn-lg">{primary.text}</a
        >
        <a
          href={secondary.href}
          target={secondary.target}
          class="btn btn-ghost-dark btn-lg">{secondary.text}</a
        >
      </div>
      <p class="cta-fine">
        Risk free: 30-day money-back guarantee · Instant setup
      </p>
    </div>

    <div class="rc-hero-art" aria-hidden="true">
      <div class="rc-disc"></div>
      <Image
        src={cloud}
        alt=""
        width={120}
        height={90}
        class="rc-cloud rc-cloud-1 rc-float-slow"
      />
      <Image
        src={cloud}
        alt=""
        width={90}
        height={70}
        class="rc-cloud rc-cloud-2 rc-float-slow"
      />
      {
        art ? (
          <div class="rc-scene">
            <SectionArt kind={art} bare />
          </div>
        ) : (
          <Image
            src={mascot}
            alt=""
            width={230}
            height={478}
            loading="eager"
            class="rc-mascot rc-float"
          />
        )
      }
      {
        !art && (
          <Image
            src={cloudServer}
            alt=""
            width={120}
            height={120}
            class="rc-cloud rc-cloud-3 rc-float"
          />
        )
      }

      {!art && (
        <>
      <div class="rc-chip rc-chip-uptime rc-float-slow">
        <span class="ic ic-green">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg
          >
        </span>
        <span><b>99.99%</b><small>Uptime SLA</small></span>
      </div>
      <div class="rc-chip rc-chip-speed rc-float">
        <span class="ic ic-violet">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"></path></svg
          >
        </span>
        <span><b>15x faster</b><small>SSD + LiteSpeed</small></span>
      </div>
      <div class="rc-chip rc-chip-ssl rc-float-slower">
        <span class="ic ic-blue">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="4" y="11" width="16" height="10" rx="2"></rect><path
              d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg
          >
        </span>
        <span><b>Free SSL</b><small>on every site</small></span>
      </div>
        </>
      )}
    </div>
  </div>

  <div class="wrap">
    <div class="rating-strip rc-rating">
      <span class="stars" aria-hidden="true">
        <Icon name="tabler:star-filled" />
        <Icon name="tabler:star-filled" />
        <Icon name="tabler:star-filled" />
        <Icon name="tabler:star-filled" />
        <Icon name="tabler:star-filled" />
      </span>
      <span
        ><b>Excellent</b> — rated {site.rating}/{site.ratingMax} by our customers</span
      >
      <span class="rc-rating-sep" aria-hidden="true"></span>
      <span>Trusted by thousands of website owners</span>
    </div>
  </div>
</section>

<style>
  .rc-hero {
    position: relative;
    overflow: hidden;
    background: var(--rc-grad-vivid);
    color: #fff;
    padding: clamp(48px, 6vw, 84px) 0 clamp(40px, 5vw, 56px);
  }
  /* white-on-gradient overrides (original royalclouds.net hero) */
  .rc-hero :global(.hero-eyebrow) {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(6px);
  }
  .rc-hero :global(.hero-eyebrow .dot) {
    background: var(--rc-yellow);
  }
  .rc-hero h1 {
    color: #fff;
  }
  .rc-hero h1 :global(em) {
    color: var(--rc-yellow);
  }
  .rc-hero :global(.hero-badges .b) {
    color: rgba(255, 255, 255, 0.92);
  }
  .rc-hero :global(.hero-badges .b)::before {
    background: rgba(255, 255, 255, 0.18);
    color: var(--rc-yellow);
  }
  .rc-hero :global(.btn-ghost-dark) {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .rc-hero :global(.btn-ghost-dark:hover) {
    border-color: #fff;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  .rc-hero :global(.cta-fine) {
    color: rgba(255, 255, 255, 0.65);
  }
  .rc-hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 56px;
    align-items: center;
  }

  .rc-hero h1 {
    font-size: clamp(36px, 4.6vw, 58px);
    font-weight: 700;
    letter-spacing: -0.028em;
    margin: 24px 0 0;
  }
  .rc-sub {
    font-size: 18px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
    max-width: 530px;
    margin: 20px 0 0;
  }
  .rc-badges {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .rc-from {
    font-family: var(--font-heading);
    font-size: 17.5px;
    font-weight: 700;
    color: #fff;
    margin: 24px 0 0;
  }
  .rc-from em {
    font-style: normal;
    color: var(--rc-yellow);
  }
  .rc-hero .hero-ctas {
    margin-top: 20px;
  }

  /* rating strip across the bottom */
  .rc-rating {
    margin-top: clamp(40px, 5vw, 56px);
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.8);
  }
  .rc-rating :global(b) {
    color: #fff;
  }
  .rc-rating-sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
  }

  /* illustration */
  .rc-hero-art {
    position: relative;
    height: 440px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rc-disc {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 60%,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0.04) 55%,
      transparent 72%
    );
    border: 1.5px solid rgba(255, 255, 255, 0.22);
  }
  .rc-disc::after {
    content: "";
    position: absolute;
    inset: 34px;
    border-radius: 50%;
    border: 1.5px dashed rgba(255, 255, 255, 0.28);
  }
  .rc-mascot {
    position: relative;
    z-index: 2;
    width: 190px;
    height: auto;
    filter: drop-shadow(0 30px 34px rgba(0, 0, 0, 0.4));
  }
  .rc-scene {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .rc-cloud {
    position: absolute;
    height: auto;
    z-index: 1;
    opacity: 0.6;
  }
  .rc-cloud-1 {
    width: 84px;
    top: 12px;
    left: 26px;
  }
  .rc-cloud-2 {
    width: 52px;
    bottom: 46px;
    left: 64px;
    opacity: 0.45;
  }
  .rc-cloud-3 {
    width: 80px;
    top: 18px;
    right: 36px;
  }

  .rc-chip {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 11px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 11px 16px;
    box-shadow: var(--shadow-md);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .rc-chip:hover {
    box-shadow: var(--shadow-lg);
  }
  .rc-chip b {
    display: block;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--rc-ink);
    line-height: 1.2;
  }
  .rc-chip small {
    display: block;
    font-size: 11.5px;
    color: var(--text-muted);
    line-height: 1.3;
  }
  .rc-chip .ic {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: grid;
    place-items: center;
  }
  .rc-chip .ic svg {
    width: 18px;
    height: 18px;
  }
  .ic-green {
    background: var(--ok-soft);
    color: #0e9f6e;
  }
  .ic-violet {
    background: var(--bg-tint-strong);
    color: var(--rc-violet);
  }
  .ic-blue {
    background: var(--pastel-sky);
    color: var(--rc-blue);
  }
  .rc-chip-uptime {
    top: 26px;
    right: 6px;
  }
  .rc-chip-speed {
    bottom: 38px;
    right: 28px;
  }
  .rc-chip-ssl {
    bottom: 110px;
    left: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rc-float {
      animation: rcFloat 6s ease-in-out infinite;
    }
    .rc-float-slow {
      animation: rcFloat 7.4s ease-in-out infinite 1.1s;
    }
    .rc-float-slower {
      animation: rcFloat 9.2s ease-in-out infinite 2.3s;
    }
    @keyframes rcFloat {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }
    /* page-load entrance */
    .rc-hero-copy > * {
      opacity: 0;
      transform: translateY(18px);
      animation: rcRise 0.7s cubic-bezier(0.2, 0.65, 0.25, 1) forwards;
    }
    .rc-hero-copy > :nth-child(2) {
      animation-delay: 0.07s;
    }
    .rc-hero-copy > :nth-child(3) {
      animation-delay: 0.14s;
    }
    .rc-hero-copy > :nth-child(4) {
      animation-delay: 0.21s;
    }
    .rc-hero-copy > :nth-child(5) {
      animation-delay: 0.28s;
    }
    .rc-hero-copy > :nth-child(6) {
      animation-delay: 0.35s;
    }
    .rc-hero-copy > :nth-child(7) {
      animation-delay: 0.42s;
    }
    .rc-hero-art {
      opacity: 0;
      animation: rcRise 0.8s cubic-bezier(0.2, 0.65, 0.25, 1) 0.2s forwards;
    }
    .rc-rating {
      opacity: 0;
      animation: rcRise 0.8s cubic-bezier(0.2, 0.65, 0.25, 1) 0.5s forwards;
    }
    @keyframes rcRise {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  @media (max-width: 1080px) {
    .rc-chip-ssl {
      left: -8px;
    }
  }
  @media (max-width: 860px) {
    .rc-hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .rc-hero-copy {
      text-align: center;
    }
    .rc-sub {
      margin-left: auto;
      margin-right: auto;
    }
    .rc-hero .hero-ctas,
    .rc-badges {
      justify-content: center;
    }
    .rc-hero-art {
      height: 380px;
    }
    .rc-disc {
      width: 330px;
      height: 330px;
    }
    .rc-mascot {
      width: 160px;
    }
  }
  @media (max-width: 560px) {
    .rc-hero h1 {
      font-size: 30px;
    }
    .rc-sub {
      font-size: 16px;
    }
    .rc-from {
      font-size: 16px;
    }
    .rc-rating {
      font-size: 13px;
      gap: 8px 12px;
    }
    .rc-hero-art {
      height: 330px;
    }
    .rc-disc {
      width: 280px;
      height: 280px;
    }
    .rc-mascot {
      width: 136px;
    }
    .rc-chip {
      padding: 9px 12px;
    }
    .rc-chip .ic {
      width: 30px;
      height: 30px;
    }
    .rc-chip-uptime {
      top: 12px;
      right: -4px;
    }
    .rc-chip-speed {
      right: -2px;
      bottom: 16px;
    }
    .rc-chip-ssl {
      left: -8px;
      bottom: 104px;
    }
    .rc-cloud-1 {
      width: 64px;
      top: 4px;
      left: 4px;
    }
    .rc-cloud-2 {
      display: none;
    }
    .rc-cloud-3 {
      width: 60px;
      top: 8px;
      right: 6px;
    }
  }
</style>
