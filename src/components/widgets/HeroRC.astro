---
import { Image } from "astro:assets";
import datacenter from "~/assets/images/photos/datacenter.jpg";
import { pricify } from "~/utils/currency";

interface Action {
  text: string;
  href: string;
  target?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  offer?: string;
  primary?: Action;
  secondary?: Action;
  art?: string;
  badges?: string[];
}

const {
  title = "Fast hosting. <em>No slow days.</em>",
  subtitle = "Pure SSD infrastructure, LiteSpeed, daily backups and real 24/7 support. Everything essential is included from day one.",
  offer = "Hosting from $1.59/mo · 30-day money-back guarantee",
  primary = {
    text: "Choose your plan",
    href: "https://my.royalclouds.net/cart.php",
    target: "_blank",
  },
  secondary = { text: "Explore hosting", href: "#hosting" },
} = Astro.props;
---

<section class="rc-hero" data-rc-hero aria-labelledby="home-title">
  <div class="rc-hero-media">
    <Image
      src={datacenter}
      alt="Royal Clouds server infrastructure"
      widths={[960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="rc-hero-image"
    />
  </div>
  <div class="rc-hero-wash" aria-hidden="true"></div>
  <div class="rc-hero-grid" aria-hidden="true"></div>

  <div class="wrap rc-hero-inner">
    <p class="rc-hero-kicker"><span></span><span set:html={pricify(offer)} /></p>
    <h1 id="home-title" set:html={title} />
    <p class="rc-sub" set:html={subtitle} />
    <div class="hero-ctas">
      <a
        href={primary.href}
        target={primary.target}
        rel={primary.target === "_blank" ? "noopener" : undefined}
        class="btn btn-primary btn-lg"
      >
        {primary.text}
      </a>
      <a
        href={secondary.href}
        target={secondary.target}
        class="btn btn-ghost-light btn-lg"
      >
        {secondary.text}
      </a>
    </div>
  </div>

  <div class="rc-hero-foot" aria-hidden="true">
    <span>SSD RAID-10</span>
    <i></i>
    <span>LiteSpeed edge</span>
    <i></i>
    <span>Human support</span>
  </div>
</section>

<style>
  .rc-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: min(880px, calc(100dvh - 42px));
    overflow: hidden;
    padding: clamp(110px, 15vw, 190px) 0 clamp(104px, 13vw, 160px);
    background: var(--rc-night);
    color: #fff;
  }
  .rc-hero-media {
    position: absolute;
    inset: 0;
    z-index: -4;
    overflow: hidden;
  }
  .rc-hero-media :global(.rc-hero-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.58) contrast(1.16);
    transform: scale(0.86);
    opacity: 0.72;
  }
  .rc-hero-wash {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(circle at 50% 42%, rgba(34, 16, 95, 0.18), rgba(34, 16, 95, 0.85) 68%),
      linear-gradient(180deg, rgba(34, 16, 95, 0.6), rgba(24, 10, 72, 0.96));
  }
  .rc-hero-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.14) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(circle at center, #000, transparent 76%);
  }
  .rc-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .rc-hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 26px;
    color: rgba(255, 255, 255, 0.72);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .rc-hero-kicker span:first-child {
    width: 8px;
    height: 8px;
    background: var(--rc-gold);
    box-shadow: 0 0 22px rgba(253, 215, 0, 0.65);
  }
  .rc-hero h1 {
    width: 100%;
    max-width: 70rem;
    margin: 0;
    color: #fff;
    font-size: clamp(3.1rem, 6.7vw, 6.8rem);
    font-weight: 650;
    letter-spacing: -0.062em;
    line-height: 0.92;
    text-wrap: balance;
  }
  .rc-hero h1 :global(em) {
    color: var(--rc-gold);
    font-style: normal;
    -webkit-text-fill-color: currentColor;
    background: none;
  }
  .rc-sub {
    max-width: 43rem;
    margin: 30px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.45vw, 1.25rem);
    line-height: 1.62;
  }
  .rc-hero .hero-ctas {
    justify-content: center;
    margin-top: 38px;
  }
  .rc-hero :global(.btn-primary) {
    color: var(--rc-night);
    background: var(--rc-gold);
    box-shadow: 0 18px 42px -16px rgba(200, 170, 0, 0.6);
  }
  .rc-hero :global(.btn-ghost-light) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(34, 16, 95, 0.34);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
  }
  .rc-hero :global(.btn-ghost-light:hover) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.1);
  }
  .rc-hero-foot {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 54px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.52);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }
  .rc-hero-foot i {
    width: 3px;
    height: 3px;
    background: var(--rc-gold);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rc-hero-inner > * {
      opacity: 0;
      transform: translateY(24px);
      animation: rcHeroEnter 0.9s var(--ease-out) forwards;
    }
    .rc-hero-inner > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .rc-hero-inner > :nth-child(3) {
      animation-delay: 0.16s;
    }
    .rc-hero-inner > :nth-child(4) {
      animation-delay: 0.24s;
    }
  }
  @keyframes rcHeroEnter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 720px) {
    .rc-hero {
      place-items: start center;
      min-height: 720px;
      padding-block: 92px 110px;
    }
    .rc-hero h1 {
      font-size: clamp(2.65rem, 11vw, 3.4rem);
      line-height: 0.96;
    }
    .rc-hero-kicker {
      max-width: 19rem;
      justify-content: center;
      line-height: 1.5;
    }
    .rc-sub {
      margin-top: 24px;
      font-size: 1rem;
    }
    .rc-hero .hero-ctas {
      width: min(100%, 24rem);
      margin-top: 30px;
    }
    .rc-hero .hero-ctas :global(.btn) {
      width: 100%;
    }
    .rc-hero-foot {
      gap: 10px;
      padding-inline: 14px;
      font-size: 8px;
    }
  }
</style>
