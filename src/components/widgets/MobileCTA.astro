---
/**
 * Sticky mobile action bar — keeps the primary conversion action in the
 * thumb zone on phones (Fitts's Law + thumb-friendly placement, uxpilot).
 * Appears after the hero, hides itself when the footer/final CTA is in view
 * so it never covers them. Mobile only; respects reduced-motion.
 */
import site from "~/data/site.json";
---

<div class="mcta" id="rcMobileCta" hidden aria-hidden="true">
  <a class="btn btn-ghost-dark mcta-plans" href="#pricing">View Plans</a>
  <a
    class="btn btn-primary mcta-go"
    href={site.portal.cart}
    target="_blank"
    rel="noopener">Get Started</a
  >
</div>

<style>
  .mcta {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 45;
    display: none;
    gap: 10px;
    padding: 10px;
    border-radius: 999px;
    background: var(--glass-bg-dark, rgba(33, 18, 92, 0.5));
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 14px 40px -10px rgba(15, 8, 50, 0.6);
  }
  .mcta .btn {
    flex: 1 1 0;
    justify-content: center;
    min-height: 50px;
    padding: 0 14px;
    font-size: 15px;
  }
  .mcta .mcta-plans {
    flex: 0 0 38%;
  }
  /* show only on phones, and only once revealed by JS */
  @media (max-width: 860px) {
    .mcta.is-on {
      display: flex;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .mcta.is-on {
      animation: mcta-rise 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
  @keyframes mcta-rise {
    from {
      opacity: 0;
      transform: translateY(120%);
    }
  }
</style>

<script>
  function rcMobileCtaInit() {
    const bar = document.getElementById("rcMobileCta");
    if (!bar || bar.dataset.ready) return;
    bar.dataset.ready = "1";

    const show = (on: boolean) => {
      bar.classList.toggle("is-on", on);
      bar.hidden = !on;
      bar.setAttribute("aria-hidden", String(!on));
    };

    // Hide while the hero or the footer / final CTA is on screen; show in between.
    const hero = document.querySelector(".rc-hero, .p-hero, .s-hero");
    const tail = document.querySelector(".site-footer, .final-cta");
    let heroVisible = true;
    let tailVisible = false;
    const update = () => show(!heroVisible && !tailVisible);

    if (hero) {
      new IntersectionObserver(
        ([e]) => {
          heroVisible = e.isIntersecting;
          update();
        },
        { threshold: 0 },
      ).observe(hero);
    } else {
      heroVisible = false;
    }
    if (tail) {
      new IntersectionObserver(
        ([e]) => {
          tailVisible = e.isIntersecting;
          update();
        },
        { rootMargin: "0px 0px -10% 0px" },
      ).observe(tail);
    }
    update();
  }
  rcMobileCtaInit();
  document.addEventListener("astro:after-swap", rcMobileCtaInit);
</script>
