---
/**
 * Pricing grid — SiteGround card anatomy on Royal Clouds branding.
 * Defaults to annual pricing: big discounted price, struck monthly
 * "regular" price with a SAVE chip, and a renews fine print. The
 * monthly/annual toggle swaps everything client-side.
 */
interface Tier {
  name: string;
  price: string;
  priceAnnual?: string;
  popular?: boolean;
  summary?: string;
  cta?: string;
  ctaUrl: string;
  features: string[];
}
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  tiers: Tier[];
  note?: string;
  showToggle?: boolean;
}
const {
  id = "pricing",
  eyebrow,
  title,
  subtitle,
  tiers,
  note,
  showToggle = true,
} = Astro.props;
const cols = Math.min(tiers.length, 5);

const savePct = (t: Tier) => {
  const m = parseFloat(t.price);
  const a = parseFloat(t.priceAnnual ?? t.price);
  if (!m || !a || a >= m) return 0;
  return Math.round((1 - a / m) * 100);
};
const hasAnnual = tiers.some((t) => savePct(t) > 0);
const defaultBill = hasAnnual && showToggle ? "annual" : "monthly";
const shownPrice = (t: Tier) =>
  defaultBill === "annual" ? (t.priceAnnual ?? t.price) : t.price;
---

<section class="pricing" id={id} data-bill={defaultBill}>
  <div class="wrap">
    <div class="sec-head center reveal">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
      {subtitle && <p>{subtitle}</p>}
    </div>
    {
      showToggle && (
        <div style="text-align: center;">
          <div class="bill-toggle" role="group" aria-label="Billing period">
            <button
              type="button"
              class={defaultBill === "monthly" ? "active" : ""}
              data-bill="monthly"
            >
              Monthly
            </button>
            <button
              type="button"
              class={defaultBill === "annual" ? "active" : ""}
              data-bill="annual"
            >
              Annual <span class="save">SAVE 20%</span>
            </button>
          </div>
        </div>
      )
    }
    <div
      class="plan-grid"
      style={`grid-template-columns: repeat(${cols}, 1fr);`}
      data-plan-grid
    >
      {
        tiers.map((t, i) => (
          <div
            class={`plan reveal reveal-d${(i % 4) + 1}${t.popular ? " popular" : ""}`}
          >
            {t.popular && <span class="plan-band">Best Value</span>}
            <h3>{t.name}</h3>
            <p class="summary">{t.summary}</p>
            <div class="was-row">
              {savePct(t) > 0 && (
                <>
                  <span class="was">${t.price}</span>
                  <span class="save-chip">SAVE {savePct(t)}%</span>
                </>
              )}
            </div>
            <div class="price-row">
              <span class="cur">$</span>
              <span
                class="price"
                data-monthly={t.price}
                data-annual={t.priceAnnual ?? t.price}
              >
                {shownPrice(t)}
              </span>
              <span class="period">/mo</span>
            </div>
            <a
              class={`btn ${t.popular ? "btn-primary" : "btn-plan"}`}
              href={t.ctaUrl}
              target="_blank"
              rel="noopener"
            >
              {t.cta ?? "Get Started"}
            </a>
            <p
              class="price-note"
              data-bill-note
              data-monthly="Billed monthly. Cancel anytime."
              data-annual={`Renews at $${t.price}/mo. Billed annually.`}
            >
              {defaultBill === "annual"
                ? `Renews at $${t.price}/mo. Billed annually.`
                : "Billed monthly. Cancel anytime."}
            </p>
            <ul class="feat">
              {t.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    {note && <p class="pricing-note">{note}</p>}
  </div>
</section>

<style>
  /* keep the design's responsive plan-grid rules when columns are inlined */
  @media (max-width: 1080px) {
    .plan-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
  @media (max-width: 860px) {
    .plan-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 560px) {
    .plan-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  function rcPlansInit() {
    document.querySelectorAll(".pricing").forEach((sec) => {
      const buttons = sec.querySelectorAll(".bill-toggle button");
      const swaps = sec.querySelectorAll(
        ".price[data-monthly], [data-bill-note]",
      );
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const bill = btn.getAttribute("data-bill") || "monthly";
          (sec as HTMLElement).dataset.bill = bill;
          buttons.forEach((b) => b.classList.toggle("active", b === btn));
          swaps.forEach((p) => {
            p.textContent = p.getAttribute(
              bill === "annual" ? "data-annual" : "data-monthly",
            );
          });
        });
      });
    });
  }
  rcPlansInit();
  document.addEventListener("astro:after-swap", rcPlansInit);
</script>
