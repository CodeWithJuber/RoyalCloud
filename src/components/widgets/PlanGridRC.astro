---
/**
 * Pricing grid, SiteGround card anatomy on Royal Clouds branding.
 * Defaults to annual pricing: big discounted price, struck monthly
 * "regular" price with a SAVE chip, and a renews fine print. The
 * monthly/annual toggle swaps everything client-side; prices are
 * dual-currency (₹ default, $ via the header toggle).
 */
import { toINR } from "~/utils/currency";
import { Icon } from "astro-icon/components";
import { tablerIcon } from "~/utils/plans";

interface Tier {
  name: string;
  price: string;
  priceAnnual?: string;
  popular?: boolean;
  summary?: string;
  cta?: string;
  ctaUrl: string;
  features: string[];
}
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  tiers: Tier[];
  note?: string;
  showToggle?: boolean;
  /** product tabler icon (per-plan glyph badge on each card) */
  icon?: string;
  /** product slug, drives the per-product card accent */
  product?: string;
}
const {
  id = "pricing",
  eyebrow,
  title,
  subtitle,
  tiers,
  note,
  showToggle = true,
  icon,
  product,
} = Astro.props;
const cols = Math.min(tiers.length, 5);

const savePct = (t: Tier) => {
  const m = parseFloat(t.price);
  const a = parseFloat(t.priceAnnual ?? t.price);
  if (!m || !a || a >= m) return 0;
  return Math.round((1 - a / m) * 100);
};
const hasAnnual = tiers.some((t) => savePct(t) > 0);
const defaultBill = hasAnnual && showToggle ? "annual" : "monthly";
const shownPrice = (t: Tier) =>
  toINR(defaultBill === "annual" ? (t.priceAnnual ?? t.price) : t.price);
---

<section class="pricing" id={id} data-bill={defaultBill} data-product={product}>
  <div class="wrap">
    <div class="sec-head center reveal">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
      {subtitle && <p>{subtitle}</p>}
    </div>
    {
      showToggle && (
        <div style="text-align: center;">
          <div class="bill-toggle" role="group" aria-label="Billing period">
            <button
              type="button"
              class={defaultBill === "monthly" ? "active" : ""}
              aria-pressed={defaultBill === "monthly" ? "true" : "false"}
              data-bill="monthly"
            >
              Monthly
            </button>
            <button
              type="button"
              class={defaultBill === "annual" ? "active" : ""}
              aria-pressed={defaultBill === "annual" ? "true" : "false"}
              data-bill="annual"
            >
              Annual <span class="save">SAVE 20%</span>
            </button>
          </div>
        </div>
      )
    }
    <div
      class="plan-grid"
      style={`grid-template-columns: repeat(${cols}, 1fr);`}
      data-plan-grid
    >
      {
        tiers.map((t, i) => (
          <div
            class={`plan rc-spotlight reveal rv-scale reveal-d${(i % 4) + 1}${t.popular ? " popular" : ""}`}
          >
            {t.popular && <span class="plan-band">Best Value</span>}
            {icon && (
              <span class="plan-ic">
                <Icon name={tablerIcon(icon)} />
              </span>
            )}
            <h3>{t.name}</h3>
            <p class="summary">{t.summary}</p>
            <div class="was-row">
              {savePct(t) > 0 && (
                <>
                  <span
                    class="was px"
                    data-usd={`$${t.price}`}
                    data-inr={`₹${toINR(t.price)}`}
                  >
                    ₹{toINR(t.price)}
                  </span>
                  <span class="save-chip">SAVE {savePct(t)}%</span>
                </>
              )}
            </div>
            <div class="price-row">
              <span class="cur" data-cur-sym>
                ₹
              </span>
              <span
                class="price"
                data-usd-monthly={t.price}
                data-usd-annual={t.priceAnnual ?? t.price}
                data-inr-monthly={toINR(t.price)}
                data-inr-annual={toINR(t.priceAnnual ?? t.price)}
              >
                {shownPrice(t)}
              </span>
              <span class="period">/mo</span>
            </div>
            <a
              class={`btn ${t.popular ? "btn-primary" : "btn-plan"}`}
              href={t.ctaUrl}
              target="_blank"
              rel="noopener"
            >
              {t.cta ?? "Get Started"}
            </a>
            <p
              class="price-note"
              data-bill-note
              data-usd-monthly="Billed monthly. Cancel anytime."
              data-usd-annual={`Renews at $${t.price}/mo. Billed annually.`}
              data-inr-monthly="Billed monthly. Cancel anytime."
              data-inr-annual={`Renews at ₹${toINR(t.price)}/mo. Billed annually.`}
            >
              {defaultBill === "annual"
                ? `Renews at ₹${toINR(t.price)}/mo. Billed annually.`
                : "Billed monthly. Cancel anytime."}
            </p>
            <ul class="feat">
              {t.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    {note && <p class="pricing-note">{note}</p>}
  </div>
</section>

<style>
  /* inline column count is overridden responsively; <=700px becomes a
     swipe carousel (see rc-premium.css) */
  @media (max-width: 1080px) {
    .plan-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
  @media (max-width: 860px) and (min-width: 701px) {
    .plan-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
</style>

<script>
  function rcPlansInit() {
    const apply = (sec: HTMLElement) => {
      const cur = document.documentElement.dataset.currency || "inr";
      const bill = sec.dataset.bill || "monthly";
      sec
        .querySelectorAll(`[data-${cur}-${bill}]`)
        .forEach(
          (p) => (p.textContent = p.getAttribute(`data-${cur}-${bill}`)),
        );
    };
    document.querySelectorAll<HTMLElement>(".pricing").forEach((sec) => {
      const buttons = sec.querySelectorAll(".bill-toggle button");
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const bill = btn.getAttribute("data-bill") || "monthly";
          sec.dataset.bill = bill;
          buttons.forEach((b) => {
            b.classList.toggle("active", b === btn);
            b.setAttribute("aria-pressed", String(b === btn));
          });
          apply(sec);
        });
      });
      apply(sec);
      document.addEventListener("rc-currency", () => apply(sec));
    });
  }
  rcPlansInit();
  document.addEventListener("astro:after-swap", rcPlansInit);
</script>
