---
/** Inner-page hero in the design-handoff language (compact dark-indigo). */
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  price?: string;
}
const { eyebrow, title, subtitle, price } = Astro.props;
const PORTAL = 'https://my.royalclouds.net';
const badges = ['99.99% Uptime SLA', 'Free SSL Certificate', '30-Day Money-Back', 'Free Migration'];
---

<section class="hero rc-inner-hero">
  <div class="wrap" style="position: relative; max-width: 880px; text-align: center;">
    {eyebrow && <span class="hero-eyebrow"><span class="dot"></span>{eyebrow}</span>}
    <h1>{title}</h1>
    <p class="sub" style="margin-left: auto; margin-right: auto;">{subtitle}</p>
    <div class="hero-ctas" style="justify-content: center;">
      <a class="btn btn-primary" href={`${PORTAL}/cart.php`} target="_blank" rel="noopener">{price ? `From ${price}/mo` : 'Get Started'} →</a>
      <a class="btn btn-ghost-light" href="#pricing">View Pricing</a>
    </div>
    <div class="hero-trust" style="justify-content: center;">
      {badges.map((b) => (<span class="t">{b}</span>))}
    </div>
  </div>
</section>

<style>
  .rc-inner-hero { padding: 64px 0 72px; }
  .rc-inner-hero h1 { font-size: clamp(32px, 4vw, 48px); }
  .rc-inner-hero .hero-trust { margin-top: 34px; }
</style>
