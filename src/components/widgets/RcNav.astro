---
import Button from "~/components/rc/Button.astro";
import { headerData } from "~/navigation";
import site from "~/data/site.json";

/**
 * Royal Clouds — floating nav island (Royal Systems Design Language v2).
 * Blurred midnight pill, chrome hairline, text wordmark, hover dropdowns for
 * grouped nav, a sign-in link and the single signal CTA. Collapses to a burger
 * sheet under 1080px.
 */
type Link = { text: string; href: string };
type Group = { text: string; links: Link[] };
type Item = Link | Group;
const items = headerData.links as Item[];
const isGroup = (i: Item): i is Group => "links" in i;
const external = (href: string) => /^https?:\/\//.test(href);
const login = site.portal?.login || "#";
const cart = site.portal?.cart || "#pricing";
---

<div class="rc-nav" data-surface="dark" data-rc-nav>
  <nav class="rc-nav__isle" aria-label="Primary">
    <a class="rc-wordmark" href="/" aria-label="Royal Clouds home">
      <svg class="rc-wordmark__mark" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <rect x="1.2" y="1.2" width="23.6" height="23.6" rx="7" stroke="var(--chrome)" stroke-width="1.5" />
        <path d="M7 17c0-3 2.2-5 5-5 .6-2 2.4-3.2 4.4-3.2 2.6 0 4.6 2 4.6 4.6 0 2.5-2 4.6-4.6 4.6H8.6" stroke="var(--cobalt-bright)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span><span style="color:var(--ice)">Royal</span><span style="color:var(--smoke)">Clouds</span></span>
    </a>

    <div class="rc-nav__links">
      {items.map((it) =>
        isGroup(it) ? (
          <div class="rc-nav__item">
            <button type="button" class="rc-nav__link rc-nav__trigger" aria-haspopup="true" aria-expanded="false">
              {it.text}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div class="rc-nav__menu" role="menu">
              {it.links.map((l) => (
                <a class="rc-nav__menu-link" href={l.href} role="menuitem" {...(external(l.href) ? { target: "_blank", rel: "noopener" } : {})}>{l.text}</a>
              ))}
            </div>
          </div>
        ) : (
          <a class="rc-nav__link" href={it.href} {...(external(it.href) ? { target: "_blank", rel: "noopener" } : {})}>{it.text}</a>
        ),
      )}
      <a class="rc-nav__link" href="#pricing">Pricing</a>
    </div>

    <span class="rc-nav__spacer"></span>
    <div class="rc-nav__cta">
      <a class="rc-nav__signin" href={login} target="_blank" rel="noopener">Sign in</a>
      <Button href={cart} size="sm" external>Choose a plan</Button>
    </div>
    <button type="button" class="rc-nav__burger" aria-label="Menu" aria-expanded="false" data-burger>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
    </button>
  </nav>

  <div class="rc-nav__sheet" data-sheet hidden>
    {items.map((it) =>
      isGroup(it) ? (
        <div class="rc-nav__sheet-group">
          <span class="rc-nav__sheet-head">{it.text}</span>
          {it.links.map((l) => <a href={l.href} {...(external(l.href) ? { target: "_blank", rel: "noopener" } : {})}>{l.text}</a>)}
        </div>
      ) : (
        <a class="rc-nav__sheet-top" href={it.href}>{it.text}</a>
      ),
    )}
    <a class="rc-nav__sheet-top" href="#pricing">Pricing</a>
    <div class="rc-nav__sheet-cta">
      <a class="rc-nav__signin" href={login} target="_blank" rel="noopener">Sign in</a>
      <Button href={cart} block external>Choose a plan</Button>
    </div>
  </div>
</div>

<style>
  .rc-nav__item { position: relative; }
  .rc-nav__trigger { border: none; background: none; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-body); }
  .rc-nav__menu {
    position: absolute; top: calc(100% + 12px); left: 0; min-width: 240px; display: none; flex-direction: column; gap: 2px;
    padding: 8px; border-radius: var(--r-inner); background: rgb(10 14 36 / 0.92);
    -webkit-backdrop-filter: blur(18px) saturate(1.4); backdrop-filter: blur(18px) saturate(1.4);
    border: 1px solid var(--line-chrome-16); box-shadow: var(--sh-3);
  }
  .rc-nav__item:hover .rc-nav__menu,
  .rc-nav__item:focus-within .rc-nav__menu { display: flex; }
  .rc-nav__menu-link { padding: 9px 12px; border-radius: 12px; font-size: 14px; color: var(--smoke); white-space: nowrap;
    transition: color var(--dur-micro) var(--ease-entry), background var(--dur-micro) var(--ease-entry); }
  .rc-nav__menu-link:hover { color: var(--ice); background: var(--line-chrome-10); }

  /* Mobile sheet */
  .rc-nav__sheet {
    pointer-events: auto; width: min(1240px, calc(100% - 2 * var(--page-gutter))); margin: 10px auto 0;
    display: flex; flex-direction: column; gap: 6px; padding: 16px;
    border-radius: var(--r-inner); background: rgb(10 14 36 / 0.94);
    -webkit-backdrop-filter: blur(18px) saturate(1.4); backdrop-filter: blur(18px) saturate(1.4);
    border: 1px solid var(--line-chrome-16); box-shadow: var(--sh-3); max-height: 70vh; overflow-y: auto;
  }
  .rc-nav__sheet[hidden] { display: none; }
  .rc-nav__sheet-group { display: flex; flex-direction: column; gap: 2px; padding: 6px 0; border-bottom: 1px solid var(--line-chrome-10); }
  .rc-nav__sheet-head { font-family: var(--font-body); font-weight: var(--fw-body-bold); font-size: var(--t-label-sm);
    letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--chrome); padding: 4px 8px; }
  .rc-nav__sheet a { color: var(--smoke); font-size: 15px; padding: 9px 8px; border-radius: 10px; }
  .rc-nav__sheet a:hover { color: var(--ice); background: var(--line-chrome-10); }
  .rc-nav__sheet-top { font-weight: var(--fw-body-semi); color: var(--ice) !important; }
  .rc-nav__sheet-cta { display: flex; align-items: center; gap: 12px; margin-top: 10px; }
  @media (min-width: 1081px) { .rc-nav__sheet { display: none !important; } }
</style>

<script>
  function rcNavInit() {
    document.querySelectorAll<HTMLElement>("[data-rc-nav]").forEach((root) => {
      if (root.dataset.rcInit) return;
      root.dataset.rcInit = "1";
      const burger = root.querySelector<HTMLElement>("[data-burger]");
      const sheet = root.querySelector<HTMLElement>("[data-sheet]");
      burger?.addEventListener("click", () => {
        const open = sheet?.hasAttribute("hidden");
        if (open) sheet?.removeAttribute("hidden");
        else sheet?.setAttribute("hidden", "");
        burger.setAttribute("aria-expanded", String(Boolean(open)));
      });
      sheet?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          sheet.setAttribute("hidden", "");
          burger?.setAttribute("aria-expanded", "false");
        }),
      );
    });
  }
  rcNavInit();
  document.addEventListener("astro:after-swap", rcNavInit);
</script>
