---
/** Scroll-reveal behavior ported from the design handoff (rc-home.js),
    including its IntersectionObserver fail-safe + last-resort timer. */
---

<script>
  function rcSetupReveal() {
    const els = Array.prototype.slice.call(
      document.querySelectorAll(".reveal"),
    );
    if (!els.length) return;
    let ioFired = false;

    function revealInView() {
      els.forEach((el) => {
        if (
          !el.classList.contains("in") &&
          el.getBoundingClientRect().top < window.innerHeight - 20
        ) {
          el.classList.add("in");
        }
      });
    }
    function revealAll() {
      els.forEach((el) => el.classList.add("in"));
    }

    if (typeof IntersectionObserver !== "undefined") {
      const io = new IntersectionObserver(
        (entries) => {
          ioFired = true;
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
      );
      els.forEach((el) => io.observe(el));
      setTimeout(() => {
        if (!ioFired) {
          revealInView();
          window.addEventListener("scroll", revealInView, { passive: true });
        }
      }, 800);
    } else {
      revealInView();
      window.addEventListener("scroll", revealInView, { passive: true });
    }
    setTimeout(() => {
      if (!ioFired) revealAll();
    }, 2500);
  }
  rcSetupReveal();
  document.addEventListener("astro:after-swap", rcSetupReveal);

  /** Soft hero parallax — [data-plx] layers drift as you scroll away.
      Desktop only, reduced-motion aware, rAF-throttled. */
  let rcPlxBound = false;
  function rcParallax() {
    const els = document.querySelectorAll<HTMLElement>("[data-plx]");
    els.forEach((el) => (el.style.transform = ""));
    if (
      !els.length ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      window.innerWidth < 860
    )
      return;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      if (y > window.innerHeight * 1.4) return;
      document.querySelectorAll<HTMLElement>("[data-plx]").forEach((el) => {
        el.style.transform = `translateY(${(y * parseFloat(el.dataset.plx || "0")).toFixed(1)}px)`;
      });
    };
    if (!rcPlxBound) {
      rcPlxBound = true;
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
    }
    update();
  }
  rcParallax();
  document.addEventListener("astro:after-swap", rcParallax);
</script>
