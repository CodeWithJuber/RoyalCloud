---
/**
 * STRATOSPHERE motion spine, Lenis smooth scroll + a GSAP ScrollTrigger
 * hero→content handoff. Everything is gated behind prefers-reduced-motion
 * (native scroll, no JS motion) and re-initialises across Astro view
 * transitions. Only transform/opacity are animated → no layout shift.
 */
---

<script>
  import Lenis from "lenis";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  type Teardown = () => void;
  let teardowns: Teardown[] = [];

  function setup() {
    // clean any prior instance (view transitions)
    teardowns.forEach((fn) => fn());
    teardowns = [];

    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduce) return;

    // ── Lenis smooth scroll
    const lenis = new Lenis({
      duration: 1.05,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });
    lenis.on("scroll", ScrollTrigger.update);
    const raf = (time: number) => lenis.raf(time * 1000);
    gsap.ticker.add(raf);
    gsap.ticker.lagSmoothing(0);
    teardowns.push(() => {
      gsap.ticker.remove(raf);
      lenis.destroy();
    });

    // anchor links should route through Lenis for a smooth glide
    const onClick = (e: MouseEvent) => {
      const a = (e.target as HTMLElement)?.closest?.(
        'a[href^="#"]',
      ) as HTMLAnchorElement | null;
      if (!a) return;
      const id = a.getAttribute("href");
      if (!id || id === "#") return;
      const el = document.querySelector(id);
      if (!el) return;
      e.preventDefault();
      lenis.scrollTo(el as HTMLElement, { offset: -96 });
    };
    document.addEventListener("click", onClick);
    teardowns.push(() => document.removeEventListener("click", onClick));

    // ── Hero handoff: copy + veil drift up and fade as you leave the hero
    const hero = document.querySelector<HTMLElement>("[data-rc-hero]");
    const copy = hero?.querySelector<HTMLElement>(".rc-hero-copy");
    if (hero && copy) {
      const tl = gsap.to(copy, {
        y: -60,
        opacity: 0.0,
        ease: "none",
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      });
      teardowns.push(() => {
        tl.scrollTrigger?.kill();
        tl.kill();
        gsap.set(copy, { clearProps: "all" });
      });
    }

    // ── Scroll-story: briefly hold on the speed race so it plays as a beat
    //    (desktop only; pinning feels heavy / janky on phones). The section's
    //    own IntersectionObserver still starts the race.
    const raceSec = document.querySelector<HTMLElement>(".race-sec");
    if (raceSec && window.innerWidth >= 768 && window.matchMedia("(hover: hover)").matches) {
      const st = ScrollTrigger.create({
        trigger: raceSec,
        start: "top top",
        end: "+=70%",
        pin: true,
        pinSpacing: true,
        anticipatePin: 1,
      });
      teardowns.push(() => st.kill());
    }

    // ── Hover physics: pricing cards + bento flagship tiles tilt toward the
    //    cursor (desktop fine-pointer only). Motion values via gsap.quickTo so
    //    nothing touches DOM/React state per frame; reset on pointer leave.
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      const tiltEls = gsap.utils.toArray<HTMLElement>(
        ".plan, .feature-card.tile-wide",
      );
      tiltEls.forEach((el) => {
        gsap.set(el, { transformPerspective: 820, transformOrigin: "center" });
        const rx = gsap.quickTo(el, "rotationX", { duration: 0.5, ease: "power3" });
        const ry = gsap.quickTo(el, "rotationY", { duration: 0.5, ease: "power3" });
        const ty = gsap.quickTo(el, "y", { duration: 0.5, ease: "power3" });
        const onMove = (e: PointerEvent) => {
          const r = el.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          rx(-py * 5);
          ry(px * 5);
          ty(-6);
        };
        const onLeave = () => {
          rx(0);
          ry(0);
          ty(0);
        };
        el.addEventListener("pointermove", onMove);
        el.addEventListener("pointerleave", onLeave);
        teardowns.push(() => {
          el.removeEventListener("pointermove", onMove);
          el.removeEventListener("pointerleave", onLeave);
          gsap.set(el, { clearProps: "all" });
        });
      });
    }

    ScrollTrigger.refresh();
  }

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
