---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { type Post, formatDate, tagSlug, readingTime } from "../lib/blog";
import { Image } from "astro:assets";
import site from "../data/site.json";

interface Props { post: Post; }
const { post } = Astro.props;
const { data } = post;
const url = `${site.url}/blog/${post.id}`;
const mins = readingTime(post.body);

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  author: { "@type": "Organization", name: data.author },
  publisher: { "@type": "Organization", name: site.name, logo: { "@type": "ImageObject", url: new URL(site.logo, site.url).href } },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  ...(data.image ? { image: new URL((data.image as any).src, site.url).href } : {}),
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${site.url}/blog` },
    { "@type": "ListItem", position: 3, name: data.title, item: url },
  ],
};
---
<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  canonical={data.canonical}
  noindex={data.noindex}
  image={data.image ? (data.image as any).src : undefined}
  publishedTime={data.publishDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.publishDate).toISOString()}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="post">
    <header class="post__hdr">
      <div class="post__hdr-grid bg-grid" aria-hidden="true"></div>
      <div class="post__hdr-mesh bg-mesh" aria-hidden="true"></div>
      <div class="container container-narrow">
        <Breadcrumbs items={[{ label: "Blog", href: "/blog" }, { label: data.title }]} />
        <a href={`/blog/tag/${tagSlug(data.category)}`} class="post__cat">{data.category}</a>
        <h1>{data.title}</h1>
        <p class="post__desc">{data.description}</p>
        <div class="post__meta">
          <span><Icon name="users" size={16} /> {data.author}</span>
          <span><Icon name="clock" size={16} /> {formatDate(data.publishDate)}</span>
          <span><Icon name="report" size={16} /> {mins} min read</span>
        </div>
      </div>
    </header>

    {data.image && (
      <div class="container container-narrow">
        <div class="post__cover">
          <Image src={data.image} alt={data.imageAlt ?? data.title} widths={[600, 900, 1200]} sizes="(max-width: 820px) 100vw, 820px" />
        </div>
      </div>
    )}

    <div class="container container-narrow">
      <div class="post__body"><slot /></div>
      <div class="post__tags">{data.tags.map((t) => (<a href={`/blog/tag/${tagSlug(t)}`} class="post__tag">#{t}</a>))}</div>
      <div class="post__cta">
        <div><h3>Ready to host faster?</h3><p>Launch on premium SSD hosting from {site.startingPrice}/mo — free SSL & migration.</p></div>
        <a href={site.portal.cart} class="btn btn--gradient">Get Started</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post__hdr { position: relative; overflow: hidden; padding-block: clamp(2.25rem, 5vw, 3.5rem); border-bottom: 1px solid var(--border); }
  .post__hdr-grid { position: absolute; inset: 0; opacity: .5; }
  .post__hdr-mesh { position: absolute; inset: -30% -10% auto; height: 160%; }
  .post__hdr .container { position: relative; }
  .post__cat { display: inline-block; margin-top: 1.25rem; font-family: var(--font-display); font-weight: 650; color: var(--brand-ink); font-size: 0.85rem; letter-spacing: .03em; text-transform: uppercase; }
  .post__hdr h1 { margin-top: 0.75rem; }
  .post__desc { color: var(--muted); font-size: 1.18rem; margin-top: 1rem; }
  .post__meta { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.5rem; }
  .post__meta span { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.88rem; color: var(--muted); }

  .post__cover { margin-top: -2.5rem; position: relative; z-index: 2; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); aspect-ratio: 16/8; }
  .post__cover :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .post__body { font-size: 1.1rem; line-height: 1.78; color: var(--text); padding-block: clamp(2rem, 4vw, 3rem); }
  .post__body :global(h2) { font-size: 1.7rem; margin-top: 2.5rem; margin-bottom: 0.85rem; }
  .post__body :global(h3) { font-size: 1.3rem; margin-top: 2rem; margin-bottom: 0.6rem; }
  .post__body :global(p) { margin-bottom: 1.25rem; }
  .post__body :global(ul), .post__body :global(ol) { margin: 0 0 1.25rem 1.25rem; display: grid; gap: 0.5rem; }
  .post__body :global(ul) { list-style: disc; } .post__body :global(ol) { list-style: decimal; }
  .post__body :global(a) { color: var(--brand-ink); text-decoration: underline; text-underline-offset: 2px; }
  .post__body :global(blockquote) { border-left: 3px solid var(--brand); background: var(--bg-subtle); padding: 1rem 1.25rem; border-radius: 0 var(--r-sm) var(--r-sm) 0; margin: 0 0 1.5rem; color: var(--ink); }
  .post__body :global(code) { background: var(--bg-inset); padding: 0.15em 0.4em; border-radius: 6px; font-size: 0.9em; }
  .post__body :global(pre) { background: #0c0e1a; color: #e7e4f6; padding: 1.1rem 1.25rem; border-radius: var(--r-md); overflow-x: auto; margin-bottom: 1.5rem; }
  .post__body :global(pre code) { background: none; padding: 0; }
  .post__body :global(img) { border-radius: var(--r-md); margin: 0.5rem 0 1.5rem; }

  .post__tags { display: flex; flex-wrap: wrap; gap: 0.6rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
  .post__tag { font-size: 0.85rem; font-weight: 600; color: var(--brand-ink); background: var(--brand-soft); padding: 0.35rem 0.85rem; border-radius: var(--r-pill); }
  .post__cta { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; justify-content: space-between; margin: 2.5rem 0 4rem; padding: 1.75rem 2rem; background: var(--bg-inset); border: 1px solid var(--border); border-radius: var(--r-lg); }
  .post__cta h3 { font-size: 1.3rem; }
  .post__cta p { color: var(--muted); margin-top: 0.3rem; }
</style>
