---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { type Post, formatDate, tagSlug, readingTime } from "../lib/blog";
import { Image } from "astro:assets";
import site from "../data/site.json";

interface Props { post: Post; }
const { post } = Astro.props;
const { data } = post;
const url = `${site.url}/blog/${post.id}`;
const mins = readingTime(post.body);

// BlogPosting + BreadcrumbList structured data (Yoast-equivalent article schema).
const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  author: { "@type": "Organization", name: data.author },
  publisher: {
    "@type": "Organization",
    name: site.name,
    logo: { "@type": "ImageObject", url: new URL(site.logo, site.url).href },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  ...(data.image ? { image: new URL((data.image as any).src, site.url).href } : {}),
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${site.url}/blog` },
    { "@type": "ListItem", position: 3, name: data.title, item: url },
  ],
};
---
<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  canonical={data.canonical}
  noindex={data.noindex}
  image={data.image ? (data.image as any).src : undefined}
  publishedTime={data.publishDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.publishDate).toISOString()}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="post">
    <header class="post-header">
      <div class="container container-narrow">
        <Breadcrumbs items={[{ label: "Blog", href: "/blog" }, { label: data.title }]} light />
        <a href={`/blog/tag/${tagSlug(data.category)}`} class="post-cat">{data.category}</a>
        <h1>{data.title}</h1>
        <p class="post-desc">{data.description}</p>
        <div class="post-meta">
          <span><Icon name="users" size={16} /> {data.author}</span>
          <span><Icon name="clock" size={16} /> {formatDate(data.publishDate)}</span>
          <span><Icon name="report" size={16} /> {mins} min read</span>
        </div>
      </div>
    </header>

    {data.image && (
      <div class="container container-narrow">
        <div class="post-cover">
          <Image src={data.image} alt={data.imageAlt ?? data.title} widths={[600, 900, 1200]} sizes="(max-width: 820px) 100vw, 820px" />
        </div>
      </div>
    )}

    <div class="container container-narrow">
      <div class="post-body">
        <slot />
      </div>

      <div class="post-tags">
        {data.tags.map((t) => (<a href={`/blog/tag/${tagSlug(t)}`} class="blog-tag">#{t}</a>))}
      </div>

      <div class="post-cta">
        <div>
          <h3>Ready to host faster?</h3>
          <p>Launch your site on premium SSD hosting from {site.startingPrice}/mo — free SSL & migration included.</p>
        </div>
        <a href={site.portal.cart} class="btn btn--gradient">Get Started</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-header { position: relative; background: var(--rc-gradient-ink); color: #d9d6ec; padding-block: clamp(2.25rem, 5vw, 3.5rem); overflow: hidden; }
  .post-header::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 85% -10%, rgba(105,56,239,0.4), transparent 45%); pointer-events: none; }
  .post-header .container { position: relative; }
  .post-cat { display: inline-block; margin-top: 1.25rem; font-family: var(--rc-font-sans); font-weight: 700; color: #c9b8ff; font-size: 0.85rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .post-header h1 { color: #fff; margin-top: 0.75rem; }
  .post-desc { color: #b8b3d6; font-size: 1.15rem; margin-top: 1rem; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.5rem; }
  .post-meta span { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.88rem; color: #cfcae6; }

  .post-cover { margin-top: -2.5rem; position: relative; z-index: 2; border-radius: var(--rc-radius-lg); overflow: hidden; box-shadow: var(--rc-shadow-lg); aspect-ratio: 16 / 8; }
  .post-cover :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .post-body { font-size: 1.1rem; line-height: 1.75; color: var(--rc-body); padding-block: clamp(2rem, 4vw, 3rem); }
  .post-body :global(h2) { font-size: 1.7rem; margin-top: 2.5rem; margin-bottom: 0.85rem; }
  .post-body :global(h3) { font-size: 1.3rem; margin-top: 2rem; margin-bottom: 0.6rem; }
  .post-body :global(p) { margin-bottom: 1.25rem; }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 1.25rem 1.25rem; display: grid; gap: 0.5rem; }
  .post-body :global(ul) { list-style: disc; }
  .post-body :global(ol) { list-style: decimal; }
  .post-body :global(a) { color: var(--rc-primary); text-decoration: underline; text-underline-offset: 2px; }
  .post-body :global(blockquote) { border-left: 4px solid var(--rc-primary); background: var(--rc-surface-2); padding: 1rem 1.25rem; border-radius: 0 var(--rc-radius-sm) var(--rc-radius-sm) 0; margin: 0 0 1.5rem; color: var(--rc-ink); }
  .post-body :global(code) { background: var(--rc-surface-3); padding: 0.15em 0.4em; border-radius: 6px; font-size: 0.9em; }
  .post-body :global(pre) { background: #1c1640; color: #e7e4f6; padding: 1.1rem 1.25rem; border-radius: var(--rc-radius); overflow-x: auto; margin-bottom: 1.5rem; }
  .post-body :global(pre code) { background: none; padding: 0; }
  .post-body :global(img) { border-radius: var(--rc-radius); margin: 0.5rem 0 1.5rem; }

  .post-tags { display: flex; flex-wrap: wrap; gap: 0.6rem; padding-bottom: 2rem; border-bottom: 1px solid var(--rc-line); }
  .blog-tag { font-size: 0.85rem; font-weight: 600; color: var(--rc-primary-700); background: var(--rc-primary-50); padding: 0.35rem 0.85rem; border-radius: var(--rc-radius-pill); }

  .post-cta { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; justify-content: space-between; margin: 2.5rem 0 4rem; padding: 1.75rem 2rem; background: var(--rc-gradient-soft); border-radius: var(--rc-radius-lg); }
  .post-cta h3 { font-size: 1.3rem; }
  .post-cta p { color: var(--rc-muted); margin-top: 0.3rem; }
</style>
