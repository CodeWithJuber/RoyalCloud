---
/**
 * CloneLayout — renders a captured royalclouds.net page verbatim.
 *
 * The page's original <head> inner HTML and <body> inner HTML are injected
 * untouched via set:html so Astro performs no transformation on the theme
 * markup. The result is byte-faithful to the live site while still being built
 * and deployed by Astro (see src/pages/[...slug].astro).
 */
interface Props {
  head: string;
  body: string;
  bodyAttrs?: string;
}
const { head, body, bodyAttrs = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head set:html={head}></head>
  <Fragment set:html={`<body ${bodyAttrs}>${body}</body>`} />
</html>
