---
import Layout from '~/layouts/Layout.astro';
import HeaderRC from '~/components/widgets/HeaderRC.astro';
import FooterRC from '~/components/widgets/FooterRC.astro';
import RevealScript from '~/components/widgets/RevealScript.astro';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  /** Pages with their own dark hero can render the transparent header. */
  transparentHeader?: boolean;
  /** Per-page visual identity — sets data-theme on <main> (see rc-premium.css). */
  theme?: string;
}

const { metadata, transparentHeader = false, theme } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="header">
    <HeaderRC solid={!transparentHeader} />
  </slot>
  <main data-theme={theme}>
    <slot />
  </main>
  <slot name="footer">
    <FooterRC />
  </slot>
  <RevealScript />
</Layout>
