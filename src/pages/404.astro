---
import { Image } from "astro:assets";
import PageLayout from "~/layouts/PageLayout.astro";
import mascot from "~/assets/images/brand/mascot.png";
import cloud from "~/assets/images/brand/cloud.png";

const metadata = {
  title: "Page not found, Royal Clouds",
  robots: { index: false, follow: true },
};

const quickLinks = [
  { text: "SSD Shared Hosting", href: "/shared-hosting" },
  { text: "KVM VPS Hosting", href: "/kvm-vps-hosting" },
  { text: "Managed WordPress", href: "/managed-wordpress-hosting" },
  { text: "Blog", href: "/blog" },
];
---

<PageLayout metadata={metadata}>
  <section class="nf">
    <div class="wrap nf-inner">
      <div class="nf-art" aria-hidden="true">
        <Image src={cloud} alt="" width={120} height={90} class="nf-cloud c1" />
        <Image src={cloud} alt="" width={90} height={70} class="nf-cloud c2" />
        <Image
          src={mascot}
          alt=""
          width={210}
          height={437}
          loading="eager"
          class="nf-mascot"
        />
      </div>
      <p class="nf-code" aria-hidden="true">
        <span>4</span><span class="o">0</span><span>4</span>
      </p>
      <h1>Lost in the clouds</h1>
      <p class="nf-sub">
        This page drifted away, but your website never will. Let's get you back
        somewhere useful.
      </p>
      <div class="hero-ctas nf-ctas">
        <a class="btn btn-primary btn-lg" href="/">Back to homepage</a>
        <a class="btn btn-ghost-dark btn-lg" href="/contact">Contact support</a>
      </div>
      <nav class="nf-links" aria-label="Popular pages">
        <span class="nf-links-label">Popular pages:</span>
        {quickLinks.map((l) => <a href={l.href}>{l.text}</a>)}
      </nav>
    </div>
  </section>
</PageLayout>

<style>
  .nf {
    background:
      radial-gradient(
        560px 360px at 84% 10%,
        rgba(0, 167, 245, 0.07) 0%,
        transparent 70%
      ),
      linear-gradient(180deg, #ffffff 0%, var(--bg-tint) 100%);
    border-bottom: 1px solid var(--line);
  }
  .nf-inner {
    max-width: 640px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* mascot adrift among the clouds */
  .nf-art {
    position: relative;
    width: 240px;
    height: 210px;
    margin-bottom: 8px;
  }
  .nf-mascot {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 0;
    width: 120px;
    height: auto;
    filter: drop-shadow(0 20px 26px rgba(34, 16, 95, 0.2));
  }
  .nf-cloud {
    position: absolute;
    height: auto;
    opacity: 0.65;
  }
  .nf-cloud.c1 {
    width: 84px;
    top: 6px;
    left: 0;
  }
  .nf-cloud.c2 {
    width: 58px;
    top: 38px;
    right: 4px;
  }

  .nf-code {
    font-family: var(--font-heading);
    font-size: clamp(72px, 14vw, 120px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--rc-violet);
    margin: 0 0 10px;
    display: flex;
    gap: 0.04em;
  }
  .nf-code .o {
    color: var(--rc-blue);
  }
  .nf h1 {
    font-size: clamp(26px, 4vw, 36px);
    letter-spacing: -0.02em;
    color: var(--rc-plum);
    margin: 0 0 14px;
  }
  .nf-sub {
    font-size: 17px;
    color: var(--text-muted);
    max-width: 460px;
    margin: 0 0 28px;
  }
  .nf-ctas {
    justify-content: center;
  }
  .nf-links {
    margin-top: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px 18px;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .nf-links-label {
    color: var(--text-muted);
  }
  .nf-links a {
    color: var(--rc-violet);
    font-weight: 600;
    padding-block: 6px;
  }
  .nf-links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nf-mascot {
      animation: nfFloat 6s ease-in-out infinite;
    }
    .nf-cloud.c1 {
      animation: nfFloat 7.6s ease-in-out infinite 0.9s;
    }
    .nf-cloud.c2 {
      animation: nfFloat 8.8s ease-in-out infinite 1.8s;
    }
    /* one-time staggered drop-in for the digits */
    .nf-code span {
      opacity: 0;
      transform: translateY(-18px);
      animation: nfDrop 0.55s cubic-bezier(0.34, 1.4, 0.45, 1) forwards;
    }
    .nf-code span:nth-child(2) {
      animation-delay: 0.1s;
    }
    .nf-code span:nth-child(3) {
      animation-delay: 0.2s;
    }
  }
  @keyframes nfFloat {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(-9px);
    }
  }
  .nf-cloud.c1,
  .nf-cloud.c2 {
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nf-cloud.c1,
    .nf-cloud.c2 {
      animation-name: nfFloatCloud;
    }
  }
  @keyframes nfFloatCloud {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  @keyframes nfDrop {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 560px) {
    .nf-art {
      width: 200px;
      height: 180px;
    }
    .nf-mascot {
      width: 104px;
    }
    .nf-ctas .btn {
      width: 100%;
    }
  }
</style>
