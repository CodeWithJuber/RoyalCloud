---
/**
 * Clone route — serves every captured royalclouds.net page verbatim.
 *
 * Each file in src/data/clone/*.html is the exact HTML of a live page. We map
 * the filename to the live URL (index -> /, <name> -> /<name>) and render the
 * original <head>/<body> through CloneLayout without transformation.
 */
import CloneLayout from '~/layouts/CloneLayout.astro';

export async function getStaticPaths() {
  const files = import.meta.glob('../data/clone/*.html', {
    query: '?raw',
    import: 'default',
    eager: true,
  });

  return Object.entries(files).map(([file, raw]) => {
    const name = (file.split('/').pop() || '').replace(/\.html$/i, '');
    const slug = name === 'index' ? undefined : name;
    const html = raw as string;

    const head = (html.match(/<head[^>]*>([\s\S]*?)<\/head>/i) || ['', ''])[1];
    const bodyOpen = html.match(/<body([^>]*)>/i);
    const bodyAttrs = bodyOpen ? bodyOpen[1].trim() : '';
    const body = (html.match(/<body[^>]*>([\s\S]*?)<\/body>/i) || ['', ''])[1];

    return { params: { slug }, props: { head, body, bodyAttrs } };
  });
}

const { head, body, bodyAttrs } = Astro.props;
---

<CloneLayout head={head} body={body} bodyAttrs={bodyAttrs} />
