---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const PORTAL = 'https://my.royalclouds.net';
const metadata = { title: 'About Royal Clouds' };
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About Us"
    title="Hosting built for speed, backed by people who care"
    subtitle="Royal Clouds has helped thousands of businesses and creators get online faster, with premium SSD infrastructure, LiteSpeed, CloudLinux and genuinely friendly 24/7 support."
  />

  <Features
    title="What we stand for"
    columns={2}
    items={[
      { title: 'Performance Obsessed', description: 'Pure SSD RAID-10, LiteSpeed and Cloudflare on every plan — a fast site wins customers and ranks higher.', icon: 'tabler:rocket' },
      { title: 'Support That Cares', description: 'Real specialists on live chat, email and tickets 24/7/365 — not scripts, not bots.', icon: 'tabler:headset' },
      { title: 'Secure by Default', description: 'Free SSL, managed firewalls, malware scanning and daily backups keep you protected.', icon: 'tabler:shield-check' },
      { title: 'Honest Pricing', description: 'Transparent plans from $1.99/mo with no hidden fees and a 30-day money-back guarantee.', icon: 'tabler:receipt' },
    ]}
  />

  <Stats
    stats={[
      { title: 'Uptime SLA', amount: '99.99%' },
      { title: 'Global locations', amount: '30+' },
      { title: 'Apps in 1-click', amount: '400+' },
      { title: 'Support', amount: '24/7' },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Get Started', href: `${PORTAL}/cart.php`, target: '_blank', icon: 'tabler:rocket' }]}
  >
    <Fragment slot="title">Become part of the Royal Clouds family</Fragment>
    <Fragment slot="subtitle">Join thousands of websites running faster on premium SSD hosting from $1.99/mo.</Fragment>
  </CallToAction>
</Layout>
