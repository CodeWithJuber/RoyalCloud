---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import BlogCard from "../../../components/BlogCard.astro";
import { getPublishedPosts, getAllTags, tagSlug } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getAllTags();
  // Tag pages match either an explicit tag or a post's category.
  const slugs = new Map<string, string>();
  tags.forEach((t) => slugs.set(tagSlug(t), t));
  posts.forEach((p) => slugs.set(tagSlug(p.data.category), p.data.category));

  return [...slugs.entries()].map(([slug, label]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.filter(
        (p) => p.data.tags.map(tagSlug).includes(slug) || tagSlug(p.data.category) === slug,
      ),
    },
  }));
}

const { label, posts } = Astro.props;
---
<BaseLayout
  title={`${label} — Blog`}
  description={`Articles about ${label} from the Royal Clouds hosting blog.`}
>
  <PageHero
    eyebrow="Blog Topic"
    title={label}
    subtitle={`Browse our latest articles tagged “${label}”.`}
    crumbs={[{ label: "Blog", href: "/blog" }, { label }]}
  />
  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (<BlogCard post={post} />))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
</style>
