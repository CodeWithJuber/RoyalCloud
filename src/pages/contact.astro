---
import Layout from '~/layouts/PageLayout.astro';
import ProductHero from '~/components/widgets/ProductHero.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact Royal Clouds',
  description: 'Get in touch with the Royal Clouds team via live chat, email or support ticket — friendly hosting specialists available 24/7.',
};
---

<Layout metadata={metadata}>
  <ProductHero
    eyebrow="Contact"
    title="We'd love to help"
    subtitle="Questions about plans, migrations or your account? Our friendly hosting specialists are available around the clock."
  />

  <ContactUs
    id="form"
    title="Send us a message"
    subtitle="For quicker answers, explore our FAQs. If not, our support team is delighted to help — usually within a couple of hours."
    inputs={[
      { type: 'text', name: 'name', label: 'Name' },
      { type: 'email', name: 'email', label: 'Email' },
    ]}
    textarea={{ label: 'Message' }}
    disclaimer={{
      label: 'By submitting this form you agree to the collection of your information in line with our Privacy Policy.',
    }}
    description="Our support team typically responds within a few hours, 24/7."
  />

  <Features2
    title="We are here to help — 24/7"
    items={[
      { title: 'Live Chat', description: 'The fastest way to reach us. Available 24/7 from your client area.', icon: 'tabler:message-circle' },
      { title: 'Email Support', description: 'support@royalclouds.net — we reply around the clock.', icon: 'tabler:mail' },
      { title: 'Submit a Ticket', description: 'Open a ticket and track it to resolution in your client area.', icon: 'tabler:ticket' },
      { title: 'Sales Enquiries', description: 'sales@royalclouds.net for plans, migrations and custom quotes.', icon: 'tabler:receipt' },
      { title: 'Knowledge Base', description: 'Step-by-step guides and tutorials for every part of your hosting.', icon: 'tabler:book' },
      { title: 'Client Area', description: 'Manage billing, services and domains at my.royalclouds.net.', icon: 'tabler:user-circle' },
    ]}
  />
</Layout>
