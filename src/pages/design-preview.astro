  "--rc-muted", "--rc-muted-dark", "--rc-success", "--rc-gold", "--rc-gold-light", "--rc-border"
];
const colorTokens = colorTokenNames.map((name) => ({ name, value: tv(name) }));

const spacingTokenNames = ["--s-1", "--s-2", "--s-3", "--s-4", "--s-6", "--s-8", "--s-12", "--s-16"];
