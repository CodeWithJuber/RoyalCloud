/* ------------------------------------------------------------- contrast reference --- */
interface ContrastPair { label: string; fg: string; bg: string; size: "body" | "large" | "ui" }
interface ContrastResult { label: string; ratio: number; required: number; pass: boolean }

interface ContrastData {
  pairs: ContrastPair[];
  check: (p: ContrastPair) => ContrastResult;
  source: string;
}

async function loadContrastData(): Promise<ContrastData> {
  try {
    const checker = (await import("../../scripts/check-contrast.mjs")) as {
      PAIRS: ContrastPair[];
      checkPair: (p: ContrastPair) => ContrastResult;
    };
    return {
      pairs: checker.PAIRS,
      check: checker.checkPair,
      source: "scripts/check-contrast.mjs (live import — same module `npm run check:contrast` runs)"
    };
  } catch (error) {
    // Same WCAG 2.1 relative-luminance formula as scripts/check-contrast.mjs, reimplemented
    // rather than hardcoding ratio numbers — only the fallback path if the import above breaks.
    const toRgb = (hex: string): [number, number, number] => {
      const int = parseInt(hex.replace(/^#/, ""), 16);
      return [(int >> 16) & 255, (int >> 8) & 255, int & 255];
    };
    const relativeLuminance = (hex: string) => {
      const [r, g, b] = toRgb(hex).map((channel) => {
        const s = channel / 255;
        return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
      });
      return 0.2126 * r + 0.7152 * g + 0.0722 * b;
    };
    const contrastRatioLocal = (hexA: string, hexB: string) => {
      const a = relativeLuminance(hexA);
      const b = relativeLuminance(hexB);
      const [light, dark] = a >= b ? [a, b] : [b, a];
      return (light + 0.05) / (dark + 0.05);
    };
    const check = ({ fg, bg, label, size }: ContrastPair): ContrastResult => {
      const required = size === "body" ? 4.5 : 3;
      const ratio = contrastRatioLocal(fg, bg);
      return { label, ratio: Math.round(ratio * 100) / 100, required, pass: ratio >= required };
    };
    // Minimal fallback set built from the tokens already parsed above — not hardcoded
    // ratios, just enough pairs to keep the table populated if the import above fails.
    const pairs: ContrastPair[] = [
      { label: "body on white", fg: tv("--rc-body"), bg: "#ffffff", size: "body" },
      { label: "ink heading on white", fg: tv("--rc-ink"), bg: "#ffffff", size: "body" },
      { label: "white on primary", fg: "#ffffff", bg: tv("--rc-primary"), size: "body" },
      { label: "white on night", fg: "#ffffff", bg: tv("--rc-night"), size: "body" },
      { label: "muted-dark on night", fg: tv("--rc-muted-dark"), bg: tv("--rc-night"), size: "body" },
      { label: "ink on gold (CTA)", fg: tv("--rc-ink"), bg: tv("--rc-gold"), size: "body" }
    ];
    return {
      pairs,
      check,
      source: `computed locally — importing scripts/check-contrast.mjs failed (${(error as Error).message}), so the formula is reimplemented here instead of hardcoding ratios`
    };
  }
}

const { pairs: contrastPairs, check: checkPairFn, source: contrastSource } = await loadContrastData();
const contrastRows = contrastPairs.map((pair) => ({ ...pair, ...checkPairFn(pair) }));
const contrastFailCount = contrastRows.filter((row) => !row.pass).length;

