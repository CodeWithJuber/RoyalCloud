/* ---------------------------------------------------------------- token parsing ---- */
/* Flat `--name: value;` scan. Good enough for the primitive/semantic declarations this
   page reads — global.css's one @media override (--section-space) isn't in the token
   lists below, so the last-write-wins merge never picks up a media-scoped value here. */
function parseCssVars(raw: string): Map<string, string> {
  const map = new Map<string, string>();
  for (const match of raw.matchAll(/(--[\w-]+):\s*([^;]+);/g)) {
    map.set(match[1], match[2].trim());
  }
  return map;
}
const tokenValues = new Map([...parseCssVars(tokensCssRaw), ...parseCssVars(globalCssRaw)]);
const tv = (name: string) => tokenValues.get(name) ?? `MISSING — ${name} not found in tokens.css or global.css`;

