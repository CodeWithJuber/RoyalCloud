          the one exception below: its logos and copy are identical to the real About page, not invented.
        </p>
      </div>
    </section>

    {blockCoverage.map(({ block, note }) => (
      <>
        <div class="component-tag"><p class="shell">Component <code>{block.component}</code> — {note}</p></div>
        <BlockRenderer block={block} />
      </>
    ))}

    <section class="section section-dark">
      <div class="shell">
        <p class="warn-flag">Sample data — does not ship</p>
        <h2>Blocks waiting on real data</h2>
        <p class="lede">
