---
import Layout from '~/layouts/Layout.astro';
import HeaderRC from '~/components/widgets/HeaderRC.astro';
import FooterRC from '~/components/widgets/FooterRC.astro';
import PlanGridRC from '~/components/widgets/PlanGridRC.astro';
import RevealScript from '~/components/widgets/RevealScript.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import cloudServer from '~/assets/images/brand/cloud-server.png';
import mascot from '~/assets/images/brand/mascot.png';
import shapeFive from '~/assets/images/brand/shape-five.png';
import shapeSeven from '~/assets/images/brand/shape-seven.png';
import shapeOne from '~/assets/images/brand/shape-one.png';
import rocketBg from '~/assets/images/brand/rocket-bg.svg';
import icWordpress from '~/assets/images/brand/ic-wordpress.svg';
import icBandwidth from '~/assets/images/brand/ic-bandwidth.svg';
import icDatabase from '~/assets/images/brand/ic-database.svg';
import icDatacenter from '~/assets/images/brand/ic-data-center.svg';
import icCloudSvg from '~/assets/images/brand/cloud.svg';
import icDevelopment from '~/assets/images/brand/ic-development.svg';

import shared from '~/data/plans/shared.json';
import testimonialsData from '~/data/testimonials.json';
import faqsData from '~/data/faqs.json';

const PORTAL = 'https://my.royalclouds.net';
const initialsOf = (name: string) => name.split(' ').map((w) => w[0]).slice(0, 2).join('');

const features = [
  { icon: icWordpress, title: 'Softaculous 1-Click Installer', text: 'Install WordPress, Joomla, Drupal and 400+ apps in seconds, with automatic updates.' },
  { icon: icBandwidth, title: 'Super-Fast Performance', text: 'Pure SSD RAID-10 storage, LiteSpeed, CloudLinux and the Cloudflare CDN make sites up to 15× faster.' },
  { icon: icDatabase, title: 'Free SSL & Daily Backups', text: 'Every site is encrypted with a free auto-renewing SSL and backed up daily — restore in one click.' },
  { icon: icDatacenter, title: 'DDoS Protection', text: 'A DDoS-protected network and hardened firewall keep your sites online under attack.' },
  { icon: icCloudSvg, title: '99.99% Uptime SLA', text: 'KernelCare live patching, redundant power and network underpin our uptime guarantee.' },
  { icon: icDevelopment, title: 'Friendly 24/7 Support', text: 'Real hosting specialists on live chat, email and tickets, around the clock, 365 days a year.' },
];

const partners = [
  { icon: 'logos:cloudflare', label: 'Cloudflare' },
  { icon: 'logos:cpanel', label: 'cPanel' },
  { icon: 'logos:cloudlinux', label: 'CloudLinux' },
  { icon: 'logos:intel', label: 'Intel' },
  { icon: 'logos:letsencrypt', label: "Let's Encrypt" },
  { icon: 'logos:ubuntu', label: 'Ubuntu' },
  { icon: 'logos:mysql', label: 'MySQL' },
  { icon: 'logos:php', label: 'PHP' },
];

const metadata = {
  title: 'Royal Clouds — Premium SSD Web Hosting, KVM VPS & Dedicated Servers',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <HeaderRC />

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="hero-eyebrow"><span class="dot"></span>Premium Web Hosting</span>
        <h1>Fast, secure hosting your business can <span class="grad">rely on</span></h1>
        <p class="sub">Pure SSD RAID-10 servers with LiteSpeed &amp; CloudLinux — free cPanel &amp; SSL, daily backups and friendly 24/7 support, from just $1.99/mo.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={`${PORTAL}/cart.php`} target="_blank" rel="noopener">Get Started →</a>
          <a class="btn btn-ghost-light" href="#pricing">View Plans</a>
        </div>
        <form class="domain-search" action={`${PORTAL}/cart.php`} method="get" target="_blank">
          <input type="hidden" name="a" value="add" />
          <input type="hidden" name="domain" value="register" />
          <span class="at">@</span>
          <input type="text" name="query" placeholder="Find your perfect domain name…" aria-label="Search for a domain" />
          <button class="btn btn-primary" type="submit">Search</button>
        </form>
        <div class="domain-tlds">
          <span><b>.com</b> $9.99</span>
          <span><b>.in</b> $6.49</span>
          <span><b>.net</b> $11.49</span>
          <span><b>.org</b> <em>on sale</em></span>
        </div>
        <div class="hero-trust">
          <span class="t">99.99% Uptime SLA</span>
          <span class="t">Free SSL Certificate</span>
          <span class="t">30-Day Money-Back</span>
          <span class="t">Instant Setup</span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-card">
          <Image src={cloudServer} alt="Royal Clouds cloud server infrastructure" width={320} height={320} loading="eager" />
          <!-- the Royal Clouds mascot (original brand) -->
          <Image src={mascot} alt="RC — the Royal Clouds mascot" width={104} height={216} class="hero-mascot" loading="eager" />
          <!-- orbiting cloud platforms from the original site -->
          <Image src={shapeFive} alt="" width={96} height={69} class="hero-orbit hero-orbit-1" aria-hidden="true" />
          <Image src={shapeSeven} alt="" width={96} height={74} class="hero-orbit hero-orbit-2" aria-hidden="true" />
          <div class="chip chip-uptime"><span class="ic"><Icon name="tabler:activity-heartbeat" /></span><span><span class="num">99.99%</span><br /><span class="lbl">Uptime SLA</span></span></div>
          <div class="chip chip-speed"><span class="ic"><Icon name="tabler:bolt" /></span><span><span class="num">15× faster</span><br /><span class="lbl">LiteSpeed + SSD</span></span></div>
          <div class="chip chip-ssl"><span class="ic"><Icon name="tabler:shield-check" /></span><span><span class="num">Free SSL</span><br /><span class="lbl">Auto-renewing</span></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PARTNERS ============ -->
  <div class="partners">
    <div class="wrap">
      <p class="lead">Powered by industry-leading technology</p>
      <div class="partner-row">
        {partners.map((p) => (
          <span class="mark" title={p.label}><Icon name={p.icon} /></span>
        ))}
      </div>
    </div>
  </div>

  <!-- ============ FEATURES ============ -->
  <section class="features" id="features">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Why Royal Clouds</span>
        <h2>Everything you need to launch &amp; grow</h2>
        <p>Powerful features, friendly support and prices that make sense — for first-timers and seasoned developers alike.</p>
      </div>
      <div class="feature-grid">
        {features.map((f) => (
          <div class="card feature-card reveal">
            <div class="f-icon"><Image src={f.icon} alt="" width={40} height={40} /></div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SPEED ============ -->
  <section class="speed" id="speed" style="background: var(--bg-tint);">
    <div class="wrap split rev">
      <div class="split-media illus reveal">
        <div class="illus-panel">
          <Image src={rocketBg} alt="High-speed hosting illustration" width={460} height={345} />
        </div>
        <div class="badge-float"><span class="big">15×</span><span class="small">faster than standard<br />HDD hosting</span></div>
      </div>
      <div class="split-body reveal">
        <span class="eyebrow">Global &amp; fast</span>
        <h2>A network built for speed, everywhere</h2>
        <p>Faster pages mean happier visitors, better SEO and more sales.</p>
        <div class="point-list">
          <div class="point">
            <div class="p-ic"><Image src={icBandwidth} alt="" width={28} height={28} /></div>
            <div><h4>Pure SSD RAID-10 + LiteSpeed</h4><p>Up to 15× faster than standard HDD hosting, with LSCache serving pages in milliseconds.</p></div>
          </div>
          <div class="point">
            <div class="p-ic"><Image src={icCloudSvg} alt="" width={28} height={28} /></div>
            <div><h4>Cloudflare CDN &amp; HTTP/3</h4><p>Your content is cached at edge locations worldwide for fast loads anywhere.</p></div>
          </div>
          <div class="point">
            <div class="p-ic"><Image src={icDatacenter} alt="" width={28} height={28} /></div>
            <div><h4>CloudLinux isolation</h4><p>Every account is isolated for consistent performance, even under heavy neighbour load.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STEPS ============ -->
  <section class="steps-sec" id="migrate" style="background: #fff;">
    <div class="wrap split">
      <div class="split-body reveal">
        <span class="eyebrow">Get started in minutes</span>
        <h2>Switching is simple — we do the heavy lifting</h2>
        <div class="step-list">
          <div class="step">
            <span class="step-num"></span>
            <div><h4>Choose your plan</h4><p>Pick the hosting that fits — from SSD shared to a dedicated server. Upgrade any time.</p></div>
          </div>
          <div class="step">
            <span class="step-num"></span>
            <div><h4>We migrate you free</h4><p>Already hosted elsewhere? Our team moves your site, databases and emails with zero downtime.</p></div>
          </div>
          <div class="step">
            <span class="step-num"></span>
            <div><h4>Set up in minutes</h4><p>Install WordPress and 400+ apps in one click, point your domain and enable free SSL.</p></div>
          </div>
          <div class="step">
            <span class="step-num"></span>
            <div><h4>Go live &amp; grow</h4><p>Your site loads fast on LiteSpeed + SSD, backed by 99.99% uptime and 24/7 support.</p></div>
          </div>
        </div>
      </div>
      <div class="split-media illus reveal">
        <div class="illus-panel illus-grad">
          <Image src={shapeOne} alt="Royal Clouds cloud platform illustration" width={470} height={277} />
        </div>
        <div class="badge-float"><span class="big">24/7</span><span class="small">friendly support,<br />365 days a year</span></div>
      </div>
    </div>
  </section>

  <!-- ============ PRICING ============ -->
  <PlanGridRC
    id="pricing"
    eyebrow="SSD Shared Hosting"
    title="Plans that grow with you"
    subtitle="Transparent pricing with free cPanel, free SSL, free migration and a 30-day money-back guarantee."
    tiers={shared.tiers}
    note="Every plan includes free cPanel, free SSL, free migration, daily backups & 24/7 support. 30-day money-back guarantee."
  />

  <!-- ============ STATS ============ -->
  <section class="stats">
    <div class="wrap stat-grid">
      <div class="stat reveal"><div class="amount">99.99%</div><div class="label">Uptime SLA</div></div>
      <div class="stat reveal"><div class="amount">15×</div><div class="label">Faster with SSD</div></div>
      <div class="stat reveal"><div class="amount">400+</div><div class="label">Apps in 1-click</div></div>
      <div class="stat reveal"><div class="amount">24/7</div><div class="label">Expert support</div></div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="testi-sec" id="testimonials">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Customer love</span>
        <h2>Loved by thousands of website owners</h2>
        <p>Rated 9.6/10 by customers who moved their sites to Royal Clouds.</p>
      </div>
      <div class="testi-grid">
        {testimonialsData.items.slice(0, 6).map((t) => (
          <div class="card testi reveal">
            <div class="stars">{[0,1,2,3,4].map(() => (<Icon name="tabler:star-filled" />))}</div>
            <blockquote>“{t.quote}”</blockquote>
            <div class="who">
              <span class="avatar">{initialsOf(t.name)}</span>
              <span><span class="name">{t.name}</span><br /><span class="site">{t.site}</span></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="faq-sec" id="faq" style="background: #fff;">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">FAQ</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        {faqsData.general.map((f, i) => (
          <details class="faq reveal" open={i === 0}>
            <summary>{f.q}<span class="pm">+</span></summary>
            <p class="ans">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SUPPORT (original royalclouds.net section, with the mascot) ============ -->
  <section class="support-sec" id="support">
    <div class="wrap support-grid">
      <div class="support-figure reveal">
        <Image src={shapeFive} alt="" width={96} height={69} class="c" aria-hidden="true" />
        <Image src={mascot} alt="RC — the Royal Clouds mascot" width={170} height={353} class="m" />
      </div>
      <div>
        <div class="sec-head reveal" style="margin-bottom: 6px;">
          <span class="eyebrow">We're here for you</span>
          <h2>Need help? Chat with our friendly support team 24/7</h2>
          <p>Live chat support, email any time, or post a ticket — real hosting specialists, around the clock.</p>
        </div>
        <div class="support-cards">
          <a class="card support-card reveal" href={`${PORTAL}/clientarea.php`} target="_blank" rel="noopener">
            <span class="s-ic"><Icon name="tabler:message-circle" /></span>
            <h4>Live Chat</h4>
            <p>We are always available to chat. We will reply to you instantly.</p>
          </a>
          <a class="card support-card reveal" href="mailto:support@royalclouds.net">
            <span class="s-ic"><Icon name="tabler:mail" /></span>
            <h4>Send Email</h4>
            <p>We are available via email 24/7. We will get back to you immediately.</p>
          </a>
          <a class="card support-card reveal" href={`${PORTAL}/submitticket.php`} target="_blank" rel="noopener">
            <span class="s-ic"><Icon name="tabler:ticket" /></span>
            <h4>Submit Ticket</h4>
            <p>You can submit tickets any time you need help and track them to resolution.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final-cta" style="padding-top: 0;">
    <div class="wrap">
      <div class="cta-band reveal">
        <h2>Ready to launch faster?</h2>
        <p>Join thousands of sites running on premium SSD hosting — free SSL, free migration and a 30-day money-back guarantee.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={`${PORTAL}/cart.php`} target="_blank" rel="noopener"><Icon name="tabler:rocket" /> Get Started</a>
          <a class="btn btn-ghost-light" href="mailto:sales@royalclouds.net">Talk to sales</a>
        </div>
      </div>
    </div>
  </section>

  <FooterRC />
  <RevealScript />
</Layout>
