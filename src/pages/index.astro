---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Stats from '~/components/widgets/Stats.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Brands from '~/components/widgets/Brands.astro';

import heroImage from '~/assets/images/hero.png';
import { toPrices } from '~/utils/plans';
import shared from '~/data/plans/shared.json';
import testimonialsData from '~/data/testimonials.json';
import faqsData from '~/data/faqs.json';

const PORTAL = 'https://my.royalclouds.net';

const metadata = {
  title: 'Royal Clouds — Premium SSD Web Hosting, KVM VPS & Dedicated Servers',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    actions={[
      { variant: 'primary', text: 'Get Started at $1.99/mo', href: `${PORTAL}/cart.php`, target: '_blank', icon: 'tabler:rocket' },
      { text: 'Compare plans', href: '#pricing' },
    ]}
    image={{ src: heroImage, alt: 'Royal Clouds hosting control panel showing 99.99% uptime' }}
  >
    <Fragment slot="title">
      Premium hosting, <span class="text-accent dark:text-white">built for enhanced speed</span>
    </Fragment>
    <Fragment slot="subtitle">
      Launch on SSD RAID-10 servers with <span class="font-semibold">LiteSpeed</span>, CloudLinux, free cPanel &amp; SSL,
      daily backups and genuinely friendly 24/7 support — from just <span class="font-semibold">$1.99/month</span>.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-b from-green-50/70 to-transparent dark:from-transparent"></div>
    </Fragment>
  </Hero>

  <!-- Trusted tech / partners -->
  <Brands
    title="Powered by industry-leading technology"
    icons={[
      'logos:cloudflare',
      'logos:cpanel',
      'logos:cloudlinux',
      'logos:intel',
      'logos:letsencrypt',
      'logos:ubuntu',
      'logos:mysql',
      'logos:php',
    ]}
  />

  <!-- Benefits -->
  <Features
    id="features"
    tagline="Why Royal Clouds"
    title="Everything you need to launch & grow"
    subtitle="Powerful features, friendly support and prices that make sense — for first-timers and seasoned developers alike."
    items={[
      { title: 'Softaculous 1-Click Installer', description: 'Install WordPress, Joomla, Drupal and 400+ apps in seconds, with automatic updates.', icon: 'tabler:apps' },
      { title: 'Super-Fast Performance', description: 'Pure SSD RAID-10 storage, LiteSpeed, CloudLinux and the Cloudflare CDN make sites up to 15× faster.', icon: 'tabler:bolt' },
      { title: 'Free SSL & Daily Backups', description: 'Every site is encrypted with a free auto-renewing SSL and backed up daily — restore in one click.', icon: 'tabler:shield-check' },
      { title: 'DDoS Protection', description: 'A DDoS-protected network and hardened firewall keep your sites online under attack.', icon: 'tabler:wall' },
      { title: '99.99% Uptime SLA', description: 'KernelCare live patching, redundant power and network underpin our uptime guarantee.', icon: 'tabler:activity-heartbeat' },
      { title: 'Friendly 24/7 Support', description: 'Real hosting specialists on live chat, email and tickets, around the clock, 365 days a year.', icon: 'tabler:headset' },
    ]}
  />

  <!-- Speed content -->
  <Content
    isReversed
    tagline="Global & fast"
    title="A network built for speed, everywhere"
    items={[
      { title: 'Pure SSD RAID-10 + LiteSpeed', description: 'Up to 15× faster than standard HDD hosting, with LSCache serving pages in milliseconds.', icon: 'tabler:bolt' },
      { title: 'Cloudflare CDN & HTTP/3', description: 'Your content is cached at edge locations worldwide for fast loads anywhere.', icon: 'tabler:world' },
      { title: 'CloudLinux isolation', description: 'Every account is isolated for consistent performance, even under heavy neighbour load.', icon: 'tabler:shield-lock' },
    ]}
    image={{ src: heroImage, alt: 'Performance dashboard' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Speed that ranks and converts</h3>
      Faster pages mean happier visitors, better SEO and more sales.
    </Fragment>
    <Fragment slot="bg"><div class="absolute inset-0 bg-green-50 dark:bg-transparent"></div></Fragment>
  </Content>

  <!-- Migration steps -->
  <Steps
    title="Switching is simple — we do the heavy lifting"
    tagline="Get started in minutes"
    items={[
      { title: 'Choose your plan', description: 'Pick the hosting that fits — from SSD shared to a dedicated server. Upgrade any time.', icon: 'tabler:shopping-cart' },
      { title: 'We migrate you free', description: 'Already hosted elsewhere? Our team moves your site, databases and emails with zero downtime.', icon: 'tabler:transfer' },
      { title: 'Set up in minutes', description: 'Install WordPress and 400+ apps in one click, point your domain and enable free SSL.', icon: 'tabler:settings' },
      { title: 'Go live & grow', description: 'Your site loads fast on LiteSpeed + SSD, backed by 99.99% uptime and 24/7 support.', icon: 'tabler:rocket' },
    ]}
    image={{ src: heroImage, alt: 'Migration steps' }}
  />

  <!-- Pricing -->
  <Pricing
    id="pricing"
    title="Plans that grow with you"
    subtitle="Transparent pricing with free cPanel, free SSL, free migration and a 30-day money-back guarantee."
    tagline="SSD Shared Hosting"
    prices={toPrices(shared)}
  />

  <!-- Stats -->
  <Stats
    stats={[
      { title: 'Uptime SLA', amount: '99.99%' },
      { title: 'Faster with SSD', amount: '15×' },
      { title: 'Apps in 1-click', amount: '400+' },
      { title: 'Expert support', amount: '24/7' },
    ]}
  />

  <!-- Testimonials -->
  <Testimonials
    title="Loved by thousands of website owners"
    tagline="Customer love"
    testimonials={testimonialsData.items.slice(0, 6).map((t) => ({
      testimonial: t.quote,
      name: t.name,
      job: t.site,
    }))}
  />

  <!-- FAQs -->
  <FAQs
    title="Frequently asked questions"
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={faqsData.general.map((f) => ({ title: f.q, description: f.a }))}
  />

  <!-- CTA -->
  <CallToAction
    actions={[
      { variant: 'primary', text: 'Get Started', href: `${PORTAL}/cart.php`, target: '_blank', icon: 'tabler:rocket' },
      { text: 'Talk to sales', href: 'mailto:sales@royalclouds.net' },
    ]}
  >
    <Fragment slot="title">Ready to launch faster?</Fragment>
    <Fragment slot="subtitle">
      Join thousands of sites running on premium SSD hosting — free SSL, free migration and a 30-day money-back guarantee.
    </Fragment>
  </CallToAction>
</Layout>
