---
import Layout from '~/layouts/PageLayout.astro';
import ProductHero from '~/components/widgets/ProductHero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import testimonialsData from '~/data/testimonials.json';

const PORTAL = 'https://my.royalclouds.net';
const metadata = {
  title: 'Customer Testimonials',
  description: 'See what customers say about Royal Clouds hosting — superfast SSD servers, reliable uptime and friendly 24/7 support.',
};
---

<Layout metadata={metadata}>
  <ProductHero
    eyebrow="Testimonials"
    title="Loved by thousands of website owners"
    subtitle="Don't just take our word for it — here's what real Royal Clouds customers say about our speed, reliability and support."
  />

  <Testimonials
    testimonials={testimonialsData.items.map((t) => ({ testimonial: t.quote, name: t.name, job: t.site }))}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Get Started', href: `${PORTAL}/cart.php`, target: '_blank', icon: 'tabler:rocket' }]}
  >
    <Fragment slot="title">Join thousands of happy customers</Fragment>
    <Fragment slot="subtitle">Premium SSD hosting from $1.99/mo — free SSL, free migration, 24/7 support.</Fragment>
  </CallToAction>
</Layout>
